<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.twoheadwu.member-worker</string>
  <key>UserName</key>
  <string>@@MEMBER_RUNTIME_USER@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@RUBY_BIN@@</string>
    <string>@@RELEASE_ROOT@@/capabilities/remote-work/worker/ltw-worker</string>
    <string>run</string>
    <string>--queue</string>
    <string>air</string>
    <string>--executor</string>
    <string>codex</string>
    <string>--interval</string>
    <string>5</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@@RUNTIME_ROOT@@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>WU_REMOTE_WORKER_HOME</key>
    <string>@@RUNTIME_ROOT@@/worker-home</string>
    <key>WU_MEMBER_RUNTIME_USER</key>
    <string>@@MEMBER_RUNTIME_USER@@</string>
    <key>WU_MEMBER_RUNTIME_UID</key>
    <string>@@MEMBER_RUNTIME_UID@@</string>
    <key>WU_MEMBER_OWNER_UID</key>
    <string>@@OWNER_UID@@</string>
    <key>WU_MEMBER_RUNTIME_ROOT</key>
    <string>@@RUNTIME_ROOT@@</string>
    <key>WU_MEMBER_RELEASE_ROOT</key>
    <string>@@RELEASE_ROOT@@</string>
    <key>WU_MEMBER_CODEX_ROOT</key>
    <string>@@RUNTIME_ROOT@@/agent-identity/codex-homes</string>
    <key>TWO_HEAD_WU_IDENTITY_ROOT</key>
    <string>@@RUNTIME_ROOT@@/agent-identity</string>
    <key>WU_MEMBER_PRIVATE_CANARIES</key>
    <string>@@PRIVATE_CANARIES@@</string>
    <key>WU_REMOTE_CODEX_BIN</key>
    <string>@@CODEX_BIN@@</string>
    <key>TWO_HEAD_WU_RESEARCH_LIBRARY_ROOT</key>
    <string>@@RESEARCH_ROOT@@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>Disabled</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@@RUNTIME_ROOT@@/logs/member-worker.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@@RUNTIME_ROOT@@/logs/member-worker.stderr.log</string>
</dict>
</plist>
