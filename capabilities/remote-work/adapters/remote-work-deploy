  def build_bundle
    admin = @root.join("capabilities/remote-work/adapters/remote-work-admin")
    _stdout, _stderr, status = Open3.capture3(admin.to_s, "build", chdir: @root.to_s)
    raise RemoteWork::Error, "remote-work build failed" unless status.success?
    output = @root.join("var/remote-work/deploy")
    FileUtils.mkdir_p(output.to_s, mode: 0o700)
    stage = Pathname.new(Dir.mktmpdir("deploy-stage-", output.to_s))
    FileUtils.mkdir_p(stage.join("app").to_s)
    FileUtils.cp(@root.join("capabilities/remote-work/server/control_plane.py").to_s, stage.join("app/control_plane.py").to_s)
    FileUtils.cp(@root.join("capabilities/remote-work/server/multi_user_contracts.py").to_s, stage.join("app/multi_user_contracts.py").to_s)
    FileUtils.cp(@root.join("capabilities/remote-work/server/member_auth.py").to_s, stage.join("app/member_auth.py").to_s)
    FileUtils.cp_r(@root.join("var/remote-work/build/current/capabilities").to_s, stage.join("capabilities").to_s)
    FileUtils.cp_r(@root.join("var/remote-work/build/current/components").to_s, stage.join("components").to_s)
    FileUtils.cp_r(@root.join("var/remote-work/build/current/releases").to_s, stage.join("releases").to_s)
    provisional = output.join("bundle-#{Process.pid}-#{SecureRandom.hex(3)}.tar.gz")
    metadata = RemoteWork::Archive.pack_directory(stage, provisional)
    build_id = "v#{RemoteWork::VERSION}-#{metadata.fetch('sha256')[0, 12]}"
    final = output.join("#{build_id}.tar.gz")
    if final.file?
      FileUtils.rm_f(provisional.to_s)
    else
      FileUtils.mv(provisional.to_s, final.to_s)
    end
    [final, build_id, metadata.fetch("sha256")]
  ensure
    FileUtils.rm_rf(stage.to_s) if defined?(stage) && stage
  end

  def allocate_remote_upload
    stdout, stderr, status = run_ssh("sh -c 'umask 077; mktemp /srv/two-head-wu/tmp/upload.XXXXXXXX.tar.gz'")
    raise RemoteWork::Error, "cannot allocate fixed remote upload: #{classify_ssh_error(stderr)}" unless status.success?
    path = stdout.strip
    raise RemoteWork::Error, "remote upload path was invalid" unless path.match?(%r{\A/srv/two-head-wu/tmp/upload\.[A-Za-z0-9]{8}\.tar\.gz\z})
    path
  end

  def upload_bundle(local_path, remote_path)
    raise RemoteWork::Error, "fixed artifact upload path was invalid" unless remote_path.match?(%r{\A/srv/two-head-wu/tmp/upload\.[A-Za-z0-9]{8}\.tar\.gz\z})
    command = ["ssh", *SSH_OPTIONS, ssh_target, "umask 077; cat > #{remote_path}"]
    stdin, stdout, stderr_stream, wait = Open3.popen3({ "LC_ALL" => "C" }, *command, pgroup: true)
    writer_error = nil
    writer = Thread.new do
      File.open(local_path.to_s, "rb") { |file| IO.copy_stream(file, stdin) }
    rescue StandardError => error
      writer_error = error
    ensure
      stdin.close unless stdin.closed?
    end
    stdout_reader = Thread.new { stdout.read }
    stderr_reader = Thread.new { stderr_stream.read }
    unless wait.join(UPLOAD_TIMEOUT_SECONDS)
      Process.kill("TERM", -wait.pid)
      unless wait.join(5)
        Process.kill("KILL", -wait.pid)
        wait.join
      end
      writer.join(1) || writer.kill
      stdout_reader.value
      stderr_reader.value
      raise RemoteWork::Error, "fixed artifact upload timed out"
    end
    writer.join
    status = wait.value
    stdout_reader.value
    stderr = stderr_reader.value
    raise RemoteWork::Error, "fixed artifact upload failed: local stream error" if writer_error
    raise RemoteWork::Error, "fixed artifact upload failed: #{classify_ssh_error(stderr)}" unless status.success?
  rescue Errno::ESRCH
    raise RemoteWork::Error, "fixed artifact upload timed out"
  ensure
    [stdin, stdout, stderr_stream].compact.each { |stream| stream.close unless stream.closed? }
  end

  def issue_remote_token(device, role, ttl: 86_400)
    ttl = Integer(ttl)
    raise RemoteWork::Error, "remote enrollment TTL is invalid" unless (60..86_400).cover?(ttl)
    command = "sudo -n -u twoheadwu /usr/bin/python3 /srv/two-head-wu/app/current/control_plane.py --root /srv/two-head-wu issue-enrollment --device #{device} --role #{role} --ttl #{ttl}"
    stdout, stderr, status = run_ssh(command)
    raise RemoteWork::Error, "remote enrollment issuance failed: #{classify_ssh_error(stderr)}" unless status.success?
    token = stdout.strip
    raise RemoteWork::Error, "remote enrollment issuance returned invalid material" unless token.match?(/\A[A-Za-z0-9_-]{32,256}\z/)
    token
  end

  def ensure_worker_enrollment(worker_home, device_name)
    config = RemoteWork::Config.new(worker_home)
    if config.configured?
      values = config.load
      raise RemoteWork::Error, "existing Mac mini worker endpoint does not match the registered service" unless values.fetch("endpoint") == ENDPOINT
      raise RemoteWork::Error, "existing Mac mini worker device name does not match" unless values.fetch("device_name") == device_name
      device = RemoteWork::HTTPClient.new(config).get("me").fetch("device")
      raise RemoteWork::Error, "existing device is not a Mac mini worker" unless device.fetch("role") == "mac-mini-worker"
      return "reused"
    end

    token = issue_remote_token(device_name, "mac-mini-worker")
    client = @root.join("capabilities/remote-work/adapters/remote-work")
    token_env = "TWO_HEAD_WU_WORKER_ENROLLMENT"
    _stdout, _stderr, status = Open3.capture3(
      { "WU_REMOTE_HOME" => worker_home.to_s, token_env => token },
      client.to_s, "enroll", "--endpoint", ENDPOINT, "--device", device_name,
      "--token-env", token_env, "--secret-store", "keychain", chdir: @root.to_s
    )
    raise RemoteWork::Error, "Mac mini worker enrollment failed" unless status.success?
    "created"
  rescue KeyError
    raise RemoteWork::Error, "existing Mac mini worker configuration is incomplete"
  end

  def install_worker_runtime
    sources = {
      "capabilities/remote-work/worker/ltw-worker" => 0o555,
      "capabilities/remote-work/worker/app_server_bridge.rb" => 0o444,
      "capabilities/remote-work/worker/owner_capability_adapters.rb" => 0o444,
      "capabilities/remote-work/worker/capability-adapters.yaml" => 0o444,
      "capabilities/remote-work/lib/remote_work.rb" => 0o444,
      "capabilities/remote-work/adapters/remote-work-admin" => 0o555,
      "capabilities/remote-work/policies/owner-only.yaml" => 0o444,
      "core/lib/function_catalog.rb" => 0o444,
      "capabilities/agent-identity/adapters/agent-identity" => 0o555,
      "capabilities/agent-identity/lib/codex_quota_probe.rb" => 0o444,
      "catalog/resources/infrastructure.yaml" => 0o444,
      "catalog/deployments/personal-static-sites.yaml" => 0o444
    }
    skill_bundle = remote_task_skill_releases
    digest = Digest::SHA256.new
    sources.sort.each do |relative, _mode|
      path = @root.join(relative)
      raise RemoteWork::Error, "Mac mini worker runtime source is missing" unless path.file?
      digest << relative << "\0" << path.binread << "\0"
    end
    skill_bundle.each do |entry|
      digest << "remote-task-skill\0" << entry.fetch("skill_id") << "\0" << entry.fetch("digest") << "\0"
      digest << skill_tree_digest(entry.fetch("source")) << "\0"
    end
    release_id = "v#{RemoteWork::VERSION}-#{digest.hexdigest[0, 12]}"
    runtime_root = Pathname.new(File.join(Dir.home, ".local", "share", "two-head-wu", "remote-worker"))
    releases = runtime_root.join("releases")
    FileUtils.mkdir_p(releases.to_s, mode: 0o755)
    release = releases.join(release_id)

    unless release.directory?
      stage = Pathname.new(Dir.mktmpdir("worker-release-", releases.to_s))
      sources.each do |relative, mode|
        destination = stage.join(relative)
        FileUtils.mkdir_p(destination.dirname.to_s, mode: 0o755)
        FileUtils.install(@root.join(relative).to_s, destination.to_s, mode: mode)
      end
      install_worker_skill_bundle(stage, skill_bundle)
      File.rename(stage.to_s, release.to_s)
    end

    sources.each do |relative, _mode|
      source_digest = Digest::SHA256.file(@root.join(relative).to_s).hexdigest
      installed = release.join(relative)
      raise RemoteWork::Error, "installed Mac mini worker runtime is incomplete" unless installed.file?
      raise RemoteWork::Error, "installed Mac mini worker runtime failed verification" unless Digest::SHA256.file(installed.to_s).hexdigest == source_digest
    end
    verify_worker_skill_bundle(release, skill_bundle)
    release.join("capabilities/remote-work/worker/ltw-worker")
  ensure
    FileUtils.rm_rf(stage.to_s) if defined?(stage) && stage&.exist?
  end

  def remote_task_skill_releases
    policy = YAML.safe_load(
      @root.join("capabilities/remote-work/policies/owner-only.yaml").read(encoding: "UTF-8"),
      permitted_classes: [], aliases: false
    )
    wanted = Array(policy.dig("capability_inventory", "remote_task_skills"))
    raise RemoteWork::Error, "remote-task Skill policy is empty" if wanted.empty?
    registry = JSON.parse(@root.join("skills/registries/skill_releases.json").read(encoding: "UTF-8"))
    current = registry.fetch("current")
    releases = Array(registry.fetch("releases")).each_with_object({}) do |entry, index|
      index[[entry.fetch("skill_id"), entry.fetch("digest")]] = entry
    end
    approvals = Array(registry.fetch("approvals"))
    wanted.map do |skill_id|
      raise RemoteWork::Error, "remote-task Skill ID is invalid" unless skill_id.to_s.match?(/\A[a-z][a-z0-9-]{0,62}\z/)
      digest = current.fetch(skill_id) { raise RemoteWork::Error, "remote-task Skill has no current Release: #{skill_id}" }
      release = releases.fetch([skill_id, digest]) { raise RemoteWork::Error, "remote-task Skill Release record is missing: #{skill_id}" }
      approved = approvals.any? do |item|
        item["skill_id"] == skill_id && item["digest"] == digest &&
          item["decision"].to_s.start_with?("approved") && Array(item["runtimes"]).include?("codex")
      end
      raise RemoteWork::Error, "remote-task Skill is not approved for Codex: #{skill_id}" unless approved
      source = @root.join(release.fetch("snapshot_path")).expand_path.cleanpath
      release_root = @root.join("skills/releases").expand_path.cleanpath
      unless source.to_s.start_with?("#{release_root}#{File::SEPARATOR}") && source.basename.to_s == digest.delete_prefix("sha256:")
        raise RemoteWork::Error, "remote-task Skill Release path is invalid: #{skill_id}"
      end
      raise RemoteWork::Error, "remote-task Skill Release is missing: #{skill_id}" unless source.join("SKILL.md").file?
      { "skill_id" => skill_id, "digest" => digest, "source" => source }
    end
  rescue JSON::ParserError, Psych::Exception, KeyError
    raise RemoteWork::Error, "remote-task Skill Release registry is invalid"
  end

  def skill_tree_files(root)
    root = root.realpath
    files = []
    Find.find(root.to_s) do |raw|
      path = Pathname.new(raw)
      next if path == root
      raise RemoteWork::Error, "remote-task Skill Release contains a symlink" if path.symlink?
      next if path.directory?
      raise RemoteWork::Error, "remote-task Skill Release contains a non-file" unless path.file?
      relative = path.relative_path_from(root).to_s
      basename = path.basename.to_s
      if RemoteWork::Archive.credential_shaped?(basename) || RemoteWork::Archive::DEFAULT_EXCLUDED_NAMES.include?(basename)
        raise RemoteWork::Error, "remote-task Skill Release contains a forbidden file"
      end
      files << [relative, path]
    end
    raise RemoteWork::Error, "remote-task Skill Release is empty" if files.empty?
    files.sort_by(&:first)
  end

  def skill_tree_digest(root)
    digest = Digest::SHA256.new
    skill_tree_files(root).each do |relative, path|
      digest << relative << "\0" << path.binread << "\0"
    end
    digest.hexdigest
  end

  def install_worker_skill_bundle(stage, records)
    bundle = stage.join("skills/remote-task")
    FileUtils.mkdir_p(bundle.to_s, mode: 0o755)
    manifest = {
      "schema_version" => 1,
      "source" => "current-approved-codex-skill-releases",
      "skills" => records.map do |entry|
        target = bundle.join(entry.fetch("skill_id"))
        FileUtils.cp_r(entry.fetch("source").to_s, target.to_s, preserve: true)
        {
          "skill_id" => entry.fetch("skill_id"),
          "digest" => entry.fetch("digest"),
          "path" => entry.fetch("skill_id"),
          "content_sha256" => skill_tree_digest(entry.fetch("source"))
        }
      end
    }
    bundle.join("manifest.json").write(JSON.pretty_generate(manifest) + "\n", encoding: "UTF-8")
    Find.find(bundle.to_s) do |raw|
      path = Pathname.new(raw)
      next if path.symlink?
      mode = if path.directory?
               0o555
             elsif path.executable?
               0o555
             else
               0o444
             end
      File.chmod(mode, path.to_s)
    end
  end

  def verify_worker_skill_bundle(release, records)
    bundle = release.join("skills/remote-task")
    manifest = JSON.parse(bundle.join("manifest.json").read(encoding: "UTF-8"))
    expected = records.map { |entry| [entry.fetch("skill_id"), entry.fetch("digest")] }
    actual = Array(manifest["skills"]).map { |entry| [entry["skill_id"], entry["digest"]] }
    raise RemoteWork::Error, "installed remote-task Skill manifest drift" unless actual == expected
    records.each do |entry|
      installed = bundle.join(entry.fetch("skill_id"))
      raise RemoteWork::Error, "installed remote-task Skill is incomplete" unless installed.join("SKILL.md").file?
      unless skill_tree_digest(installed) == skill_tree_digest(entry.fetch("source"))
        raise RemoteWork::Error, "installed remote-task Skill failed content verification"
      end
      writable = skill_tree_files(installed).any? { |_relative, path| (path.stat.mode & 0o222).positive? }
      raise RemoteWork::Error, "installed remote-task Skill is writable" if writable
    end
  rescue JSON::ParserError, Errno::ENOENT
    raise RemoteWork::Error, "installed remote-task Skill manifest is invalid"
  end

  def install_worker_launch_agent(worker_home, worker, pipeline_root)
    launch_agents = Pathname.new(File.join(Dir.home, "Library", "LaunchAgents"))
    logs = Pathname.new(File.join(Dir.home, "Library", "Logs", "TwoHeadWuRemoteWorker"))
    FileUtils.mkdir_p(launch_agents.to_s, mode: 0o755)
    FileUtils.mkdir_p(logs.to_s, mode: 0o700)
    plist = launch_agents.join("com.twoheadwu.remote-worker.plist")
    local_bin = File.join(Dir.home, ".local", "bin")
    content = <<~PLIST
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>Label</key><string>com.twoheadwu.remote-worker</string>
        <key>ProgramArguments</key><array><string>#{xml(worker.to_s)}</string><string>run</string><string>--executor</string><string>app-server</string></array>
        <key>WorkingDirectory</key><string>#{xml(worker_home.to_s)}</string>
        <key>EnvironmentVariables</key><dict>
          <key>WU_REMOTE_WORKER_HOME</key><string>#{xml(worker_home.to_s)}</string>
          <key>TWO_HEAD_WU_SOURCE_ROOT</key><string>#{xml(@root.to_s)}</string>
          <key>TWO_HEAD_WU_PIPELINE_ROOT</key><string>#{xml(pipeline_root.to_s)}</string>
          <key>LANG</key><string>en_US.UTF-8</string>
          <key>LC_ALL</key><string>en_US.UTF-8</string>
          <key>PATH</key><string>#{xml(local_bin)}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        </dict>
        <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>
        <key>StandardOutPath</key><string>#{xml(logs.join('worker.log').to_s)}</string>
        <key>StandardErrorPath</key><string>#{xml(logs.join('worker.err.log').to_s)}</string>
      </dict></plist>
    PLIST
    RemoteWork::Atomic.write(plist, content, mode: 0o644)
    domain = "gui/#{Process.uid}"
    system("launchctl", "bootout", domain, plist.to_s, out: File::NULL, err: File::NULL)
    raise RemoteWork::Error, "cannot start Mac mini worker LaunchAgent" unless system("launchctl", "bootstrap", domain, plist.to_s)
  end

  def synchronize_source_mirror!
    admin = @root.join("capabilities/remote-work/adapters/remote-work-admin")
    stdout, _stderr, status = Open3.capture3(admin.to_s, "sync-source", chdir: @root.to_s)
    raise RemoteWork::Error, "cannot synchronize the committed Mini workflow source" unless status.success?
    result = JSON.parse(stdout)
    raise RemoteWork::Error, "Mini workflow source synchronization returned invalid data" unless %w[synchronized current].include?(result["result"])
    Pathname.new(
      ENV.fetch("WU_REMOTE_SOURCE_MIRROR_ROOT", File.join(Dir.home, ".local", "share", "two-head-wu", "managed-source"))
    ).expand_path.cleanpath.join("current")
  rescue JSON::ParserError
    raise RemoteWork::Error, "Mini workflow source synchronization returned invalid data"
  end

  def xml(value)
    value.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;").gsub('"', "&quot;").gsub("'", "&apos;")
  end

  def ssh_target
    value, = ProtectedSshTarget.read(SSH_TARGET_ENV)
    raise RemoteWork::Error, "protected SSH target is not installed for secret://remote-work-bootstrap/edge-server/ssh-target" if value.empty?
    raise RemoteWork::Error, "protected SSH target has invalid shape" unless TARGET_PATTERN.match?(value)
    value
  end

  def run_ssh(remote_command, stdin_data: nil)
    Open3.capture3({ "LC_ALL" => "C" }, "ssh", *SSH_OPTIONS, ssh_target, remote_command, stdin_data: stdin_data.to_s)
  end

  def classify_ssh_error(stderr)
    text = stderr.to_s.downcase
    return "host-key-not-trusted" if text.include?("host key verification failed") || text.include?("no host key is known")
    return "public-key-authentication-failed" if text.include?("permission denied")
    return "connection-timeout" if text.include?("timed out")
    return "connection-refused" if text.include?("connection refused")
    return "name-resolution-failed" if text.include?("could not resolve")
    "fixed-remote-command-failed"
  end

  def parse_fields(output, allowed)
    values = {}
    output.to_s.each_line do |line|
      key, value = line.strip.split("=", 2)
      next unless allowed.include?(key)
      raise RemoteWork::Error, "remote response contains invalid value" unless value&.match?(/\A[a-zA-Z0-9._-]+\z/)
      values[key] = value
    end
    raise RemoteWork::Error, "remote response is missing required fields" unless (allowed - values.keys).empty?
    values
  end

  def safe_result(output)
    value = output.to_s.lines.find { |line| line.start_with?("result=") }&.split("=", 2)&.last&.strip
    value if value&.match?(/\A[a-z0-9-]+\z/)
  end

  def ensure_no_arguments!
    raise RemoteWork::Error, "unexpected arguments" unless @arguments.empty?
  end
end

exit RemoteWorkDeploy.new(ARGV).run if $PROGRAM_NAME == __FILE__
