      resource = JSON.parse(resource_out)
      resource_serialized = JSON.generate(resource)
      unless resource["remote_call_succeeded"] == true && resource.dig("output", "schema") == "two-head-wu.resource-catalog.v1" &&
             resource.dig("output", "entries", 0, "id") == "edge-server" &&
             !resource_serialized.match?(/private_ref|secret_ref|ssh|password|token/i)
        raise RemoteWork::Error, "production resource catalog proof is invalid"
