  def validate_catalogs!(catalogs)
    resource = catalogs.fetch(:resources).find { |item| item.fetch("id") == RESOURCE_ID }
    raise RemoteWork::Error, "edge-server is not registered for remote work" unless resource && Array(resource.dig("operations", "allowed_actions")).include?(REQUIRED_ACTION)
    policy = catalogs.fetch(:policy)
    raise RemoteWork::Error, "remote-work policy drift" unless policy["id"] == PACKAGE_ID && policy.dig("remote_service", "root") == REMOTE_ROOT
    raise RemoteWork::Error, "remote-work endpoint drift" unless policy.dig("remote_service", "public_path") == "/two-head-wu/v1"
    sites = catalogs.fetch(:sites).select { |item| SITE_IDS.include?(item.fetch("id")) }
    raise RemoteWork::Error, "registered website set is incomplete" unless sites.map { |item| item.fetch("id") }.sort == SITE_IDS
  end

  def authorized_catalogs!(project_id)
    catalogs = load_catalogs
    validate_catalogs!(catalogs)
    raise RemoteWork::Error, "only project two-head-wu may deploy remote work" unless project_id == PROJECT_ID
    project = catalogs.fetch(:projects).find { |item| item.fetch("id") == project_id }
    raise RemoteWork::Error, "project is unavailable" unless project
    raise RemoteWork::Error, "project is not bound to remote-work" unless Array(project.dig("capabilities", "packages")).include?(PACKAGE_ID)
    required = [RESOURCE_ID] + SITE_IDS
    raise RemoteWork::Error, "project lacks required resources" unless (required - Array(project.dig("resources", "allowed"))).empty?
    catalogs
  end

  def check_sites!(catalogs)
    SITE_IDS.each_with_object({}) do |site_id, result|
      site = catalogs.fetch(:sites).find { |item| item.fetch("id") == site_id }
      uri = URI(site.fetch("public_url"))
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      http.open_timeout = 8
      http.read_timeout = 12
      response = http.request(Net::HTTP::Get.new(uri.request_uri, "User-Agent" => "two-head-wu-remote-work-deploy/#{RemoteWork::VERSION}"))
      code = response.code.to_i
      acceptable = (200..399).cover?(code) || (site_id == "private-site" && [401, 403].include?(code))
      raise RemoteWork::Error, "registered website guard failed for #{site_id}" unless acceptable
      result[site_id] = code
    end
  rescue OpenSSL::SSL::SSLError, Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED => error
    raise RemoteWork::Error, "registered website guard failed: #{error.class}"
  end

  def require_same_sites!(before, after)
    raise RemoteWork::Error, "registered website status changed during remote-work deployment" unless before == after
  end

