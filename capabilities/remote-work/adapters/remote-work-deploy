  def production_artifact_smoke
    options = parse_project_options!(approve: true)
    require_approval!(options)
    catalogs = authorized_catalogs!(options.fetch(:project))
    sites = check_sites!(catalogs)
    public_health!
    device_name = "production-artifact-#{Time.now.utc.strftime('%Y%m%d%H%M%S')}-#{SecureRandom.hex(2)}"
    token = issue_remote_token(device_name, "owner-air")

    Dir.mktmpdir("two-head-wu-production-artifact-") do |temporary|
      root = Pathname.new(temporary)
      client_home = root.join("client")
      project = root.join("project")
      FileUtils.mkdir_p(project.to_s, mode: 0o700)
      project.join("README.md").write("# 生产附件验收\n", encoding: "UTF-8")
      attachment = root.join("air-attachment.md")
      attachment.write("# Air 附件生产验收\n\nartifact channel ok\n", encoding: "UTF-8")
      config = RemoteWork::Config.new(client_home)
      RemoteWork::HTTPClient.enroll(
        endpoint: ENDPOINT,
        token: token,
        device_name: device_name,
        secret_store: "file",
        config: config
      )
      client = @root.join("capabilities/remote-work/adapters/remote-work")
      upload_out, _upload_err, upload_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "artifacts", "upload", attachment.to_s, "--media-type", "text/markdown"
      )
      raise RemoteWork::Error, "production artifact upload failed" unless upload_status.success?
      artifact_id = JSON.parse(upload_out).dig("artifact", "id")
      raise RemoteWork::Error, "production artifact returned an invalid ID" unless artifact_id&.match?(/\Aart-[a-f0-9]{24}\z/)
      submit_out, _submit_err, submit_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "jobs", "submit", "--project", project.to_s, "--artifact", artifact_id, "--",
        "只读取附件，回复附件的一级标题；不要访问网络，不要修改任何文件。"
      )
      raise RemoteWork::Error, "production artifact job submission failed" unless submit_status.success?
      job_id = JSON.parse(submit_out).dig("job", "id")
      http = RemoteWork::HTTPClient.new(config)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 300
      job = nil
      loop do
        job = http.get("jobs/#{job_id}").fetch("job")
        break if %w[succeeded failed cancelled expired].include?(job.fetch("state"))
        if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
          http.post("jobs/#{job_id}/cancel", {})
          raise RemoteWork::Error, "production artifact smoke timed out and was cancelled"
        end
        sleep 2
      end
      unless job.fetch("state") == "succeeded"
        events = http.get("jobs/#{job_id}/events?after=0").fetch("events", [])
        last_event = events.last || {}
        http.post("artifacts/#{artifact_id}/remove", {})
        detail = job["failure"] || last_event["message"] || "no diagnostic"
        raise RemoteWork::Error, "production artifact job did not succeed: #{job.fetch('state')} (#{detail})"
      end
      result = http.get_bytes("jobs/#{job_id}/result")
      raise RemoteWork::Error, "production artifact result hash mismatch" unless Digest::SHA256.hexdigest(result) == job.fetch("result_sha256")
      archive = root.join("result.tar.gz")
      File.open(archive.to_s, "wb", 0o600) { |file| file.write(result) }
      extracted = root.join("result")
      RemoteWork::Archive.unpack(archive, extracted)
      final = extracted.join("final.md").read(encoding: "UTF-8")
      raise RemoteWork::Error, "production artifact was not read by Mini" unless final.include?("Air 附件生产验收")
      removed = http.post("artifacts/#{artifact_id}/remove", {}).dig("artifact", "state")
      raise RemoteWork::Error, "production artifact cleanup failed" unless removed == "removed"
      puts "production artifact smoke: ok"
      puts "job: #{job_id}"
      puts "artifact: transferred-and-removed"
      provenance = JSON.parse(extracted.join("provenance.json").read(encoding: "UTF-8"))
      unless %w[owner-primary owner-secondary].include?(provenance["identity"])
        raise RemoteWork::Error, "production artifact job escaped the owner automatic identity pool"
      end
      puts "identity: #{provenance.fetch('identity')} (owner-auto)"
    end
    print_sites(sites)
    0
  rescue JSON::ParserError, KeyError
    raise RemoteWork::Error, "production artifact smoke returned invalid data"
  end

  def parse_project_options!(approve: false, device: false)
    options = {}
    parser = OptionParser.new do |item|
      item.on("--project ID") { |value| options[:project] = value }
      item.on("--approve") { options[:approve] = true } if approve
      item.on("--device NAME") { |value| options[:device] = value } if device
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    raise RemoteWork::Error, "--project is required" unless options[:project]
    if device
      name = options[:device]
      raise RemoteWork::Error, "--device is required" unless name
      raise RemoteWork::Error, "invalid device name" unless name.match?(/\A[a-z][a-z0-9-]{0,62}\z/)
    end
    options
  end

  def parse_air_pairing_kit_options!
    options = {}
    parser = OptionParser.new do |item|
      item.on("--project ID") { |value| options[:project] = value }
      item.on("--identity ALIAS") { |value| options[:identity] = value }
      item.on("--role ROLE") { |value| options[:role] = value }
      item.on("--platform PLATFORM") { |value| options[:platform] = value }
      item.on("--approve") { options[:approve] = true }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    raise RemoteWork::Error, "--project is required" unless options[:project]
    identity = options[:identity].to_s
    raise RemoteWork::Error, "--identity is invalid" unless identity.match?(/\A[a-z][a-z0-9-]{0,62}\z/)
    raise RemoteWork::Error, "legacy pseudo-identities cannot receive an Air kit" if %w[owner-auto owner-local-catalog].include?(identity)
    role = options[:role].to_s
    raise RemoteWork::Error, "--role must be owner or member" unless AIR_GRANT_PROFILES.key?(role)
    if %w[owner-primary owner-secondary].include?(identity) && role != "owner"
      raise RemoteWork::Error, "owner-primary and owner-secondary Air kits require the owner role"
    end
    platform = options[:platform].to_s
    raise RemoteWork::Error, "--platform must be macos or windows" unless %w[macos windows].include?(platform)
    options.merge(identity: identity, role: role, platform: platform)
  end

  def require_approval!(options)
    raise RemoteWork::Error, "--approve is required for this external mutation" unless options[:approve]
  end

