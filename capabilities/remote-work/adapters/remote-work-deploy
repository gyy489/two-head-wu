#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "digest"
require "fileutils"
require "find"
require "json"
require "net/http"
require "open3"
require "optparse"
require "pathname"
require "securerandom"
require "shellwords"
require "time"
require "tmpdir"
require "uri"
require "yaml"

require_relative "../lib/remote_work"
require_relative "../../remote-work-bootstrap/lib/protected_ssh_target"

class RemoteWorkDeploy
  RESOURCE_ID = "edge-server"
  PROJECT_ID = "two-head-wu"
  PACKAGE_ID = "remote-work"
  SITE_IDS = %w[private-site public-site].freeze
  REQUIRED_ACTION = "host-owner-remote-work-control-plane"
  SSH_TARGET_ENV = "TWO_HEAD_WU_ALIYUN_SSH_TARGET"
  TARGET_PATTERN = /\A(?:[a-z_][a-z0-9_-]*@)?[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\z/i.freeze
  SSH_OPTIONS = [
    "-oBatchMode=yes", "-oPasswordAuthentication=no", "-oKbdInteractiveAuthentication=no",
    "-oChallengeResponseAuthentication=no", "-oStrictHostKeyChecking=yes", "-oConnectTimeout=8",
    "-oConnectionAttempts=1", "-oServerAliveInterval=10", "-oServerAliveCountMax=3", "-oLogLevel=ERROR"
  ].freeze
  UPLOAD_TIMEOUT_SECONDS = 120
  ENDPOINT = "https://relay.example/two-head-wu/v1"
  AIR_ENDPOINT = "https://relay.example/two-head-wu/v2"
  REMOTE_ROOT = "/srv/two-head-wu"
  AIR_PAIRING_TTL = 3600
  AIR_GRANT_PROFILES = {
    "member" => {
      "skill:remote-work" => [],
      "skill:paper-writing" => [],
      "skill:paper-navigator" => [],
      "codex:project-task" => %w[project-read review-result],
      "capability:result-review" => %w[download receipt],
      "research-library:search" => %w[metadata snippets],
      "research-library:get" => %w[metadata],
      "tool:codex-status" => %w[self]
    }.freeze,
    "owner" => {
      "skill:remote-work" => [],
      "skill:paper-writing" => [],
      "skill:paper-navigator" => [],
      "skill:two-head-wu" => [],
      "skill:server-operations" => [],
      "codex:project-task" => %w[project-read review-result],
      "capability:result-review" => %w[download receipt],
      "research-library:search" => %w[metadata snippets],
      "research-library:get" => %w[metadata],
      "tool:codex-status" => %w[self],
      "memory:notebook" => %w[recall remember correct forget]
    }.freeze
  }.freeze

  INSPECT_SCRIPT = <<~'SH'.freeze
    set -eu
    as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n "$@"; fi; }
    [ ! -L /srv/two-head-wu ] && [ -d /srv/two-head-wu ] && [ -f /srv/two-head-wu/state/bootstrap-v1 ] || { printf 'runtime_root=not-ready\n'; exit 71; }
    id twoheadwu >/dev/null 2>&1 || { printf 'system_identity=not-ready\n'; exit 72; }
    if [ "$(id -u)" -ne 0 ]; then command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1 || { printf 'privilege=unavailable\n'; exit 73; }; fi
    for command_name in python3 systemctl nginx curl tar sha256sum; do command -v "$command_name" >/dev/null 2>&1 || { printf 'missing=%s\n' "$command_name"; exit 74; }; done
    python_version=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
    python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' || { printf 'python=unsupported\n'; exit 75; }
    as_root nginx -t >/dev/null 2>&1 || { printf 'nginx=invalid\n'; exit 76; }
    nginx_dump=$(as_root nginx -T 2>&1)
    temp_blocks=$(printf '%s\n' "$nginx_dump" | grep -Ec 'server_name[^;]*public\.example' || true)
    owner_route_count=$(printf '%s\n' "$nginx_dump" | grep -Ec 'two-head-wu/v1' || true)
    member_route_count=$(printf '%s\n' "$nginx_dump" | grep -Ec 'two-head-wu/v2' || true)
    if as_root systemctl is-active --quiet two-head-wu-control-plane.service; then service_state=active; else service_state=inactive; fi
    printf 'runtime_root=ready\n'
    printf 'system_identity=ready\n'
    printf 'privilege=ready\n'
    printf 'python=%s\n' "$python_version"
    printf 'nginx=ready\n'
    printf 'temp_site_matches=%s\n' "$temp_blocks"
    printf 'api_route_matches=%s\n' "$owner_route_count"
    printf 'member_api_route_matches=%s\n' "$member_route_count"
    printf 'service=%s\n' "$service_state"
  SH

  DEPLOY_SCRIPT = <<~'SH'.freeze
    set -eu
    build_id=$1
    expected_sha=$2
    upload=$3
    root=/srv/two-head-wu
    runtime_user=twoheadwu
    stage=
    backup=
    marker=
    unit=
    cleanup_unit=
    cleanup_timer=
    link_tmp=
    release=
    mutated=0
    committed=0
    release_created=0
    previous_current=
    as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n "$@"; fi; }
    cleanup_deployment_files() {
      [ -z "$stage" ] || as_root rm -rf "$stage"
      [ -z "$upload" ] || as_root rm -f "$upload"
      [ -z "$marker" ] || rm -f "$marker"
      [ -z "$unit" ] || rm -f "$unit"
      [ -z "$cleanup_unit" ] || rm -f "$cleanup_unit"
      [ -z "$cleanup_timer" ] || rm -f "$cleanup_timer"
      [ -z "$link_tmp" ] || as_root rm -f "$link_tmp"
    }
    backup_item() {
      source=$1
      name=$2
      if as_root test -e "$source" || as_root test -L "$source"; then
        as_root touch "$backup/$name.exists"
        as_root cp -a "$source" "$backup/$name"
      fi
    }
    restore_item() {
      destination=$1
      name=$2
      as_root rm -rf "$destination" || return 1
      if as_root test -f "$backup/$name.exists"; then
        as_root cp -a "$backup/$name" "$destination" || return 1
      fi
      return 0
    }
    rollback_service_deployment() {
      set +e
      rollback_ok=1
      as_root rm -f "$root/app/current" || rollback_ok=0
      if [ -n "$previous_current" ]; then as_root ln -s "$previous_current" "$root/app/current" || rollback_ok=0; fi
      restore_item "$root/capabilities/published" capabilities-published || rollback_ok=0
      restore_item "$root/components/published" components-published || rollback_ok=0
      restore_item "$root/releases/current.json" releases-current-json || rollback_ok=0
      restore_item "$root/releases/current.tar.gz" releases-current-archive || rollback_ok=0
      restore_item "$root/releases/manifests" releases-manifests || rollback_ok=0
      restore_item /etc/systemd/system/two-head-wu-control-plane.service control-plane-unit || rollback_ok=0
      restore_item /etc/systemd/system/two-head-wu-member-cleanup.service cleanup-unit || rollback_ok=0
      restore_item /etc/systemd/system/two-head-wu-member-cleanup.timer cleanup-timer || rollback_ok=0
      if [ "$release_created" = 1 ]; then as_root rm -rf "$release" || rollback_ok=0; fi
      as_root systemctl daemon-reload || rollback_ok=0
      if [ "$service_enabled_before" = 1 ]; then as_root systemctl enable two-head-wu-control-plane.service >/dev/null 2>&1 || rollback_ok=0; else as_root systemctl disable two-head-wu-control-plane.service >/dev/null 2>&1 || rollback_ok=0; fi
      if [ "$timer_enabled_before" = 1 ]; then as_root systemctl enable two-head-wu-member-cleanup.timer >/dev/null 2>&1 || rollback_ok=0; else as_root systemctl disable two-head-wu-member-cleanup.timer >/dev/null 2>&1 || rollback_ok=0; fi
      if [ "$service_active_before" = 1 ]; then as_root systemctl restart two-head-wu-control-plane.service || rollback_ok=0; else as_root systemctl stop two-head-wu-control-plane.service >/dev/null 2>&1 || rollback_ok=0; fi
      if [ "$timer_active_before" = 1 ]; then as_root systemctl start two-head-wu-member-cleanup.timer || rollback_ok=0; else as_root systemctl stop two-head-wu-member-cleanup.timer >/dev/null 2>&1 || rollback_ok=0; fi
      if [ -n "$previous_current" ]; then
        [ "$(as_root readlink "$root/app/current" 2>/dev/null)" = "$previous_current" ] || rollback_ok=0
      elif as_root test -e "$root/app/current" || as_root test -L "$root/app/current"; then
        rollback_ok=0
      fi
      if [ "$service_active_before" = 1 ]; then as_root systemctl is-active --quiet two-head-wu-control-plane.service || rollback_ok=0; fi
      if [ "$rollback_ok" = 1 ]; then printf 'rollback=completed\n'; else printf 'rollback=incomplete\n'; fi
    }
    finish_deployment() {
      status=$?
      trap - EXIT HUP INT TERM
      set +e
      if [ "$mutated" = 1 ] && [ "$committed" != 1 ]; then rollback_service_deployment; fi
      if [ "$mutated" != 1 ] && [ "$committed" != 1 ] && [ "$release_created" = 1 ] && [ -n "$release" ]; then as_root rm -rf "$release"; fi
      cleanup_deployment_files
      exit "$status"
    }
    trap finish_deployment EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    [ ! -L "$root" ] && [ -d "$root" ] && [ -f "$root/state/bootstrap-v1" ] || { printf 'result=runtime-not-ready\n'; exit 71; }
    [ -f "$upload" ] && [ ! -L "$upload" ] || { printf 'result=upload-invalid\n'; exit 72; }
    printf '%s\n' "$build_id" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+-[a-f0-9]{12}$' || { printf 'result=build-id-invalid\n'; exit 72; }
    printf '%s\n' "$expected_sha" | grep -Eq '^[a-f0-9]{64}$' || { printf 'result=expected-hash-invalid\n'; exit 72; }
    printf '%s\n' "$upload" | grep -Eq '^/srv/two-head-wu/tmp/upload\.[A-Za-z0-9]{8}\.tar\.gz$' || { printf 'result=upload-path-invalid\n'; exit 72; }
    actual_sha=$(sha256sum "$upload" | awk '{print $1}')
    [ "$actual_sha" = "$expected_sha" ] || { printf 'result=upload-hash-mismatch\n'; exit 73; }
    stage=$(as_root mktemp -d "$root/tmp/deploy.XXXXXX")
    tar -tzf "$upload" | awk '
      /^\// || /(^|\/)\.\.($|\/)/ { exit 1 }
      !/^(app|capabilities|components|releases)(\/|$)/ { exit 1 }
    ' || { printf 'result=bundle-layout-invalid\n'; exit 74; }
    as_root tar -xzf "$upload" --no-same-owner -C "$stage"
    [ -f "$stage/app/control_plane.py" ] && [ -f "$stage/app/multi_user_contracts.py" ] && [ -f "$stage/app/member_auth.py" ] && [ -f "$stage/capabilities/manifest.json" ] && [ -f "$stage/capabilities/inventory.json" ] && [ -f "$stage/components/manifest.json" ] && [ -f "$stage/releases/current.json" ] && [ -f "$stage/releases/current.tar.gz" ] || { printf 'result=bundle-incomplete\n'; exit 75; }
    for manifest in "$stage"/releases/manifests/*.json; do
      [ -f "$manifest" ] || continue
      name=$(basename "$manifest")
      case "$name" in stable.json|dev.json) ;; *) printf 'result=release-manifest-invalid\n'; exit 77 ;; esac
    done
    for manifest in "$stage"/releases/manifests/releases/*.json; do
      [ -f "$manifest" ] || continue
      name=$(basename "$manifest")
      printf '%s\n' "$name" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+-[a-f0-9]{12}\.json$' || { printf 'result=release-id-invalid\n'; exit 78; }
    done
    for archive in "$stage"/releases/archives/*.tar.gz; do
      [ -f "$archive" ] || continue
      name=$(basename "$archive")
      printf '%s\n' "$name" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+-[a-f0-9]{12}\.tar\.gz$' || { printf 'result=release-archive-invalid\n'; exit 79; }
    done
    release="$root/app/releases/$build_id"
    if as_root test -e "$release" || as_root test -L "$release"; then
      [ ! -L "$release" ] && [ -d "$release" ] && [ "$(as_root cat "$release/bundle.sha256" 2>/dev/null || true)" = "$expected_sha" ] || { printf 'result=release-conflict\n'; exit 76; }
    else
      as_root install -d -o root -g "$runtime_user" -m 0750 "$root/app" "$root/app/releases" "$release"
      release_created=1
      as_root install -o root -g "$runtime_user" -m 0550 "$stage/app/control_plane.py" "$release/control_plane.py"
      as_root install -o root -g "$runtime_user" -m 0440 "$stage/app/multi_user_contracts.py" "$release/multi_user_contracts.py"
      as_root install -o root -g "$runtime_user" -m 0440 "$stage/app/member_auth.py" "$release/member_auth.py"
      marker=$(mktemp)
      printf '%s\n' "$expected_sha" >"$marker"
      as_root install -o root -g "$runtime_user" -m 0440 "$marker" "$release/bundle.sha256"
      rm -f "$marker"
      marker=
    fi
    if as_root test -L "$root/app/current"; then
      previous_current=$(as_root readlink "$root/app/current")
      printf '%s\n' "$previous_current" | grep -Eq '^releases/v[0-9]+\.[0-9]+\.[0-9]+-[a-f0-9]{12}$' || { printf 'result=current-release-link-invalid\n'; exit 76; }
    elif as_root test -e "$root/app/current"; then
      printf 'result=current-release-not-symlink\n'
      exit 76
    fi
    backup=$(as_root mktemp -d "$root/backups/service-deploy.$build_id.XXXXXX")
    as_root chown root:root "$backup"
    as_root chmod 0700 "$backup"
    backup_item "$root/capabilities/published" capabilities-published
    backup_item "$root/components/published" components-published
    backup_item "$root/releases/current.json" releases-current-json
    backup_item "$root/releases/current.tar.gz" releases-current-archive
    backup_item "$root/releases/manifests" releases-manifests
    backup_item /etc/systemd/system/two-head-wu-control-plane.service control-plane-unit
    backup_item /etc/systemd/system/two-head-wu-member-cleanup.service cleanup-unit
    backup_item /etc/systemd/system/two-head-wu-member-cleanup.timer cleanup-timer
    if as_root systemctl is-enabled --quiet two-head-wu-control-plane.service; then service_enabled_before=1; else service_enabled_before=0; fi
    if as_root systemctl is-active --quiet two-head-wu-control-plane.service; then service_active_before=1; else service_active_before=0; fi
    if as_root systemctl is-enabled --quiet two-head-wu-member-cleanup.timer; then timer_enabled_before=1; else timer_enabled_before=0; fi
    if as_root systemctl is-active --quiet two-head-wu-member-cleanup.timer; then timer_active_before=1; else timer_active_before=0; fi
    link_tmp="$root/app/.current.$build_id"
    as_root rm -f "$link_tmp"
    as_root ln -s "releases/$build_id" "$link_tmp"
    mutated=1
    as_root mv -Tf "$link_tmp" "$root/app/current"
    link_tmp=
    as_root install -d -o "$runtime_user" -g "$runtime_user" -m 0750 "$root/capabilities/published" "$root/components/published" "$root/releases" "$root/releases/archives" "$root/releases/manifests" "$root/releases/manifests/releases"
    for catalog in "$stage"/capabilities/*.json; do [ -f "$catalog" ] || continue; as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$catalog" "$root/capabilities/published/$(basename "$catalog")"; done
    for artifact in "$stage"/components/*; do [ -f "$artifact" ] || continue; as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$artifact" "$root/components/published/$(basename "$artifact")"; done
    as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$stage/releases/current.json" "$root/releases/current.json"
    as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$stage/releases/current.tar.gz" "$root/releases/current.tar.gz"
    for manifest in "$stage"/releases/manifests/*.json; do
      [ -f "$manifest" ] || continue
      name=$(basename "$manifest")
      as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$manifest" "$root/releases/manifests/$name"
    done
    for manifest in "$stage"/releases/manifests/releases/*.json; do
      [ -f "$manifest" ] || continue
      name=$(basename "$manifest")
      as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$manifest" "$root/releases/manifests/releases/$name"
    done
    for archive in "$stage"/releases/archives/*.tar.gz; do
      [ -f "$archive" ] || continue
      name=$(basename "$archive")
      as_root install -o "$runtime_user" -g "$runtime_user" -m 0640 "$archive" "$root/releases/archives/$name"
    done
    python_path=$(command -v python3)
    unit=$(mktemp)
    cat >"$unit" <<EOF
[Unit]
Description=Two-Headed-Wu owner-only control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twoheadwu
Group=twoheadwu
WorkingDirectory=/srv/two-head-wu
ExecStart=$python_path /srv/two-head-wu/app/current/control_plane.py --root /srv/two-head-wu serve --bind 127.0.0.1 --port 18765
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/two-head-wu
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
EOF
    as_root install -o root -g root -m 0644 "$unit" /etc/systemd/system/two-head-wu-control-plane.service
    rm -f "$unit"
    unit=
    cleanup_unit=$(mktemp)
    cat >"$cleanup_unit" <<EOF
[Unit]
Description=Two-Headed-Wu member content TTL cleanup
After=two-head-wu-control-plane.service

[Service]
Type=oneshot
User=twoheadwu
Group=twoheadwu
WorkingDirectory=/srv/two-head-wu
ExecStart=$python_path /srv/two-head-wu/app/current/control_plane.py --root /srv/two-head-wu cleanup-member-content
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/two-head-wu
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=two-head-wu-member-cleanup
EOF
    as_root install -o root -g root -m 0644 "$cleanup_unit" /etc/systemd/system/two-head-wu-member-cleanup.service
    rm -f "$cleanup_unit"
    cleanup_unit=
    cleanup_timer=$(mktemp)
    cat >"$cleanup_timer" <<'EOF'
[Unit]
Description=Schedule Two-Headed-Wu member content TTL cleanup

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true
Unit=two-head-wu-member-cleanup.service

[Install]
WantedBy=timers.target
EOF
    as_root install -o root -g root -m 0644 "$cleanup_timer" /etc/systemd/system/two-head-wu-member-cleanup.timer
    rm -f "$cleanup_timer"
    cleanup_timer=
    as_root systemctl daemon-reload
    as_root systemctl enable two-head-wu-control-plane.service >/dev/null
    as_root systemctl enable --now two-head-wu-member-cleanup.timer >/dev/null
    as_root systemctl restart two-head-wu-control-plane.service
    attempt=0
    expected_version=${build_id%%-*}
    expected_version=${expected_version#v}
    until health=$(curl --fail --silent --show-error http://127.0.0.1:18765/two-head-wu/v1/health) &&
      reported_version=$(printf '%s' "$health" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version", ""))') &&
      [ "$reported_version" = "$expected_version" ] &&
      member_health=$(curl --fail --silent --show-error http://127.0.0.1:18765/two-head-wu/v2/health) &&
      member_version=$(printf '%s' "$member_health" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version", ""))') &&
      [ "$member_version" = "$expected_version" ]; do
      attempt=$((attempt+1)); [ "$attempt" -lt 20 ] || { printf 'result=service-version-health-failed\n'; exit 77; }; sleep 1
    done
    as_root systemctl is-enabled --quiet two-head-wu-member-cleanup.timer &&
      as_root systemctl is-active --quiet two-head-wu-member-cleanup.timer || {
        printf 'result=cleanup-timer-not-active\n'; exit 80;
      }
    committed=1
    printf 'result=ok\nservice=active\nbuild=%s\n' "$build_id"
  SH

  NGINX_SCRIPT = <<~'SH'.freeze
    set -eu
    root=/srv/two-head-wu
    as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n "$@"; fi; }
    [ -f "$root/state/bootstrap-v1" ] || { printf 'result=runtime-not-ready\n'; exit 71; }
    curl --fail --silent http://127.0.0.1:18765/two-head-wu/v1/health >/dev/null || { printf 'result=service-not-ready\n'; exit 72; }
    as_root nginx -t >/dev/null 2>&1 || { printf 'result=nginx-invalid-before\n'; exit 73; }
    english_before=$(curl --silent --output /dev/null --write-out '%{http_code}' https://private.example/)
    temp_before=$(curl --silent --output /dev/null --write-out '%{http_code}' https://public.example/site/)
    matches=$(as_root sh -c "grep -RlE 'server_name[^;]*temp\\.example-owner\\.com' /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null || true")
    resolved=$(printf '%s\n' "$matches" | while IFS= read -r path; do [ -n "$path" ] && readlink -f "$path"; done | sort -u)
    count=$(printf '%s\n' "$resolved" | sed '/^$/d' | wc -l | tr -d ' ')
    [ "$count" = 1 ] || { printf 'result=temp-site-config-ambiguous\n'; exit 74; }
    config=$(printf '%s\n' "$resolved" | sed -n '1p')
    case "$config" in /etc/nginx/sites-available/*|/etc/nginx/conf.d/*) ;; *) printf 'result=temp-site-config-unsafe\n'; exit 75;; esac
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    backup="$root/backups/nginx-temp-site.$timestamp.conf"
    include_backup="$root/backups/nginx-remote-work-location.$timestamp.conf"
    as_root install -o root -g root -m 0600 "$config" "$backup"
    as_root install -d -o root -g root -m 0755 /etc/nginx/two-head-wu
    had_include=0
    if [ -f /etc/nginx/two-head-wu/remote-work-location.conf ]; then as_root install -o root -g root -m 0600 /etc/nginx/two-head-wu/remote-work-location.conf "$include_backup"; had_include=1; fi
    rollback() {
      as_root install -o root -g root -m 0644 "$backup" "$config"
      if [ "$had_include" = 1 ]; then as_root install -o root -g root -m 0644 "$include_backup" /etc/nginx/two-head-wu/remote-work-location.conf; else as_root rm -f /etc/nginx/two-head-wu/remote-work-location.conf; fi
      as_root nginx -t >/dev/null 2>&1 && as_root systemctl reload nginx || true
    }
    location_tmp=$(mktemp)
    cat >"$location_tmp" <<'EOF'
location = /two-head-wu/v1 {
    return 308 /two-head-wu/v1/;
}
location /two-head-wu/v1/ {
    client_max_body_size 70m;
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_pass http://127.0.0.1:18765;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
location = /two-head-wu/v2 {
    return 308 /two-head-wu/v2/;
}
location /two-head-wu/v2/ {
    client_max_body_size 70m;
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_pass http://127.0.0.1:18765;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
EOF
    as_root install -o root -g root -m 0644 "$location_tmp" /etc/nginx/two-head-wu/remote-work-location.conf
    rm -f "$location_tmp"
    patch_tmp=$(mktemp)
    if ! python3 - "$config" >"$patch_tmp" <<'PY'
import re, sys
path=sys.argv[1]
text=open(path, encoding="utf-8").read()
lines=text.splitlines(True)
blocks=[]
depth=0
server_start=None
for index,line in enumerate(lines):
    clean=re.sub(r'#.*','',line)
