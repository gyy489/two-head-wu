        depth=clean.count('{')-clean.count('}')
        if depth == 0:
            blocks.append((server_start, index))
            server_start=None
    elif server_start is not None:
        depth += clean.count('{')-clean.count('}')
        if depth == 0:
            blocks.append((server_start, index))
