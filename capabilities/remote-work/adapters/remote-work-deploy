  end

  def public_health!
    uri = URI("#{ENDPOINT}/health")
    response = Net::HTTP.get_response(uri)
    raise RemoteWork::Error, "public remote-work health check failed" unless response.code.to_i == 200
    value = JSON.parse(response.body)
    valid = value["status"] == "ok" && value["scope"] == "owner-only" && value["version"] == RemoteWork::VERSION
    raise RemoteWork::Error, "public remote-work health response is invalid or stale" unless valid
  rescue OpenSSL::SSL::SSLError, SocketError, Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, JSON::ParserError => error
    raise RemoteWork::Error, "public remote-work health check failed: #{error.class}"
  end

  def public_air_health!
    uri = URI("#{AIR_ENDPOINT}/health")
    response = Net::HTTP.get_response(uri)
    raise RemoteWork::Error, "public Air v2 health check failed" unless response.code.to_i == 200
    value = JSON.parse(response.body)
    valid = value["status"] == "ok" && value["scope"] == "air-v2" &&
            value["version"] == RemoteWork::VERSION && value["authentication"] == "configured"
    raise RemoteWork::Error, "public Air v2 health response is invalid or stale" unless valid
  rescue OpenSSL::SSL::SSLError, SocketError, Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, JSON::ParserError => error
    raise RemoteWork::Error, "public Air v2 health check failed: #{error.class}"
  end

