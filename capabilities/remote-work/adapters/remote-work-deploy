  def inspect_remote
    options = parse_project_options!
    catalogs = authorized_catalogs!(options.fetch(:project))
    ssh_target
    sites = check_sites!(catalogs)
    stdout, stderr, status = run_ssh("sh -s", stdin_data: INSPECT_SCRIPT)
    raise RemoteWork::Error, "remote inspect failed: #{classify_ssh_error(stderr)}" unless status.success?
    fields = parse_fields(stdout, %w[runtime_root system_identity privilege python nginx temp_site_matches api_route_matches member_api_route_matches service])
    fields.each { |key, value| puts "#{key}: #{value}" }
    print_sites(sites)
    0
  end

  def deploy_service
    options = parse_project_options!(approve: true)
    require_approval!(options)
    catalogs = authorized_catalogs!(options.fetch(:project))
    synchronize_source_mirror!
    before = check_sites!(catalogs)
    inspect_or_raise!
    archive, build_id, digest = build_bundle
    remote_path = allocate_remote_upload
    upload_bundle(archive, remote_path)
    stdout, stderr, status = run_ssh("sh -s -- #{build_id} #{digest} #{remote_path}", stdin_data: DEPLOY_SCRIPT)
    raise RemoteWork::Error, "remote service deployment stopped: #{safe_result(stdout) || classify_ssh_error(stderr)}" unless status.success?
    fields = parse_fields(stdout, %w[result service build])
    raise RemoteWork::Error, "remote service returned invalid result" unless fields["result"] == "ok" && fields["service"] == "active"
    after = check_sites!(catalogs)
    require_same_sites!(before, after)
    puts "remote service deployment: ok"
    puts "build: #{fields.fetch('build')}"
    print_sites(after)
    0
  end

  def install_https_route
    options = parse_project_options!(approve: true)
    require_approval!(options)
    catalogs = authorized_catalogs!(options.fetch(:project))
    before = check_sites!(catalogs)
    stdout, stderr, status = run_ssh("sh -s", stdin_data: NGINX_SCRIPT)
    raise RemoteWork::Error, "HTTPS route deployment stopped: #{safe_result(stdout) || classify_ssh_error(stderr)}" unless status.success?
    fields = parse_fields(stdout, %w[result route])
    raise RemoteWork::Error, "HTTPS route returned invalid result" unless fields["result"] == "ok" && fields["route"] == "active"
    after = check_sites!(catalogs)
    require_same_sites!(before, after)
    public_health!
    puts "HTTPS route: active"
    print_sites(after)
    0
  end

