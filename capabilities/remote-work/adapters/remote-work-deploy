  def initialize(arguments)
    @arguments = arguments.dup
    @root = Pathname.new(__dir__).join("../../..").expand_path.cleanpath
  end

  def run
    command = @arguments.shift || "help"
    case command
    when "help", "--help", "-h" then help
    when "health" then health
    when "inspect" then inspect_remote
    when "deploy-service" then deploy_service
    when "install-https-route" then install_https_route
    when "issue-air-installer" then issue_air_installer
    when "issue-air-worker-enrollment", "issue-member-worker-enrollment" then issue_air_worker_enrollment
    when "issue-air-pairing-kit" then issue_air_pairing_kit
    when "install-worker" then install_worker
    when "production-smoke" then production_smoke
    when "production-job-smoke" then production_job_smoke
    when "production-tool-smoke" then production_tool_smoke
    when "production-air-sync-smoke" then production_air_sync_smoke
    when "production-artifact-smoke" then production_artifact_smoke
    else raise RemoteWork::Error, "unknown deploy command: #{command}"
    end
  rescue OptionParser::ParseError => error
    warn "Error: #{error.message}"
    2
  rescue RemoteWork::Error, KeyError, JSON::ParserError, Psych::Exception, SystemCallError => error
    warn "Error: #{error.message}"
    2
  end

