  def issue_air_pairing_kit
    options = parse_air_pairing_kit_options!
    require_approval!(options)
    authorized_catalogs!(options.fetch(:project))
    public_air_health!
    identity = options.fetch(:identity)
    role = options.fetch(:role)
    platform = options.fetch(:platform)
    provisioned = remote_control_plane_json(
      "ensure-air-user", "--identity-alias", identity, "--role", role
    )
    user = provisioned.fetch("user")
    user_id = user.fetch("id")
    unless user_id.match?(/\Ausr-[a-z0-9][a-z0-9-]{7,63}\z/) &&
           user.fetch("role") == role && provisioned.dig("codex_binding", "identity_alias") == identity
      raise RemoteWork::Error, "remote Air user provisioning returned invalid data"
    end
    AIR_GRANT_PROFILES.fetch(role).sort.each do |capability_id, scopes|
      remote_control_plane_json(
        "ensure-air-grant", "--user", user_id, "--capability", capability_id,
        *scopes.flat_map { |scope| ["--scope", scope] }
      )
    end
    token = remote_air_pairing_token(user_id, platform)
    output = air_pairing_kit_root.join(identity)
    FileUtils.mkdir_p(output.to_s, mode: 0o700)
    File.chmod(0o700, output.to_s)
    issued_at = Time.now.utc
    kit = output.join("#{issued_at.strftime('%Y%m%dT%H%M%SZ')}-#{platform}-#{SecureRandom.hex(3)}")
    FileUtils.mkdir_p(kit.to_s, mode: 0o700)
    RemoteWork::Atomic.write(kit.join("pairing.token"), token + "\n", mode: 0o600)
    RemoteWork::Atomic.json(
      kit.join("kit.json"),
      {
        "schema_version" => 1,
        "identity_alias" => identity,
        "user_id" => user_id,
        "role" => role,
        "platform" => platform,
        "endpoint" => AIR_ENDPOINT,
        "issued_at" => issued_at.iso8601,
        "expires_at" => (issued_at + AIR_PAIRING_TTL).iso8601,
        "installer" => "separate-common-signed-package",
        "one_active_device" => true
      },
      mode: 0o600
    )
    RemoteWork::Atomic.write(kit.join("安装说明.txt"), air_pairing_instructions(platform), mode: 0o600)
    puts kit
    0
  ensure
    token&.replace("x" * token.bytesize)
  end

