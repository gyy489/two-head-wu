  def production_job_smoke
    options = parse_project_options!(approve: true)
    require_approval!(options)
    catalogs = authorized_catalogs!(options.fetch(:project))
    sites = check_sites!(catalogs)
    public_health!
    device_name = "production-smoke-#{Time.now.utc.strftime('%Y%m%d%H%M%S')}-#{SecureRandom.hex(2)}"
    token = issue_remote_token(device_name, "owner-air")

    Dir.mktmpdir("two-head-wu-production-smoke-") do |temporary|
      temporary_root = Pathname.new(temporary)
      client_home = temporary_root.join("client")
      project = temporary_root.join("project")
      FileUtils.mkdir_p(project.to_s, mode: 0o700)
      project.join("README.md").write("Two-Headed-Wu production relay smoke test.\n", encoding: "UTF-8")
      config = RemoteWork::Config.new(client_home)
      RemoteWork::HTTPClient.enroll(
        endpoint: ENDPOINT,
        token: token,
        device_name: device_name,
        secret_store: "file",
        config: config
      )
      client = @root.join("capabilities/remote-work/adapters/remote-work")
      stdout, _stderr, status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "jobs", "submit", "--project", project.to_s, "--",
        "不要调用任何工具，不要修改文件，只需回复：两头乌生产任务链路正常。"
      )
      raise RemoteWork::Error, "production job submission failed" unless status.success?
      job_id = JSON.parse(stdout).fetch("job").fetch("id")
      raise RemoteWork::Error, "production job returned an invalid ID" unless job_id.match?(/\Ajob-[a-z0-9-]+\z/)
      http = RemoteWork::HTTPClient.new(config)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 300
      job = nil
      loop do
        job = http.get("jobs/#{job_id}").fetch("job")
        break if %w[succeeded failed cancelled expired].include?(job.fetch("state"))
        if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
          http.post("jobs/#{job_id}/cancel", {})
          raise RemoteWork::Error, "production job smoke timed out and was cancelled"
        end
        sleep 2
      end
      raise RemoteWork::Error, "production job smoke did not succeed: #{job.fetch('state')}" unless job.fetch("state") == "succeeded"

      result = http.get_bytes("jobs/#{job_id}/result")
      raise RemoteWork::Error, "production job result hash mismatch" unless Digest::SHA256.hexdigest(result) == job.fetch("result_sha256")
      archive = temporary_root.join("result.tar.gz")
      File.open(archive.to_s, "wb", 0o600) { |file| file.write(result) }
      extracted = temporary_root.join("result")
      RemoteWork::Archive.unpack(archive, extracted)
      final = extracted.join("final.md")
      provenance = JSON.parse(extracted.join("provenance.json").read(encoding: "UTF-8"))
      raise RemoteWork::Error, "production job returned no final response" unless final.file? && !final.read(encoding: "UTF-8").strip.empty?
      unless %w[owner-primary owner-secondary].include?(provenance["identity"])
        raise RemoteWork::Error, "production job escaped the owner automatic identity pool"
      end
      raise RemoteWork::Error, "production job did not use the app-server executor" unless provenance["executor"] == "app-server"
      puts "production job smoke: ok"
      puts "job: #{job_id}"
      puts "identity: #{provenance.fetch('identity')} (owner-auto)"
      puts "executor: app-server"
    end
    print_sites(sites)
    0
  rescue JSON::ParserError, KeyError
    raise RemoteWork::Error, "production job smoke returned invalid data"
  end

  def production_tool_smoke
    options = parse_project_options!(approve: true)
    require_approval!(options)
    catalogs = authorized_catalogs!(options.fetch(:project))
    sites = check_sites!(catalogs)
    public_health!
    device_name = "production-tool-#{Time.now.utc.strftime('%Y%m%d%H%M%S')}-#{SecureRandom.hex(2)}"
    token = issue_remote_token(device_name, "owner-air")

    Dir.mktmpdir("two-head-wu-production-tool-") do |temporary|
      client_home = Pathname.new(temporary).join("client")
      config = RemoteWork::Config.new(client_home)
      RemoteWork::HTTPClient.enroll(
        endpoint: ENDPOINT,
        token: token,
        device_name: device_name,
        secret_store: "file",
        config: config
      )
      client = @root.join("capabilities/remote-work/adapters/remote-work")
      modules_out, _modules_err, modules_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s }, client.to_s, "modules", "list"
      )
      unless modules_status.success? && modules_out.lines.any? { |line| line.start_with?("skill:remote-work\tportable\tactive\t") }
        raise RemoteWork::Error, "production signed module manifest verification failed"
      end
      abilities_out, _abilities_err, abilities_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s }, client.to_s, "abilities", "list", "--json"
      )
      raise RemoteWork::Error, "production signed capability discovery failed" unless abilities_status.success?
      abilities = JSON.parse(abilities_out)
      local_entries = Array(abilities["local_capabilities"])
      remote_entries = Array(abilities["remote_capabilities"])
      valid_capabilities = abilities["catalog_signature"] == "verified" &&
                           abilities["directory_source"] == "live" &&
                           abilities.dig("mini", "online") == true &&
                           local_entries.length.positive? &&
                           local_entries.all? { |item| !item["name"].to_s.empty? && !item["summary"].to_s.empty? } &&
                           remote_entries.length == 25 &&
                           remote_entries.all? { |item| !item["name"].to_s.empty? && !item["summary"].to_s.empty? } &&
                           remote_entries.any? do |item|
                             item["id"] == "tool:codex-status" && item["invocation_policy"] == "auto" && item["availability"] == "ready"
                           end &&
                           remote_entries.any? do |item|
                             item["id"] == "workflow:sync-air" && item["invocation_policy"] == "confirm"
                           end
      raise RemoteWork::Error, "production capability directory returned invalid state" unless valid_capabilities
      memory = Array(abilities["remote_capabilities"]).find { |item| item["id"] == "mcp:private-memory" }
      unless memory && memory["invocation_policy"] == "unavailable" && memory["availability"] == "metadata-only"
        raise RemoteWork::Error, "production capability directory falsely exposed private memory"
      end
      inventory = abilities.fetch("mini_inventory")
      entries = Array(inventory["entries"])
      forbidden_inventory_fields = %w[path command endpoint private_ref secret_ref executable workspace device_secret access_token]
      valid_inventory = inventory["signature"] == "verified" && inventory["total"] == entries.length &&
                        entries.length.positive? && inventory.dig("counts_by_kind", "skill").to_i.positive? &&
                        entries.all? { |item| !item["name"].to_s.empty? && !item["summary"].to_s.empty? } &&
                        entries.none? { |item| (item.keys & forbidden_inventory_fields).any? }
      raise RemoteWork::Error, "production Mini inventory is invalid or unsafe" unless valid_inventory
      if abilities_out.match?(/"(?:device_secret|access_token|private_ref|secret_ref)"\s*:/i)
        raise RemoteWork::Error, "production capability response leaked protected fields"
      end
      stdout, _stderr, status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "tools", "invoke", "codex-status", "--json", "--timeout", "300"
      )
      raise RemoteWork::Error, "production codex-status invocation failed" unless status.success?
      result = JSON.parse(stdout)
      accounts = Array(result["accounts"])
      raise RemoteWork::Error, "production codex-status schema drift" unless result["schema"] == "two-head-wu.codex-status.v1"
      raise RemoteWork::Error, "production codex-status returned no identities" if accounts.empty?
      serialized = JSON.generate(result)
      if serialized.match?(/CODEX_HOME|codex_home|auth\.json|Keychain|device_secret|access_token/i)
        raise RemoteWork::Error, "production codex-status leaked protected fields"
      end
      unless accounts.all? do |item|
               five_hour = item["five_hour"]
               weekly = item["weekly"]
               (five_hour.nil? || five_hour["window_duration_mins"] == 300) &&
                 (weekly.nil? || weekly["window_duration_mins"] == 10_080)
             end
        raise RemoteWork::Error, "production codex-status quota window mapping drift"
      end
      reset_order = accounts.map { |item| item.dig("five_hour", "resets_at") || item.dig("primary", "resets_at") || Float::INFINITY }
      raise RemoteWork::Error, "production codex-status is not sorted by reset time" unless reset_order == reset_order.sort

      runtime_out, _runtime_err, runtime_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "invoke", "tool:runtime-status", "--json", "--timeout", "300"
      )
      raise RemoteWork::Error, "production generic runtime invocation failed" unless runtime_status.success?
      runtime = JSON.parse(runtime_out)
      codex_runtime = Array(runtime.dig("output", "catalog", "runtimes")).find do |item|
        item["runtime_kind"] == "codex-app-server"
      end
      unless runtime["remote_call_succeeded"] == true && runtime["actual_executor"] == "mac-mini" &&
             runtime.dig("output", "schema") == "two-head-wu.runtime-status.v1" &&
             runtime.dig("output", "catalog", "protocol_min") == RemoteWork::PROTOCOL_VERSION &&
             runtime.dig("output", "catalog", "protocol_max") == RemoteWork::PROTOCOL_VERSION &&
             codex_runtime && codex_runtime["health"] == "compatible"
        safe_runtime = {
          remote_call_succeeded: runtime["remote_call_succeeded"],
          actual_executor: runtime["actual_executor"],
          schema: runtime.dig("output", "schema"),
          protocol_min: runtime.dig("output", "catalog", "protocol_min"),
          protocol_max: runtime.dig("output", "catalog", "protocol_max"),
          health: codex_runtime && codex_runtime["health"],
          runtime_version: codex_runtime && codex_runtime["runtime_version"]
        }
        raise RemoteWork::Error, "production worker runtime compatibility proof is invalid: #{JSON.generate(safe_runtime)}"
      end

      adapters_out, _adapters_err, adapters_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "invoke", "tool:module-catalog", "--json", "--timeout", "300"
      )
      raise RemoteWork::Error, "production Mini adapter discovery failed" unless adapters_status.success?
      adapters = JSON.parse(adapters_out)
      adapter_ids = Array(adapters.dig("output", "adapters")).map { |item| item["capability_id"] }
      required_adapters = Array(
        YAML.safe_load(
          @root.join("capabilities/remote-work/worker/capability-adapters.yaml").read(encoding: "UTF-8"),
          permitted_classes: [], aliases: false
        ).fetch("adapters")
      ).map { |item| item.fetch("capability_id") }
      missing_adapters = required_adapters - adapter_ids
      extra_adapters = adapter_ids - required_adapters
      unless adapters["remote_call_succeeded"] == true && missing_adapters.empty?
        proof = {
          remote_call_succeeded: adapters["remote_call_succeeded"],
          state: adapters["state"],
          reason: adapters["fallback_reason"] || adapters["error"],
          adapter_count: adapter_ids.length,
          missing: missing_adapters,
          extra: extra_adapters
        }
        raise RemoteWork::Error, "production Mini adapter registry is incomplete: #{JSON.generate(proof)}"
      end

      identity_out, _identity_err, identity_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "invoke", "tool:identity-catalog", "--json", "--timeout", "300"
      )
      raise RemoteWork::Error, "production identity catalog invocation failed" unless identity_status.success?
      identity = JSON.parse(identity_out)
      identity_serialized = JSON.generate(identity)
      unless identity["remote_call_succeeded"] == true && identity.dig("output", "schema") == "two-head-wu.identity-catalog.v1" &&
             Array(identity.dig("output", "identities")).any? { |item| item["id"] == "owner-primary" } &&
             !identity_serialized.match?(/codex_home|CODEX_HOME|auth\.json|access_token/i)
