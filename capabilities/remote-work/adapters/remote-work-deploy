      workflow_out, _workflow_err, workflow_status = Open3.capture3(
        { "WU_REMOTE_HOME" => client_home.to_s },
        client.to_s, "invoke", "workflow:remote-work-health", "--wait", "--json", "--timeout", "300"
      )
      unless workflow_status.success?
        proof = begin
