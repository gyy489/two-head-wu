  def local_module_capabilities(modules)
    state = @config.state
    installed = state.fetch("installed_modules", {})
    policies = state.fetch("module_policies", {})
    modules.select { |item| item["classification"] == "portable" }.map do |item|
      local = installed[item.fetch("id")] || {}
      mode = policies[item.fetch("id")] || item.fetch("default_mode", "on-demand")
      local_version = local["version"]
      available = local_version && local["path"] && Pathname.new(local["path"]).directory?
      availability = if item["status"] != "active"
                       "revoked"
                     elsif %w[off metadata-only].include?(mode)
                       available ? "disabled" : "not-installed"
                     elsif !available
                       "not-installed"
                     elsif local_version == item["version"]
                       "ready"
                     else
                       "outdated"
                     end
      {
        "id" => item.fetch("id"),
        "name" => item.fetch("id").split(":", 2).last,
        "kind" => "skill",
        "location" => "air",
        "availability" => availability,
        "invocation_policy" => availability == "ready" ? "auto" : "manual",
        "side_effect" => "read-only",
        "module_mode" => mode,
        "installed_version" => local_version,
        "available_version" => item["version"],
        "command" => available ? nil : "wu 拉取模块 #{item.fetch('id')}",
        "summary" => item.fetch("summary")
      }.compact
    end
  end

  def print_capability_view(view, scope)
    source = view.fetch("directory_source") == "live" ? "实时目录" : "已验证缓存"
    mini_state = if view.dig("mini", "online") == true
                   "online"
                 elsif view.dig("mini", "online") == false
                   "offline"
                 else
                   "unknown（缓存）"
                 end
    puts "两头乌能力目录（#{source}，签名 verified）"
    puts "目录版本：#{view.fetch('catalog_version')}　Mini：#{mini_state}　观测：#{view.fetch('observed_at', '-')}"
    puts "警告：#{view['warning']}" if view["warning"]
    if scope != :remote
      puts "\nAir 本地能力"
      print_capability_rows(view.fetch("local_capabilities"))
    end
    if scope != :local
      puts "\nMini 可执行入口"
      print_capability_rows(view.fetch("remote_capabilities"))
      puts "\nMini 完整功能表（#{view.dig('mini_inventory', 'total')} 项）"
      print_inventory_rows(view.dig("mini_inventory", "entries"))
      unless view.fetch("models").empty?
        puts "\nMini 模型"
        view.fetch("models").each do |model|
          marker = model["is_default"] ? "默认" : "可选"
          puts "- [#{availability_label(model.fetch('availability'))}] #{model.fetch('id')}（#{marker}）"
        end
      end
    end
    puts "\n说明：#{view.fetch('policy_note')}"
  end

