  def ensure_codex_bridge!(binary)
    stdout, _stderr, status = Open3.capture3("codex", "mcp", "get", "two-head-wu", "--json")
    if status.success?
      value = JSON.parse(stdout)
      current = value.dig("transport", "command")
      raise RemoteWork::Error, "Codex 中的 two-head-wu MCP 名称已被其他程序占用" unless current == binary.to_s
      return false
    end
    _add_stdout, add_stderr, add_status = Open3.capture3("codex", "mcp", "add", "two-head-wu", "--", binary.to_s)
    raise RemoteWork::Error, "无法注册 Codex MCP 能力桥：#{add_stderr.to_s.lines.first.to_s.strip}" unless add_status.success?
    true
  rescue JSON::ParserError
    raise RemoteWork::Error, "Codex MCP 状态响应无效"
  rescue Errno::ENOENT
    raise RemoteWork::Error, "没有找到 Codex CLI，暂时不能注册 MCP 能力桥"
  end

  def bridge_status
    ensure_no_arguments!
    stdout, _stderr, status = Open3.capture3("codex", "mcp", "get", "two-head-wu", "--json")
    raise RemoteWork::Error, "Codex 尚未登记 two-head-wu MCP；运行 wu remote bridge install" unless status.success?
    value = JSON.parse(stdout)
    value["expected_command"] = bridge_binary.to_s
    value["healthy"] = value.dig("transport", "command") == bridge_binary.to_s && value["enabled"] == true
    puts JSON.pretty_generate(value)
    value["healthy"] ? 0 : 2
  rescue JSON::ParserError
    raise RemoteWork::Error, "Codex MCP 状态响应无效"
  rescue Errno::ENOENT
    raise RemoteWork::Error, "没有找到 Codex CLI"
  end

