                raise RemoteWork::Error, "没有有效选择；交互保持待处理" unless decision
                { "decision" => decision }
              end
    puts JSON.pretty_generate(http.post("jobs/#{job_id}/interactions/#{interaction_id}/reply", payload))
    0
  end

  def companion_plist_path
    Pathname.new(File.join(Dir.home, "Library", "LaunchAgents", "com.twoheadwu.remote-companion.plist"))
  end

  def apple_escape(value)
    value.to_s.gsub("\\", "\\\\").gsub('"', '\\"').gsub("\n", " ")
  end

  def command_available?(name)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |directory|
      path = File.join(directory, name)
      File.file?(path) && File.executable?(path)
    end
  end

  def diagnose
    ensure_no_arguments!
    report = {
      "version" => RemoteWork::VERSION,
      "configured" => @config.configured?,
      "config_permissions" => @config.path.file? ? format("%04o", @config.path.stat.mode & 0o777) : nil,
      "secret" => "not-checked",
      "control_plane" => "not-checked"
    }
    if @config.configured?
      begin
        secret = @config.secret
        report["secret"] = secret.empty? ? "missing" : "ready"
        response = http.get("me")
        report["control_plane"] = "reachable"
        report["device_id"] = response.fetch("device").fetch("id")
        report["role"] = response.fetch("device").fetch("role")
      rescue RemoteWork::Error => error
        report["control_plane"] = "failed"
        report["error"] = error.message
      end
    end
    puts JSON.pretty_generate(report.compact)
    report["configured"] && report["secret"] == "ready" && report["control_plane"] == "reachable" ? 0 : 2
  end

  def owner_policy
    YAML.safe_load(@root.join("capabilities/remote-work/policies/owner-only.yaml").read(encoding: "UTF-8"), permitted_classes: [], aliases: false)
  end

  def remote_modules
    value = http.get("modules")
    RemoteWork::ModuleSignature.verify!(value, release_public_key.read)
    Array(value.fetch("modules"))
  end

  def http
    @http ||= RemoteWork::HTTPClient.new(@config)
  end

  def validate_module_id!(value)
    raise RemoteWork::Error, "缺少模块 ID" unless value
    raise RemoteWork::Error, "模块 ID 无效" unless MODULE_ID.match?(value)
    value
  end

  def validate_job_id!(value)
    raise RemoteWork::Error, "缺少任务 ID" unless value
    raise RemoteWork::Error, "任务 ID 无效" unless JOB_ID.match?(value)
    value
  end

  def validate_interaction_id!(value)
    raise RemoteWork::Error, "缺少交互 ID" unless value
    raise RemoteWork::Error, "交互 ID 无效" unless INTERACTION_ID.match?(value)
    value
  end

  def validate_artifact_id!(value)
    raise RemoteWork::Error, "缺少附件 ID" unless value
    raise RemoteWork::Error, "附件 ID 无效" unless ARTIFACT_ID.match?(value)
    value
  end

  def normalize_decision(value)
    mapping = {
      "接受" => "accept", "accept" => "accept",
      "本次会话" => "acceptForSession", "acceptForSession" => "acceptForSession",
      "拒绝" => "decline", "decline" => "decline",
      "取消" => "cancel", "cancel" => "cancel"
    }
    mapping.fetch(value) { raise RemoteWork::Error, "选择必须是 接受、本次会话、拒绝 或 取消" }
  end

  def save_event_cursor(job_id, cursor)
    state = @config.state
    state.fetch("event_cursors", {})[job_id] = cursor
    @config.save_state(state)
  end

  def secure_equal?(first, second)
    return false unless first.bytesize == second.bytesize
    difference = 0
    first.bytes.zip(second.bytes) { |left, right| difference |= left ^ right }
    difference.zero?
  end

  def ensure_no_arguments!
    raise RemoteWork::Error, "未知参数：#{@arguments.join(' ')}" unless @arguments.empty?
  end
end

exit RemoteWorkClient.new(ARGV).run
