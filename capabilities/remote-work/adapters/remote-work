  def open_interaction_terminal(job_id, interaction_id, prompt)
    title = prompt.fetch("title", "Mini 需要你的确认").to_s[0, 120]
    if ENV["WU_REMOTE_COMPANION_NO_UI"] == "1"
      puts "pending\t#{job_id}\t#{interaction_id}\t#{title}"
      return
    end
    wu = File.join(Dir.home, ".local", "bin", "wu")
    command = [wu, "remote", "companion", "prompt", job_id, interaction_id].shelljoin
    notification = %(display notification "#{apple_escape(title)}" with title "两头乌 Mini 等待确认")
    terminal = %(tell application "Terminal" to do script "#{apple_escape(command)}")
    system("osascript", "-e", notification, out: File::NULL, err: File::NULL)
    raise RemoteWork::Error, "无法打开 Air 交互终端；请运行 wu 待处理 #{job_id}" unless system("osascript", "-e", terminal, "-e", %(tell application "Terminal" to activate), out: File::NULL, err: File::NULL)
  rescue Errno::ENOENT
