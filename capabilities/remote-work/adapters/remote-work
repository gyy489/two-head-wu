  def companion_tick
    air_sync_report = reconcile_pending_air_sync
    project_reports = @config.state.fetch("active_projects", {}).map do |job_id, binding|
      begin
        sync_project_binding(job_id, binding)
      rescue RemoteWork::Error => error
        { "job_id" => job_id, "result" => "error", "error" => error.message }
      end
    end
    notified = []
    jobs = http.get("jobs").fetch("jobs")
    jobs.select { |job| job["state"] == "waiting_user" }.each do |job|
      interactions = http.get("jobs/#{job.fetch('id')}/interactions").fetch("interactions")
      interactions.select { |item| item["status"] == "pending" }.each do |interaction|
        next if interaction_notified?(interaction.fetch("id"))
        open_interaction_terminal(job.fetch("id"), interaction.fetch("id"), interaction.fetch("prompt", {}))
        mark_interaction_notified(interaction.fetch("id"), job.fetch("id"))
        notified << interaction.fetch("id")
      end
    end
    {
      "schema_version" => 1,
      "observed_at" => Time.now.utc.iso8601,
      "air_sync" => air_sync_report,
      "notified" => notified,
      "projects" => project_reports
    }
  end

  def reconcile_pending_air_sync
    record = @config.state["air_sync"]
    return { "status" => "idle" } unless record.is_a?(Hash) && record["status"] == "queued" && record["job_id"]

    job_id = validate_job_id!(record.fetch("job_id"))
    job = http.get("jobs/#{job_id}").fetch("job")
    return { "status" => job.fetch("state"), "job_id" => job_id } unless TERMINAL_STATES.include?(job.fetch("state"))

    unless job.fetch("state") == "succeeded"
      reason = job.fetch("failure", job.fetch("state"))
      save_air_sync_state(trigger: record.fetch("trigger", "queued-air-sync"), status: "failed", job_id: job_id, reason: reason)
      return { "status" => "failed", "job_id" => job_id, "reason" => reason }
    end

    destination = fetch_result(job_id, job)
    output_path = destination.join("output.json")
    raise RemoteWork::Error, "排队的 Air 同步流水线没有结构化结果" unless output_path.file?
    output = JSON.parse(output_path.read(encoding: "UTF-8"))
    raise RemoteWork::Error, "排队的 Air 同步流水线结果不受支持" unless output["schema"] == "two-head-wu.air-sync.v1"

    if output.fetch("status") == "completed"
      modules_update
      sync_capability_directory!(quiet: true)
      save_air_sync_state(
        trigger: record.fetch("trigger", "queued-air-sync"), status: "completed",
        job_id: job_id, catalog_version: output["catalog_version"]
      )
      { "status" => "completed", "job_id" => job_id, "catalog_version" => output["catalog_version"] }
    elsif output.fetch("status") == "review-required"
      pending = Array(output["pending_review"])
      save_air_sync_state(
        trigger: record.fetch("trigger", "queued-air-sync"), status: "review-required",
        job_id: job_id, pending_review: pending
      )
      { "status" => "review-required", "job_id" => job_id, "pending_review" => pending }
    else
      save_air_sync_state(
        trigger: record.fetch("trigger", "queued-air-sync"), status: "failed",
        job_id: job_id, reason: "unknown pipeline status"
      )
      { "status" => "failed", "job_id" => job_id, "reason" => "unknown pipeline status" }
    end
  rescue JSON::ParserError, KeyError => error
    save_air_sync_state(
      trigger: record&.fetch("trigger", "queued-air-sync"), status: "failed",
      job_id: record && record["job_id"], reason: error.message
    )
    { "status" => "failed", "job_id" => record && record["job_id"], "reason" => error.message }
  end

