  def tools_invoke
    tool_id = @arguments.shift
    raise RemoteWork::Error, "缺少工具 ID" unless tool_id&.match?(/\A[a-z][a-z0-9-]{0,63}\z/)
    options = { timeout: tool_id == "codex-status" ? 300 : 120, json: false }
    parser = OptionParser.new do |item|
      item.on("--timeout SECONDS", Integer) { |value| options[:timeout] = value }
      item.on("--json") { options[:json] = true }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    raise RemoteWork::Error, "等待时间必须在 5 到 600 秒之间" unless options.fetch(:timeout).between?(5, 600)

    envelope = invoke_capability(
      "tool:#{tool_id}", input: {}, timeout: options.fetch(:timeout), confirmed: false, wait: true
    )
    unless envelope["state"] == "succeeded"
      raise RemoteWork::Error, envelope.fetch("error", "本轮未能成功调用两头乌 Mini")
    end
    output = envelope.fetch("output")
    job_id = envelope.fetch("job_id")
    if tool_id == "codex-status"
      raise RemoteWork::Error, "远程工具结果 schema 不受支持" unless output["schema"] == "two-head-wu.codex-status.v1"
    end
    if options.fetch(:json)
      puts JSON.pretty_generate(output.merge("job_id" => job_id))
    elsif tool_id == "codex-status"
      print_codex_status(output)
    else
      puts JSON.pretty_generate(output)
    end
    0
  end

