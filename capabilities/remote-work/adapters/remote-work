  def health
    ensure_no_arguments!
    raise RemoteWork::Error, "客户端尚未配置" unless @config.configured?
    device = http.get("me").fetch("device")
    raise RemoteWork::Error, "客户端设备角色无效" unless %w[owner-air mac-mini-worker].include?(device.fetch("role"))
    puts "remote-work health ok"
    puts "version: #{RemoteWork::VERSION}"
    puts "scope: owner-only"
    puts "identity: owner-auto (owner-primary, owner-secondary)"
    puts "configured: yes"
    puts "role: #{device.fetch('role')}"
    0
  end

  def sync
    command = @arguments.shift
    raise RemoteWork::Error, "未知 sync 命令：#{command}" unless command == "air"
    sync_air
  end

  def client_update
    command = @arguments.shift || "status"
    case command
    when "status" then client_update_status
    when "check" then client_update_check
    when "install" then client_update_install
    when "all" then client_update_all
    when "auto" then client_update_auto
    when "channel" then client_update_channel
    when "pin" then client_update_pin
    when "unpin" then client_update_unpin
    else raise RemoteWork::Error, "未知 update 命令：#{command}"
    end
  end

  def client_update_status
    ensure_no_arguments!
    policy = update_policy
    puts JSON.pretty_generate({
      "current_release" => current_release_id,
      "channel" => policy.fetch("channel"),
      "pinned_release" => policy["pinned_release"],
      "last_success" => policy["last_success"],
      "last_checked_at" => policy["last_checked_at"],
      "air_sync" => @config.state["air_sync"],
      "on_use" => on_use_update_status.merge(
        "enabled" => true,
        "interval_seconds" => on_use_update_interval
      )
    }.compact)
    0
  end

  def client_update_check
    ensure_no_arguments!
    manifest = selected_release_manifest
    save_update_policy(update_policy.merge("last_checked_at" => Time.now.utc.iso8601))
    puts JSON.pretty_generate({
      "current_release" => current_release_id,
      "available_release" => manifest.fetch("release_id"),
      "channel" => manifest.fetch("channel"),
      "update_available" => manifest.fetch("release_id") != current_release_id,
      "signature" => "verified"
    })
    0
  end

  def client_update_install
    ensure_no_arguments!
    manifest = selected_release_manifest
    changed = manifest.fetch("release_id") != current_release_id
    installed = install_client_release(manifest)
    pipeline = changed ? run_air_sync_pipeline(trigger: "client-update", quiet: false) : nil
    installed = install_latest_after_pipeline if pipeline == :completed
    record_on_use_update(
      "last_result" => update_result_label(changed, pipeline),
      "release_id" => installed
    )
    puts "客户端版本\t#{installed}\tcurrent"
    pipeline == :failed ? 2 : 0
  end

  def client_update_all
    ensure_no_arguments!
    manifest = selected_release_manifest
    changed = manifest.fetch("release_id") != current_release_id
    installed = install_client_release(manifest)
    pipeline = changed ? run_air_sync_pipeline(trigger: "client-update", quiet: false) : nil
    installed = install_latest_after_pipeline if pipeline == :completed
    record_on_use_update(
      "last_result" => update_result_label(changed, pipeline),
      "release_id" => installed
    )
    puts "客户端版本\t#{installed}\tcurrent"
    modules_update
    sync_capability_directory!(quiet: false)
    pipeline == :failed ? 2 : 0
  end

  def client_update_auto
    ensure_no_arguments!
    return 0 unless @config.configured?

    FileUtils.mkdir_p(@config.home.to_s, mode: 0o700)
    File.open(on_use_update_lock_path.to_s, File::WRONLY | File::CREAT, 0o600) do |lock|
      File.chmod(0o600, lock.path)
      return 0 unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      return 0 unless on_use_update_due?

      attempted_at = Time.now.utc.iso8601
      record_on_use_update("last_attempt_at" => attempted_at, "last_result" => "checking")
      manifest = selected_release_manifest
      changed = manifest.fetch("release_id") != current_release_id
      installed = install_client_release(manifest)
      pipeline = changed ? run_air_sync_pipeline(trigger: "client-update", quiet: true) : nil
      installed = install_latest_after_pipeline if pipeline == :completed
      if changed && pipeline != :failed
        modules_update
        sync_capability_directory!(quiet: true)
      end
      save_update_policy(update_policy.merge("last_checked_at" => attempted_at)) unless changed
      record_on_use_update(
        "last_attempt_at" => attempted_at,
        "last_success_at" => Time.now.utc.iso8601,
        "last_result" => update_result_label(changed, pipeline),
        "release_id" => installed
      )
    rescue RemoteWork::Error, KeyError, JSON::ParserError, Errno::EACCES, Errno::ENOENT => error
      record_on_use_update(
        "last_attempt_at" => attempted_at || Time.now.utc.iso8601,
        "last_result" => "failed",
        "last_error" => error.message
      )
    ensure
      lock.flock(File::LOCK_UN) rescue nil
    end
    0
  end

  def sync_air
    ensure_no_arguments!
    first_manifest = selected_release_manifest
    first_changed = first_manifest.fetch("release_id") != current_release_id
    installed = install_client_release(first_manifest)
    puts "客户端预同步\t#{installed}\t#{first_changed ? 'updated' : 'current'}"

    pipeline = run_air_sync_pipeline(trigger: "explicit-air-sync", quiet: false)
    installed = install_latest_after_pipeline if pipeline == :completed
    modules_update
    sync_capability_directory!(quiet: false)
    record_on_use_update(
      "last_attempt_at" => Time.now.utc.iso8601,
      "last_success_at" => Time.now.utc.iso8601,
      "last_result" => "air-sync-#{pipeline}",
      "release_id" => installed
    )
    puts "客户端最终版本\t#{installed}\tcurrent"
    puts "Air 同步\t#{air_sync_label(pipeline)}"
    pipeline == :failed ? 2 : 0
  end

  def run_air_sync_pipeline(trigger:, quiet:)
    envelope = invoke_capability(
      "workflow:sync-air", input: {}, timeout: 600, confirmed: true, wait: true
    )
    job_id = envelope["job_id"]
    case envelope.fetch("state")
    when "queued", "waiting_user"
      save_air_sync_state(trigger: trigger, status: "queued", job_id: job_id, reason: envelope["fallback_reason"] || envelope["error"])
      unless quiet
        puts "Mini 流水线\t已排队\t#{job_id}"
        puts "说明\tMini 恢复后继续；Air 交互伴侣会在完成时拉取新客户端、模块和能力目录"
      end
      :queued
    when "succeeded"
      output = envelope.fetch("output")
      raise RemoteWork::Error, "Air 同步流水线返回了不受支持的结果" unless output["schema"] == "two-head-wu.air-sync.v1"
      status = output.fetch("status")
      case status
      when "completed"
        save_air_sync_state(trigger: trigger, status: "completed", job_id: job_id, catalog_version: output["catalog_version"])
        puts "Mini 流水线\t完成\t#{job_id}" unless quiet
        :completed
      when "review-required"
        pending = Array(output["pending_review"])
        save_air_sync_state(trigger: trigger, status: "review-required", job_id: job_id, pending_review: pending)
        unless quiet
          puts "Mini 流水线\t等待审核\t#{job_id}"
          pending.each { |item| puts "待审核\t#{item['skill']}\t#{item['runtime']}" }
          puts "说明\t未知组件没有被自动授权或发布"
        end
        :review_required
      else
        save_air_sync_state(trigger: trigger, status: "failed", job_id: job_id, reason: "unknown pipeline status")
        warn "Mini 流水线\t失败\t返回状态 #{status}" unless quiet
        :failed
      end
    else
      reason = envelope["error"] || envelope["fallback_reason"] || "本轮未能成功调用两头乌 Mini"
      save_air_sync_state(trigger: trigger, status: "failed", job_id: job_id, reason: reason)
      warn "Mini 流水线\t失败\t#{reason}" unless quiet
      :failed
    end
  rescue RemoteWork::Error => error
    save_air_sync_state(trigger: trigger, status: "failed", reason: error.message)
    warn "Mini 流水线\t失败\t#{error.message}" unless quiet
    :failed
  end

  def install_latest_after_pipeline
    manifest = selected_release_manifest
    install_client_release(manifest)
  end

  def save_air_sync_state(trigger:, status:, job_id: nil, reason: nil, catalog_version: nil, pending_review: nil)
    state = @config.state
    state["air_sync"] = {
      "trigger" => trigger,
      "status" => status,
      "job_id" => job_id,
      "reason" => reason.to_s[0, 1000],
      "catalog_version" => catalog_version,
      "pending_review" => pending_review,
      "updated_at" => Time.now.utc.iso8601
    }.compact
    @config.save_state(state)
  end

  def update_result_label(changed, pipeline)
    return "current" unless changed
    return "updated" unless pipeline

    "updated-pipeline-#{pipeline.to_s.tr('_', '-')}"
  end

  def air_sync_label(status)
    {
      completed: "completed",
      queued: "queued",
      review_required: "review-required",
      failed: "failed"
    }.fetch(status)
  end

  def client_update_channel
    channel = @arguments.shift
    ensure_no_arguments!
    raise RemoteWork::Error, "更新通道必须是 stable 或 dev" unless %w[stable dev].include?(channel)
    policy = update_policy.merge("channel" => channel)
    policy.delete("pinned_release")
    save_update_policy(policy)
    reset_on_use_update_schedule!
    puts "更新通道\t#{channel}"
    0
  end

  def client_update_pin
    release_id = @arguments.shift
    ensure_no_arguments!
    validate_release_id!(release_id)
    manifest = http.get("client/releases/#{release_id}/manifest")
    verify_release_manifest!(manifest)
    save_update_policy(update_policy.merge("pinned_release" => release_id))
    reset_on_use_update_schedule!
    puts "固定版本\t#{release_id}"
    0
  end

  def client_update_unpin
    ensure_no_arguments!
    policy = update_policy
    policy.delete("pinned_release")
    save_update_policy(policy)
    reset_on_use_update_schedule!
    puts "固定版本\t已取消"
    0
  end

  def selected_release_manifest
    policy = update_policy
    pinned = policy["pinned_release"]
    manifest = if pinned
                 http.get("client/releases/#{validate_release_id!(pinned)}/manifest")
               else
                 http.get("client/releases/channels/#{policy.fetch('channel')}")
               end
    verify_release_manifest!(manifest)
    manifest
  end

  def verify_release_manifest!(manifest)
    RemoteWork::ReleaseSignature.verify!(manifest, release_public_key.read)
    manifest
  end

  def install_client_release(manifest)
    release_id = manifest.fetch("release_id")
    return release_id if release_id == current_release_id

    bytes = http.get_bytes("client/releases/#{validate_release_id!(release_id)}/archive")
    raise RemoteWork::Error, "客户端更新包大小不匹配" unless bytes.bytesize == manifest.fetch("size")
    actual = Digest::SHA256.hexdigest(bytes)
    raise RemoteWork::Error, "客户端更新包哈希不匹配" unless secure_equal?(actual, manifest.fetch("sha256"))

    install_base = Pathname.new(File.join(Dir.home, ".local", "share", "two-head-wu", "remote-work"))
    releases = install_base.join("releases")
    target = releases.join(release_id)
    FileUtils.mkdir_p(releases.to_s, mode: 0o755)
    unless target.directory?
      Dir.mktmpdir(".release-", releases.to_s) do |temporary|
        stage = Pathname.new(temporary)
        archive = stage.join("release.tar.gz")
        content = stage.join("content")
        File.open(archive.to_s, "wb", 0o600) { |file| file.write(bytes) }
        RemoteWork::Archive.unpack(archive, content)
        validate_client_release!(content, manifest)
        File.rename(content.to_s, target.to_s)
      end
    end
    validate_client_release!(target, manifest)
    run_release_health!(target)
    switch_client_release!(target)
    policy = update_policy.merge(
      "last_success" => release_id,
      "last_checked_at" => Time.now.utc.iso8601,
      "previous_release" => current_release_id
    )
    save_update_policy(policy)
    release_id
  end

  def validate_client_release!(root, manifest)
    required = %w[bin/wu bin/wu-codex-status bin/two-head-wu-mcp adapters/remote-work lib/remote_work.rb VERSION RELEASE_ID share/release-signing-public.pub]
    raise RemoteWork::Error, "客户端更新包不完整" unless required.all? { |relative| root.join(relative).file? }
    raise RemoteWork::Error, "客户端更新包版本漂移" unless root.join("RELEASE_ID").read.strip == manifest.fetch("release_id")
    embedded = OpenSSL::PKey::RSA.new(root.join("share/release-signing-public.pub").read)
    trusted = OpenSSL::PKey::RSA.new(release_public_key.read)
    raise RemoteWork::Error, "客户端更新包替换了受信任公钥" unless secure_equal?(Digest::SHA256.hexdigest(embedded.to_der), Digest::SHA256.hexdigest(trusted.to_der))
    true
  rescue OpenSSL::PKey::PKeyError
    raise RemoteWork::Error, "客户端更新包公钥无效"
  end

  def run_release_health!(release)
    _stdout, _stderr, status = Open3.capture3(
      { "WU_REMOTE_SKIP_ON_USE_UPDATE" => "1" }, release.join("bin/wu").to_s, "remote", "health"
    )
    raise RemoteWork::Error, "新客户端健康检查失败，未切换版本" unless status.success?
  end

  def switch_client_release!(release)
    bin_root = Pathname.new(File.join(Dir.home, ".local", "bin"))
    FileUtils.mkdir_p(bin_root.to_s, mode: 0o755)
    links = {
      bin_root.join("wu") => release.join("bin/wu"),
      bin_root.join("wu-codex-status") => release.join("bin/wu-codex-status"),
      bin_root.join("two-head-wu-mcp") => release.join("bin/two-head-wu-mcp")
    }
    previous = {}
    links.each_key do |link|
      raise RemoteWork::Error, "更新目标已存在且不是两头乌管理的链接：#{link}" if link.exist? && !link.symlink?
      previous[link] = link.symlink? ? File.readlink(link.to_s) : nil
    end
    links.each { |link, target| atomic_symlink(target, link) }
    install_update_launch_agent(bin_root.join("wu"))
    install_companion_launch_agent(bin_root.join("wu"))
    ensure_codex_bridge!(bin_root.join("two-head-wu-mcp")) if command_available?("codex")
    _stdout, _stderr, status = Open3.capture3(
      { "WU_REMOTE_SKIP_ON_USE_UPDATE" => "1" }, release.join("bin/wu").to_s, "诊断"
    )
    raise RemoteWork::Error, "新客户端切换后诊断失败" unless status.success?
  rescue StandardError
    previous&.each do |link, target|
      target ? atomic_symlink(Pathname.new(target), link) : FileUtils.rm_f(link.to_s)
    end
    raise
  end

  def atomic_symlink(target, link)
    temporary = link.dirname.join(".#{link.basename}.#{Process.pid}.#{SecureRandom.hex(3)}")
    File.symlink(target.to_s, temporary.to_s)
    File.rename(temporary.to_s, link.to_s)
  ensure
    FileUtils.rm_f(temporary.to_s) if defined?(temporary) && temporary
  end

  def install_update_launch_agent(wu_link)
    plist = Pathname.new(File.join(Dir.home, "Library", "LaunchAgents", "com.twoheadwu.remote-update.plist"))
    log_root = @config.home
    content = <<~PLIST
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>Label</key><string>com.twoheadwu.remote-update</string>
        <key>ProgramArguments</key><array>
          <string>#{xml_escape(wu_link.to_s)}</string><string>remote</string><string>update</string><string>all</string>
        </array>
        <key>StartInterval</key><integer>21600</integer>
        <key>RunAtLoad</key><true/>
        <key>StandardOutPath</key><string>#{xml_escape(log_root.join('update.log').to_s)}</string>
        <key>StandardErrorPath</key><string>#{xml_escape(log_root.join('update-error.log').to_s)}</string>
      </dict></plist>
    PLIST
    RemoteWork::Atomic.write(plist, content, mode: 0o600)
    domain = "gui/#{Process.uid}"
    system("launchctl", "bootout", domain, plist.to_s, out: File::NULL, err: File::NULL)
    raise RemoteWork::Error, "无法启动客户端自动更新任务" unless system("launchctl", "bootstrap", domain, plist.to_s, out: File::NULL, err: File::NULL)
  rescue Errno::ENOENT
    raise RemoteWork::Error, "当前系统没有 launchctl，无法安装自动更新任务"
  end

  def update_policy
    state = @config.state
    state.fetch("client_update", {}).merge("channel" => state.dig("client_update", "channel") || "stable")
  end

  def save_update_policy(policy)
    state = @config.state
    state["client_update"] = policy
    @config.save_state(state)
  end

  def on_use_update_interval
    raw = ENV.fetch("WU_REMOTE_ON_USE_UPDATE_INTERVAL_SECONDS", ON_USE_UPDATE_INTERVAL_SECONDS.to_s)
    value = Integer(raw, 10)
    raise RemoteWork::Error, "使用时更新检查间隔无效" unless value.between?(0, 86_400)
    value
  rescue ArgumentError
    raise RemoteWork::Error, "使用时更新检查间隔无效"
  end

  def on_use_update_due?
    last_attempt = on_use_update_status["last_attempt_at"]
    return true unless last_attempt

    Time.now.utc - Time.iso8601(last_attempt) >= on_use_update_interval
  rescue ArgumentError
    true
  end

  def on_use_update_status
    return {} unless on_use_update_status_path.file?
    JSON.parse(on_use_update_status_path.read(encoding: "UTF-8")).slice(
      "last_attempt_at", "last_success_at", "last_result", "last_error", "release_id"
    )
  rescue JSON::ParserError
    {}
  end

  def record_on_use_update(values)
    status = on_use_update_status.merge(values)
    status.delete("last_error") unless values["last_result"] == "failed"
    RemoteWork::Atomic.json(on_use_update_status_path, status, mode: 0o600)
  end

  def reset_on_use_update_schedule!
    FileUtils.rm_f(on_use_update_status_path.to_s)
