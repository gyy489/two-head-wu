  def invoke
    capability_id = validate_module_id!(@arguments.shift)
    options = { input: {}, timeout: 120, confirmed: false, json: false, wait: nil }
    parser = OptionParser.new do |item|
      item.on("--input-json JSON") { |value| options[:input] = parse_capability_input(value) }
      item.on("--input-file PATH") { |value| options[:input] = parse_capability_input(Pathname.new(value).expand_path.read(encoding: "UTF-8")) }
      item.on("--timeout SECONDS", Integer) { |value| options[:timeout] = value }
      item.on("--confirm") { options[:confirmed] = true }
      item.on("--json") { options[:json] = true }
      item.on("--wait") { options[:wait] = true }
      item.on("--no-wait") { options[:wait] = false }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    raise RemoteWork::Error, "等待时间必须在 5 到 600 秒之间" unless options.fetch(:timeout).between?(5, 600)

    envelope = invoke_capability(
      capability_id,
      input: options.fetch(:input),
      timeout: options.fetch(:timeout),
      confirmed: options.fetch(:confirmed),
      wait: options[:wait]
    )
    if options.fetch(:json)
      puts JSON.pretty_generate(envelope)
    else
      print_invocation_envelope(envelope)
    end
    envelope.fetch("state") == "failed" ? 2 : 0
  rescue RemoteWork::Error => error
    request_id ||= "call-#{SecureRandom.hex(12)}"
    envelope = RemoteWork::InvocationEnvelope.failure(
      request_id: request_id,
      capability_id: capability_id || "capability:unknown",
      mini_status: "unknown",
      reason: error.message
    )
    puts JSON.pretty_generate(envelope) if options && options[:json]
    warn envelope.fetch("error") unless options && options[:json]
    2
  end

  def parse_capability_input(value)
    parsed = JSON.parse(value)
    raise RemoteWork::Error, "能力输入必须是 JSON 对象" unless parsed.is_a?(Hash)
    parsed
  rescue JSON::ParserError
    raise RemoteWork::Error, "能力输入不是有效 JSON"
  end

  def invoke_capability(capability_id, input:, timeout:, confirmed:, wait: nil)
    request_id = "call-#{SecureRandom.hex(12)}"
    directory, source, warning = load_capability_directory
    if source == "cache"
      return RemoteWork::InvocationEnvelope.failure(
        request_id: request_id, capability_id: capability_id, mini_status: "unknown",
        reason: "只有已验签缓存，无法确认 Mini 实时状态：#{warning}"
      )
    end
    view = capability_view(directory, source: source, warning: warning)
    capability = view.fetch("remote_capabilities").find { |item| item["id"] == capability_id }
    unless capability && capability["exposure"] == "callable"
      return RemoteWork::InvocationEnvelope.failure(
        request_id: request_id, capability_id: capability_id, mini_status: view.dig("mini", "status") || "unknown",
        reason: "远端能力未登记为 callable"
      )
    end
    policy = capability.fetch("invocation_policy")
    if policy == "confirm" && !confirmed
      return RemoteWork::InvocationEnvelope.failure(
        request_id: request_id, capability_id: capability_id, mini_status: view.dig("mini", "status") || "unknown",
        reason: "该能力需要所有者明确确认；确认后使用 --confirm"
      )
    end
    unless %w[auto queue confirm].include?(policy)
      return RemoteWork::InvocationEnvelope.failure(
        request_id: request_id, capability_id: capability_id, mini_status: view.dig("mini", "status") || "unknown",
        reason: "该能力只能通过专用人工入口调用"
      )
    end
    availability = capability.fetch("availability")
    unless %w[ready queueable-offline queueable-incompatible].include?(availability)
      return RemoteWork::InvocationEnvelope.failure(
        request_id: request_id, capability_id: capability_id, mini_status: view.dig("mini", "status") || "unknown",
        reason: "远端能力当前不可用：#{availability_label(availability)}"
      )
    end

    payload = {
      "schema_version" => 1,
      "request_id" => request_id,
      "source" => "owner-air",
      "kind" => capability.fetch("executor_kind", capability["kind"] == "workflow" ? "workflow" : "tool"),
      "capability_id" => capability_id,
      "replay_class" => capability.fetch("replay_class", "safe-read"),
      "requested_executor" => "mac-mini",
      "owner_confirmed" => confirmed,
      "input" => input
    }
    @active_request_id = request_id
    job = http.post("calls", payload).fetch("job")
    @active_request_id = nil
    job_id = job.fetch("id")
    mini_status = view.dig("mini", "status") || "unknown"
    if availability != "ready"
      return RemoteWork::InvocationEnvelope.queued(
        request_id: request_id, capability_id: capability_id, job_id: job_id,
        mini_status: mini_status, reason: "Mini 当前#{mini_status}，等待兼容 worker 上线"
      )
    end
    should_wait = wait.nil? ? capability.fetch("executor_kind", "tool") == "tool" : wait
    unless should_wait
      return RemoteWork::InvocationEnvelope.queued(
        request_id: request_id, capability_id: capability_id, job_id: job_id,
        mini_status: mini_status, reason: "能力已按后台方式进入 Mini 队列"
      )
    end

    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
    loop do
      job = http.get("jobs/#{job_id}").fetch("job")
      state = job.fetch("state")
      break if TERMINAL_STATES.include?(state) || state == "waiting_user"
      if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
        return RemoteWork::InvocationEnvelope.queued(
          request_id: request_id, capability_id: capability_id, job_id: job_id,
          mini_status: mini_status, reason: "等待超时，能力仍在后台运行"
        )
      end
      sleep 1
    end
    unless job.fetch("state") == "succeeded"
      reason = job.fetch("state") == "waiting_user" ? "Mini 正在等待所有者交互" : job.fetch("failure", job.fetch("state"))
      envelope = RemoteWork::InvocationEnvelope.failure(
        request_id: request_id, capability_id: capability_id, mini_status: mini_status, reason: reason
      )
      envelope["job_id"] = job_id
      envelope["state"] = job.fetch("state") == "waiting_user" ? "waiting_user" : "failed"
      return envelope
    end

    destination = fetch_result(job_id, job)
    output_path = destination.join("output.json")
    provenance_path = destination.join("provenance.json")
    raise RemoteWork::Error, "远端能力没有返回结构化结果" unless output_path.file? && provenance_path.file?
    output = JSON.parse(output_path.read(encoding: "UTF-8"))
    provenance = JSON.parse(provenance_path.read(encoding: "UTF-8"))
    valid = provenance["job_id"] == job_id && provenance["capability_id"] == capability_id &&
            provenance["actual_executor"] == "mac-mini" && provenance["remote_call_succeeded"] == true
    raise RemoteWork::Error, "远端能力来源证明无效" unless valid
    RemoteWork::InvocationEnvelope.success(
      request_id: request_id, capability_id: capability_id, job_id: job_id,
      output: output, mini_status: "online", observed_at: provenance.fetch("completed_at")
    )
  ensure
    @active_request_id = nil
  end

