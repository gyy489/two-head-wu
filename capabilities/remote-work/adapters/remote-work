  def save_active_project(job, project, manifest, mode)
    lease_id = job["project_lease_id"]
    return unless lease_id
    state = @config.state
    state["active_projects"] ||= {}
    state["active_projects"][job.fetch("id")] = {
      "root" => project.to_s,
      "project_lease_id" => lease_id,
      "mode" => mode,
      "manifest" => manifest,
      "registered_at" => Time.now.utc.iso8601,
      "last_synced_at" => Time.now.utc.iso8601,
      "state" => job.fetch("state")
    }
    @config.save_state(state)
  end

  def sync_project_binding(job_id, binding)
    raise RemoteWork::Error, "Air 项目绑定无效" unless binding.is_a?(Hash)
    root = Pathname.new(binding.fetch("root")).expand_path.cleanpath
    raise RemoteWork::Error, "Air 项目目录已不可用：#{root}" unless root.directory?
    job = http.get("jobs/#{job_id}").fetch("job")
    if TERMINAL_STATES.include?(job.fetch("state"))
      update_project_binding(job_id, binding.merge("state" => job.fetch("state")))
      return { "job_id" => job_id, "state" => job.fetch("state"), "delta_entries" => 0, "result" => "terminal" }
    end
    entries, current = RemoteWork::ProjectSnapshot.delta(root, binding.fetch("manifest", {}))
    if entries.empty?
      update_project_binding(job_id, binding.merge("state" => job.fetch("state"), "last_checked_at" => Time.now.utc.iso8601))
      return { "job_id" => job_id, "state" => job.fetch("state"), "delta_entries" => 0, "result" => "current" }
    end
    response = http.post("jobs/#{job_id}/project/deltas", {
      "schema_version" => 1,
      "project_lease_id" => binding.fetch("project_lease_id"),
      "entries" => entries
    })
    updated = binding.merge(
      "manifest" => current,
      "state" => job.fetch("state"),
      "last_synced_at" => Time.now.utc.iso8601,
      "last_delta_sequence" => response.dig("delta", "sequence")
    )
    update_project_binding(job_id, updated)
    {
      "job_id" => job_id,
      "state" => job.fetch("state"),
      "delta_entries" => entries.length,
      "delta_sequence" => response.dig("delta", "sequence"),
      "result" => "uploaded"
    }
  end

  def update_project_binding(job_id, binding)
    state = @config.state
    state["active_projects"] ||= {}
    state["active_projects"][job_id] = binding
    @config.save_state(state)
  end

