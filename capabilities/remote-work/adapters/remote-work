class RemoteWorkClient
  TERMINAL_STATES = %w[succeeded failed cancelled expired].freeze
  POLICY_MODES = %w[off metadata-only on-demand auto-update pinned].freeze
  MODULE_ID = /\A[a-z][a-z0-9-]*:[a-z][a-z0-9-]*\z/.freeze
  JOB_ID = /\Ajob-[a-z0-9-]+\z/.freeze
  INTERACTION_ID = /\Aask-[a-f0-9]{16}\z/.freeze
  REQUEST_ID = /\Acall-[a-f0-9]{24}\z/.freeze
  ARTIFACT_ID = /\Aart-[a-f0-9]{24}\z/.freeze
  ON_USE_UPDATE_INTERVAL_SECONDS = 900

  def initialize(arguments)
    @arguments = arguments.dup
    @root = Pathname.new(__dir__).join("../../..").expand_path.cleanpath
    release_candidate = Pathname.new(__dir__).join("..").expand_path.cleanpath
    @package_root = release_candidate.join("bin/wu").file? ? release_candidate : @root.join("capabilities/remote-work")
    @config = RemoteWork::Config.new
  end

  def run
    command = @arguments.shift || "help"
    case command
    when "help", "--help", "-h" then help
    when "health" then health
    when "enroll" then enroll
    when "sync" then sync
    when "abilities" then abilities
    when "invoke" then invoke
    when "bridge" then bridge
    when "companion" then companion
    when "projects" then projects
    when "modules" then modules
    when "models" then models
    when "tools" then tools
    when "devices" then devices
    when "artifacts" then artifacts
    when "policy" then policy
    when "jobs" then jobs
    when "update" then client_update
    when "diagnose" then diagnose
    else raise RemoteWork::Error, "未知 remote-work 命令：#{command}"
    end
  rescue OptionParser::ParseError => error
    warn "错误：#{error.message}"
    2
  rescue RemoteWork::Error, KeyError, JSON::ParserError, Psych::Exception, Errno::EACCES, Errno::ENOENT => error
    warn "错误：#{error.message}"
    if @active_request_id
      recovery = @active_request_kind == "artifact" ? "wu remote artifacts recover" : "wu remote jobs recover"
      warn "提交恢复 ID：#{@active_request_id}（连接恢复后运行 #{recovery} #{@active_request_id}）"
    end
    2
  end

