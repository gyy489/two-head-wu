  def jobs_reply
    job_id = validate_job_id!(@arguments.shift)
    interaction_id = validate_interaction_id!(@arguments.shift)
    options = { answers: {} }
    parser = OptionParser.new do |item|
      item.on("--decision DECISION") { |value| options[:decision] = normalize_decision(value) }
      item.on("--answer ID=TEXT") do |value|
        key, answer = value.split("=", 2)
        raise OptionParser::InvalidArgument, "--answer 必须是 ID=TEXT" unless key&.match?(/\A[A-Za-z0-9_.-]{1,128}\z/) && answer
        options[:answers][key] ||= []
        options[:answers][key] << answer
      end
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    payload = {}
    payload["decision"] = options[:decision] if options[:decision]
    payload["answers"] = options[:answers] unless options[:answers].empty?
    raise RemoteWork::Error, "请提供 --decision 或 --answer" if payload.empty?
    puts JSON.pretty_generate(http.post("jobs/#{job_id}/interactions/#{interaction_id}/reply", payload))
    0
  end

  def jobs_follow
    job_id = validate_job_id!(@arguments.shift)
    options = { timeout: 0, interval: 2 }
    parser = OptionParser.new do |item|
      item.on("--timeout SECONDS", Integer) { |value| options[:timeout] = value }
      item.on("--interval SECONDS", Integer) { |value| options[:interval] = value }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    cursor = @config.state.fetch("event_cursors", {}).fetch(job_id, 0).to_i
    loop do
      events = http.get("jobs/#{job_id}/events?after=#{cursor}").fetch("events")
      events.each do |event|
        puts [event.fetch("sequence"), event.fetch("type"), event.fetch("message", "")].join("\t")
        cursor = [cursor, event.fetch("sequence").to_i].max
      end
      save_event_cursor(job_id, cursor)
      job = http.get("jobs/#{job_id}").fetch("job")
      if TERMINAL_STATES.include?(job.fetch("state"))
        puts "state\t#{job.fetch('state')}"
        break
      end
      if job.fetch("state") == "waiting_user"
        print_pending_interactions(job_id)
        puts "state\twaiting_user"
        break
      end
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
      raise RemoteWork::Error, "等待任务超时；可稍后继续查看" if options.fetch(:timeout).positive? && elapsed >= options.fetch(:timeout)
      sleep [options.fetch(:interval), 1].max
    end
    0
  end

  def jobs_fetch
    job_id = validate_job_id!(@arguments.shift)
