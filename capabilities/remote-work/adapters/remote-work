  def fetch_result(job_id, job)
    destination = @config.paths.fetch("results").join(job_id)
    return destination if destination.exist?

    bytes = http.get_bytes("jobs/#{job_id}/result")
    actual = Digest::SHA256.hexdigest(bytes)
    raise RemoteWork::Error, "结果包哈希校验失败" unless secure_equal?(actual, job.fetch("result_sha256"))
    FileUtils.mkdir_p(@config.paths.fetch("tmp").to_s, mode: 0o700)
    Dir.mktmpdir("result-", @config.paths.fetch("tmp").to_s) do |temporary|
      archive = Pathname.new(temporary).join("result.tar.gz")
      File.open(archive.to_s, "wb", 0o600) { |file| file.write(bytes) }
      extracted = Pathname.new(temporary).join("content")
      RemoteWork::Archive.unpack(archive, extracted)
      FileUtils.mkdir_p(destination.dirname.to_s, mode: 0o700)
      FileUtils.mv(extracted.to_s, destination.to_s)
    end
    destination
  end

