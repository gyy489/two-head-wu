  def artifacts_upload
    source = @arguments.shift
    options = { media_type: "application/octet-stream", request_id: nil }
    parser = OptionParser.new do |item|
      item.on("--media-type TYPE") { |value| options[:media_type] = value }
      item.on("--request-id ID") { |value| options[:request_id] = value }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    raise RemoteWork::Error, "缺少附件路径" unless source
    path = Pathname.new(source).expand_path.cleanpath
    raise RemoteWork::Error, "附件不是普通文件" unless path.file? && !path.symlink?
    raise RemoteWork::Error, "附件超过 50 MiB" if path.size > 50 * 1024 * 1024
    request_id = options[:request_id] || "call-#{SecureRandom.hex(12)}"
    raise RemoteWork::Error, "提交请求 ID 无效" unless REQUEST_ID.match?(request_id)
    bytes = path.binread
    @active_request_id = request_id
    @active_request_kind = "artifact"
    value = http.post("artifacts", {
                        "request_id" => request_id,
                        "filename" => path.basename.to_s,
                        "media_type" => options.fetch(:media_type),
                        "sha256" => Digest::SHA256.hexdigest(bytes),
                        "content_base64" => Base64.strict_encode64(bytes)
                      })
    @active_request_id = nil
    @active_request_kind = nil
    puts JSON.pretty_generate(value)
    0
  end

