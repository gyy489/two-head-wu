  def artifacts_fetch
    artifact_id = validate_artifact_id!(@arguments.shift)
    options = { output: nil }
    parser = OptionParser.new { |item| item.on("--output PATH") { |value| options[:output] = value } }
    parser.parse!(@arguments)
    ensure_no_arguments!
    item = http.get("artifacts/#{artifact_id}").fetch("artifact")
    raise RemoteWork::Error, "附件当前不可下载：#{item.fetch('state')}" unless item.fetch("state") == "active"
    bytes = http.get_bytes("artifacts/#{artifact_id}/content")
    raise RemoteWork::Error, "附件哈希校验失败" unless secure_equal?(Digest::SHA256.hexdigest(bytes), item.fetch("sha256"))
    destination = if options[:output]
                    candidate = Pathname.new(options[:output]).expand_path.cleanpath
                    candidate.directory? ? candidate.join(item.fetch("filename")) : candidate
                  else
                    @config.paths.fetch("artifacts").join(artifact_id, item.fetch("filename"))
                  end
    FileUtils.mkdir_p(destination.dirname.to_s, mode: 0o700)
    if destination.exist?
      same = destination.file? && Digest::SHA256.file(destination.to_s).hexdigest == item.fetch("sha256")
      raise RemoteWork::Error, "目标已经存在且内容不同：#{destination}" unless same
    else
      RemoteWork::Atomic.write(destination, bytes, mode: 0o600)
    end
    puts destination
    0
  end

