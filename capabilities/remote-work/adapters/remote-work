  def release_public_key
    override = ENV["WU_REMOTE_RELEASE_PUBLIC_KEY_FILE"]
    path = if override && !override.empty?
             Pathname.new(override).expand_path
           elsif @package_root.join("share/release-signing-public.pub").file?
             @package_root.join("share/release-signing-public.pub")
           else
             @package_root.join("keys/release-signing-public.pub")
           end
    raise RemoteWork::Error, "客户端缺少受信任的发布公钥；请使用最新版一次性安装器升级" unless path.file?
    path
  end

