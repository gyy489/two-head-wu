  def jobs_submit
    divider = @arguments.index("--")
    raise RemoteWork::Error, "请在 -- 后提供任务说明" unless divider
    option_arguments = @arguments.shift(divider)
    @arguments.shift
    instruction = @arguments.join(" ").strip
    @arguments.clear
    raise RemoteWork::Error, "任务说明不能为空" if instruction.empty?
    options = { project: ".", project_mode: "workspace-write", model: nil, effort: nil, request_id: nil, artifact_ids: [] }
    parser = OptionParser.new do |item|
      item.on("--project PATH") { |value| options[:project] = value }
      item.on("--project-mode MODE") { |value| options[:project_mode] = value }
      item.on("--model MODEL") { |value| options[:model] = value }
      item.on("--effort EFFORT") { |value| options[:effort] = value }
      item.on("--request-id ID") { |value| options[:request_id] = value }
      item.on("--artifact ID") { |value| options[:artifact_ids] << validate_artifact_id!(value) }
    end
    parser.parse!(option_arguments)
    raise RemoteWork::Error, "未知任务参数" unless option_arguments.empty?

    raise RemoteWork::Error, "项目权限档位无效" unless %w[review workspace-write full-project].include?(options.fetch(:project_mode))
    project = Pathname.new(options.fetch(:project)).expand_path.cleanpath
    raise RemoteWork::Error, "项目目录不存在" unless project.directory?
    project = project.realpath
    FileUtils.mkdir_p(@config.paths.fetch("tmp").to_s, mode: 0o700)
    capsule = @config.paths.fetch("tmp").join("capsule-#{SecureRandom.hex(6)}.tar.gz")
    metadata = RemoteWork::Archive.pack_directory(project, capsule)
    request_id = options[:request_id] || "call-#{SecureRandom.hex(12)}"
    raise RemoteWork::Error, "提交请求 ID 无效" unless REQUEST_ID.match?(request_id)
    payload = {
      "request_id" => request_id,
      "instruction" => instruction,
      "identity" => "owner-auto",
      "project_name" => project.basename.to_s,
      "model" => options[:model],
      "effort" => options[:effort],
      "capsule_sha256" => metadata.fetch("sha256"),
      "capsule_size" => metadata.fetch("size"),
      "capsule_base64" => Base64.strict_encode64(capsule.binread),
      "artifact_ids" => options.fetch(:artifact_ids),
      "project_mode" => options.fetch(:project_mode),
      "project_manifest" => RemoteWork::ProjectSnapshot.manifest(project)
    }
    @active_request_id = request_id
    @active_request_kind = "job"
    result = http.post("jobs", payload)
    @active_request_id = nil
    @active_request_kind = nil
    job = result.fetch("job")
    save_active_project(job, project, payload.fetch("project_manifest"), options.fetch(:project_mode))
    puts JSON.pretty_generate(result)
    0
  ensure
    FileUtils.rm_f(capsule.to_s) if defined?(capsule) && capsule
  end

