    puts JSON.pretty_generate(prompt)
    payload = if interaction.fetch("kind") == "user-input"
                answers = {}
                Array(prompt["questions"]).each do |question|
                  print "#{question.fetch('question', question.fetch('id'))}\n> "
                  answer = STDIN.gets
                  raise RemoteWork::Error, "没有收到回答；交互保持待处理" unless answer
                  answers[question.fetch("id")] = [answer.chomp]
                end
                { "answers" => answers }
              else
                puts "选择：1 接受　2 本次会话　3 拒绝　4 取消"
                print "> "
                answer = STDIN.gets&.strip
