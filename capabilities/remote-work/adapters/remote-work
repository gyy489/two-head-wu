    job = http.get("jobs/#{job_id}").fetch("job")
    raise RemoteWork::Error, "任务尚无可接收结果：#{job.fetch('state')}" unless job["result_sha256"]
    destination = fetch_result(job_id, job)
    puts destination
    0
