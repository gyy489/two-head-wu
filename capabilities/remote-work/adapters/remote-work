  def xml_escape(value)
    value.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;").gsub('"', "&quot;").gsub("'", "&apos;")
  end

  def enroll
    options = { secret_store: nil }
    parser = OptionParser.new do |item|
      item.on("--endpoint URL") { |value| options[:endpoint] = value }
      item.on("--device NAME") { |value| options[:device] = value }
      item.on("--token-env ENV") { |value| options[:token_env] = value }
      item.on("--secret-store STORE") { |value| options[:secret_store] = value }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    endpoint = options.fetch(:endpoint) { raise RemoteWork::Error, "缺少 --endpoint" }
    device = options.fetch(:device) { raise RemoteWork::Error, "缺少 --device" }
    raise RemoteWork::Error, "设备名称无效" unless device.match?(/\A[a-z][a-z0-9-]{0,62}\z/)
    token_env = options.fetch(:token_env) { raise RemoteWork::Error, "缺少 --token-env" }
    raise RemoteWork::Error, "配对环境变量名称无效" unless token_env.match?(/\A[A-Z][A-Z0-9_]{0,63}\z/)
    token = ENV[token_env].to_s
    raise RemoteWork::Error, "配对环境变量为空" if token.empty?

    result = RemoteWork::HTTPClient.enroll(
      endpoint: endpoint,
      token: token,
      device_name: device,
      secret_store: options[:secret_store],
      config: @config
    )
    puts JSON.pretty_generate(result.merge("result" => "enrolled"))
    0
  end

  def abilities
    command = @arguments.shift || "list"
    case command
    when "list" then abilities_show(:all)
    when "local" then abilities_show(:local)
    when "remote" then abilities_show(:remote)
    when "sync"
      ensure_no_arguments!
      sync_capability_directory!(quiet: false)
      0
    else
      raise RemoteWork::Error, "未知 abilities 命令：#{command}"
    end
  end

  def abilities_show(scope)
    options = { json: false, cached: false }
    parser = OptionParser.new do |item|
      item.on("--json") { options[:json] = true }
      item.on("--cached") { options[:cached] = true }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    directory, source, warning = load_capability_directory(cached: options.fetch(:cached))
    view = capability_view(directory, source: source, warning: warning)
    view["local_capabilities"] = [] if scope == :remote
    if scope == :local
      view["remote_capabilities"] = []
      view["models"] = []
    end
    inventory_entries = Array(view.dig("mini_inventory", "entries"))
    inventory_entries = inventory_entries.select { |entry| %w[local portable].include?(entry["air_mode"]) } if scope == :local
    inventory_entries = inventory_entries.reject { |entry| entry["air_mode"] == "local" } if scope == :remote
    view["mini_inventory"] = inventory_summary(view.fetch("mini_inventory"), inventory_entries)
    options.fetch(:json) ? puts(JSON.pretty_generate(view)) : print_capability_view(view, scope)
    0
  end

  def sync_capability_directory!(quiet: false)
    directory = http.get("capabilities")
    verify_capability_directory!(directory)
    cached = directory.merge("cached_at" => Time.now.utc.iso8601)
    RemoteWork::Atomic.json(capability_cache_path, cached, mode: 0o600)
    unless quiet
      puts "能力目录\t已同步"
      puts "目录版本\t#{directory.fetch('catalog').fetch('catalog_version')}"
      puts "目录签名\tverified"
      puts "观测时间\t#{directory.fetch('observed_at')}"
    end
    [directory, "live", nil]
  end

  def load_capability_directory(cached: false)
    return [read_cached_capability_directory!, "cache", nil] if cached

    sync_capability_directory!(quiet: true)
  rescue RemoteWork::Error => error
    raise unless error.message.start_with?("无法连接两头乌控制面") && capability_cache_path.file?

    [read_cached_capability_directory!, "cache", error.message]
  end

  def read_cached_capability_directory!
    raise RemoteWork::Error, "Air 尚无可信能力目录缓存；联网后运行 wu 同步能力" unless capability_cache_path.file?

    value = JSON.parse(capability_cache_path.read(encoding: "UTF-8"))
    verify_capability_directory!(value)
    value
  rescue JSON::ParserError
    raise RemoteWork::Error, "Air 能力目录缓存无效；联网后运行 wu 同步能力"
  end

  def verify_capability_directory!(directory)
    raise RemoteWork::Error, "能力目录响应格式不受支持" unless directory.fetch("schema_version") == 1
    raise RemoteWork::Error, "控制面协议版本不兼容" unless directory.fetch("protocol_version") == RemoteWork::PROTOCOL_VERSION
    RemoteWork::CapabilityCatalogSignature.verify!(directory.fetch("catalog"), release_public_key.read)
    RemoteWork::CapabilityInventorySignature.verify!(directory.fetch("inventory"), release_public_key.read)
    RemoteWork::ModuleSignature.verify!(directory.fetch("modules"), release_public_key.read)
    runtime = directory.fetch("runtime")
    raise RemoteWork::Error, "能力目录运行状态无效" unless runtime.is_a?(Hash) && runtime["devices"].is_a?(Array) && runtime["models"].is_a?(Hash)
    raise RemoteWork::Error, "能力目录模型状态无效" unless runtime.dig("models", "models").is_a?(Array)
    Array(runtime["devices"]).select { |item| item["role"] == "mac-mini-worker" }.each do |worker|
      catalog = worker["runtime_catalog"]
      valid = catalog.is_a?(Hash) && catalog["schema_version"] == 1 && catalog["protocol_min"].is_a?(Integer) &&
              catalog["protocol_max"].is_a?(Integer) && catalog["runtimes"].is_a?(Array)
      raise RemoteWork::Error, "Mini 运行时兼容目录无效" unless valid
    end
    true
  rescue KeyError
    raise RemoteWork::Error, "能力目录响应不完整"
  end

  def capability_cache_path
    @config.home.join("capability-directory.json")
  end

  def capability_view(directory, source:, warning:)
    catalog = directory.fetch("catalog")
    modules = directory.fetch("modules")
    runtime = directory.fetch("runtime")
    worker = Array(runtime.fetch("devices")).find { |item| item["role"] == "mac-mini-worker" }
    worker_compatible = worker && worker.fetch("compatibility", "incompatible") == "compatible"
    live_worker = source == "live" && worker && worker["online"] && worker_compatible
    provided = live_worker ? Array(worker["capabilities"]) : []
    local = local_builtin_capabilities + local_module_capabilities(Array(modules.fetch("modules")))
    remote = Array(catalog.fetch("capabilities")).select { |item| item["location"] != "air" }.map do |entry|
      requirements = Array(entry["runtime_requires"])
      availability = if entry["status"] != "active"
                       "disabled"
                     elsif entry["exposure"] == "metadata-only" || entry["invocation_policy"] == "unavailable"
                       "metadata-only"
                     elsif source == "cache"
                       "unknown-cached"
                     elsif worker && worker["online"] && !worker_compatible && entry["queueable"]
                       "queueable-incompatible"
                     elsif worker && worker["online"] && !worker_compatible
                       "runtime-incompatible"
                     elsif requirements.empty?
                       "ready"
                     elsif live_worker && (requirements - provided).empty?
                       "ready"
                     elsif !live_worker && entry["queueable"]
                       "queueable-offline"
                     elsif !live_worker
                       "offline"
                     else
                       "runtime-missing"
                     end
      entry.slice(
        "id", "name", "kind", "location", "exposure", "invocation_policy", "side_effect", "queueable",
        "runtime_requires", "command", "data_location", "input_schema", "output_schema", "executor_kind",
        "adapter", "capability_version", "replay_class", "approval_policy", "summary"
      ).merge("availability" => availability)
    end
    remote_ids = remote.map { |entry| entry.fetch("id") }
    Array(modules.fetch("modules")).select { |item| item["classification"] == "remote-only" && !remote_ids.include?(item["id"]) }.each do |item|
      remote << {
        "id" => item.fetch("id"),
        "kind" => item.fetch("id").start_with?("mcp:") ? "mcp-tool" : "capability",
        "location" => "mac-mini",
        "exposure" => "metadata-only",
        "invocation_policy" => "unavailable",
        "side_effect" => "metadata-only",
        "queueable" => false,
        "runtime_requires" => [],
        "summary" => item.fetch("summary"),
        "availability" => "metadata-only"
      }
    end
    local_by_id = local.each_with_object({}) { |entry, output| output[entry.fetch("id")] = entry }
    remote_by_id = remote.each_with_object({}) { |entry, output| output[entry.fetch("id")] = entry }
    inventory_manifest = directory.fetch("inventory")
    inventory_entries = Array(inventory_manifest.fetch("entries")).map do |entry|
      route = entry["callable_via"] && remote_by_id[entry["callable_via"]]
      availability = if !%w[active experimental].include?(entry.fetch("status"))
                       "unavailable"
                     else
                       case entry.fetch("air_mode")
                       when "local" then "ready"
                       when "portable" then local_by_id.fetch(entry.fetch("id"), {}).fetch("availability", "not-installed")
                       when "remote-auto", "remote-queue", "confirm"
                         route ? route.fetch("availability") : "unavailable"
                       when "metadata-only" then "metadata-only"
                       when "unavailable" then "unavailable"
                       end
                     end
      entry.merge("availability" => availability).tap do |record|
        record["via_availability"] = route["availability"] if route
      end
    end
    models = Array(runtime.dig("models", "models")).each_with_object([]) do |model, output|
      next unless model.is_a?(Hash) && model["id"].is_a?(String)
      output << {
        "id" => model["id"],
        "display_name" => model["display_name"] || model["id"],
        "default_effort" => model["default_effort"],
        "efforts" => Array(model["efforts"]),
        "is_default" => !!model["is_default"],
        "availability" => source == "cache" ? "unknown-cached" : (live_worker ? "ready" : "offline")
      }.compact
    end
    {
      "schema_version" => 1,
      "client_version" => RemoteWork::VERSION,
      "catalog_version" => catalog.fetch("catalog_version"),
      "catalog_generated_at" => catalog.fetch("generated_at"),
      "catalog_signature" => "verified",
      "inventory_version" => inventory_manifest.fetch("inventory_version"),
      "inventory_generated_at" => inventory_manifest.fetch("generated_at"),
      "inventory_signature" => "verified",
      "directory_source" => source,
      "observed_at" => directory["observed_at"],
      "cached_at" => directory["cached_at"],
      "warning" => warning,
      "mini" => {
        "online" => source == "live" ? !!(worker && worker["online"]) : nil,
        "compatible" => source == "live" ? !!worker_compatible : nil,
        "status" => if source == "cache"
                      "unknown"
                    elsif worker && worker["online"] && !worker_compatible
                      "incompatible"
                    elsif live_worker
                      "online"
                    else
                      "offline"
                    end,
        "last_seen_at" => worker && worker["last_seen_at"],
        "runtime_version" => worker && worker["runtime_version"],
        "runtime_catalog" => worker && worker["runtime_catalog"],
        "advertised_capabilities" => source == "live" ? provided : []
      }.compact,
      "local_capabilities" => local.sort_by { |entry| entry.fetch("id") },
      "remote_capabilities" => remote.sort_by { |entry| entry.fetch("id") },
      "mini_inventory" => inventory_summary(inventory_manifest, inventory_entries),
      "models" => models.sort_by { |entry| [entry["is_default"] ? 0 : 1, entry.fetch("id")] },
      "policy_note" => "Mini 功能表用于动态发现，不等于授权；每次调用仍会重新验证执行入口、参数、设备、身份与权限。"
    }.compact
  end

