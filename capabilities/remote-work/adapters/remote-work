  def pull_module(module_id, version: nil)
    item = remote_modules.find { |entry| entry.fetch("id") == module_id }
    raise RemoteWork::Error, "模块不可见或不存在：#{module_id}" unless item
    raise RemoteWork::Error, "模块只能在 Mac mini 远程使用：#{module_id}" if item.fetch("classification") == "remote-only"
    raise RemoteWork::Error, "模块当前不可拉取：#{item.fetch('status')}" unless item.fetch("status") == "active"

    release = if version
                Array(item["versions"]).find { |entry| entry["version"] == version }
              else
                item
              end
    raise RemoteWork::Error, "模块版本不可用：#{version}" unless release
    version = release.fetch("version")
    expected = release.fetch("sha256")
    suffix = version == item["version"] ? "" : "?version=#{version}"
    bytes = http.get_bytes("modules/#{URI.encode_www_form_component(module_id)}/archive#{suffix}")
    actual = Digest::SHA256.hexdigest(bytes)
    raise RemoteWork::Error, "模块哈希校验失败" unless secure_equal?(actual, expected)

    component_root = @config.paths.fetch("components").join(module_id.tr(":", "-"), version)
    unless component_root.directory?
      Dir.mktmpdir("module-", @config.paths.fetch("tmp").tap { |path| FileUtils.mkdir_p(path.to_s) }.to_s) do |temporary|
        archive = Pathname.new(temporary).join("module.tar.gz")
        File.open(archive.to_s, "wb", 0o600) { |file| file.write(bytes) }
        extracted = Pathname.new(temporary).join("content")
        RemoteWork::Archive.unpack(archive, extracted)
        validate_module_content!(module_id, extracted)
        FileUtils.mkdir_p(component_root.dirname.to_s, mode: 0o700)
        FileUtils.mv(extracted.to_s, component_root.to_s)
      end
    end
    activate_module!(module_id, component_root)
    state = @config.state
    state.fetch("installed_modules", {})[module_id] = {
      "version" => version,
      "sha256" => expected,
      "installed_at" => Time.now.utc.iso8601,
      "path" => component_root.to_s
    }
    @config.save_state(state)
    puts "已安装 #{module_id} #{version}"
  end

  def reconcile_server_denials!(modules)
    by_id = modules.each_with_object({}) { |item, index| index[item.fetch("id")] = item }
    state = @config.state
    changed = false
    state.fetch("installed_modules", {}).each_key do |module_id|
      item = by_id[module_id]
      next unless item && item["status"] != "active"
      deactivate_module!(module_id)
      if state.fetch("module_policies", {})[module_id] != "off"
        state.fetch("module_policies", {})[module_id] = "off"
        changed = true
      end
      if state.fetch("installed_modules", {})[module_id]["server_status"] != item["status"]
        state.fetch("installed_modules", {})[module_id]["server_status"] = item["status"]
        changed = true
      end
    end
    @config.save_state(state) if changed
  end

  def deactivate_module!(module_id)
    type, name = module_id.split(":", 2)
    return unless type == "skill"
    skills_root = Pathname.new(ENV.fetch("WU_REMOTE_SKILLS_HOME", File.join(Dir.home, ".agents", "skills"))).expand_path
    target = skills_root.join(name)
    return unless target.symlink?
    existing = target.realpath rescue nil
    managed = @config.paths.fetch("components")
    managed_prefix = (managed.directory? ? managed.realpath : managed.expand_path).to_s + File::SEPARATOR
    raise RemoteWork::Error, "拒绝停用指向客户端管理范围之外的 Skill" unless existing && existing.to_s.start_with?(managed_prefix)
    FileUtils.rm_f(target.to_s)
  end

  def activate_module!(module_id, component_root)
    type, name = module_id.split(":", 2)
    return unless type == "skill"

    skills_root = Pathname.new(ENV.fetch("WU_REMOTE_SKILLS_HOME", File.join(Dir.home, ".agents", "skills"))).expand_path
    FileUtils.mkdir_p(skills_root.to_s, mode: 0o755)
    target = skills_root.join(name)
    if target.exist? || target.symlink?
      unless target.symlink?
        raise RemoteWork::Error, "Skill 目标已经存在且不归远程客户端管理：#{target}"
      end
      existing = target.realpath rescue nil
      components_root = @config.paths.fetch("components")
      managed_root = (components_root.directory? ? components_root.realpath : components_root.expand_path).to_s + File::SEPARATOR
      raise RemoteWork::Error, "Skill 链接指向客户端管理范围之外" unless existing && existing.to_s.start_with?(managed_root)
      FileUtils.rm_f(target.to_s)
    end
    temporary = skills_root.join(".#{name}.#{Process.pid}.#{SecureRandom.hex(3)}")
    File.symlink(component_root.to_s, temporary.to_s)
    File.rename(temporary.to_s, target.to_s)
  ensure
    FileUtils.rm_f(temporary.to_s) if defined?(temporary) && temporary
  end

  def validate_module_content!(module_id, root)
