  def start_job_heartbeat(job)
    job_id = job.fetch("id")
    lease_id = job.fetch("lease_id")
    @job_flags_mutex.synchronize { @job_flags[job_id] = { cancelled: false, stop: false } }
    Thread.new do
      loop do
        flags = @job_flags_mutex.synchronize { @job_flags[job_id]&.dup }
        break unless flags && !flags[:stop]
        begin
          response = http.post("worker/jobs/#{job_id}/heartbeat", { "lease_id" => lease_id })
          state = response.dig("job", "state")
          @job_flags_mutex.synchronize { @job_flags[job_id][:cancelled] = true if @job_flags[job_id] && state == "cancelled" }
          break if state == "cancelled"
        rescue RemoteWork::Error
          # A short relay outage must not kill local Codex. Lease expiry remains the server-side backstop.
          nil
        end
        sleep 20
      end
    end
  end

  def start_member_job_heartbeat(job)
    job_id = job.fetch("id")
    lease_id = job.fetch("execution_lease_id")
    @job_flags_mutex.synchronize { @job_flags[job_id] = { cancelled: false, stop: false } }
    Thread.new do
      loop do
        flags = @job_flags_mutex.synchronize { @job_flags[job_id]&.dup }
        break unless flags && !flags[:stop]
        begin
          response = http.post("worker/air-jobs/#{job_id}/heartbeat", { "execution_lease_id" => lease_id })
          state = response.dig("job", "state")
          @job_flags_mutex.synchronize { @job_flags[job_id][:cancelled] = true if @job_flags[job_id] && state == "cancelled" }
          break if state == "cancelled"
        rescue RemoteWork::Error
          nil
        end
        sleep 20
      end
    end
  end

  def stop_job_heartbeat(job_id, thread)
    @job_flags_mutex.synchronize { @job_flags[job_id][:stop] = true if @job_flags[job_id] }
    thread.join(1)
    thread.kill if thread.alive?
    @job_flags_mutex.synchronize { @job_flags.delete(job_id) }
  end

  def start_member_process_cancellation(job_id, wait_thread)
    Thread.new do
      loop do
        break unless wait_thread.alive?
        unless job_cancelled?(job_id)
          sleep 0.1
          next
        end
        begin
          Process.kill("TERM", -wait_thread.pid)
        rescue Errno::ESRCH
          break
        end
        20.times do
          break unless wait_thread.alive?
          sleep 0.1
        end
        begin
          Process.kill("KILL", -wait_thread.pid)
        rescue Errno::ESRCH
          nil
        end
        break
      end
    end
  end

  def job_cancelled?(job_id)
    @job_flags_mutex.synchronize { !!@job_flags.dig(job_id, :cancelled) }
  end

  def mark_job_cancelled(job_id)
    @job_flags_mutex.synchronize { @job_flags[job_id][:cancelled] = true if @job_flags[job_id] }
  end

  def update_state(job, state, message, failure: nil)
    job_id = job.fetch("id")
    payload = { "lease_id" => job.fetch("lease_id"), "state" => state, "message" => message }
    payload["failure"] = failure if failure
    http.post("worker/jobs/#{job_id}/state", payload)
  end

  def update_member_state(job, state, failure_code: nil)
    payload = {
      "execution_lease_id" => job.fetch("execution_lease_id"),
      "state" => state
    }
    payload["failure_code"] = failure_code if failure_code
    http.post("worker/air-jobs/#{job.fetch('id')}/state", payload)
  end

  def safe_failure(error)
    case error
    when RemoteWork::Error then error.message[0, 1000]
    else "worker internal failure: #{error.class}"
    end
  end

  def secure_equal?(first, second)
    return false unless first.bytesize == second.bytesize
    difference = 0
    first.bytes.zip(second.bytes) { |left, right| difference |= left ^ right }
    difference.zero?
  end

  def http
    @http ||= RemoteWork::HTTPClient.new(@config)
  end

  def ensure_no_arguments!
    raise RemoteWork::Error, "unexpected arguments" unless @arguments.empty?
  end
end

exit LTWWorker.new(ARGV).run if $PROGRAM_NAME == __FILE__
