  def resolve_member_identity(job)
    user_id = String(job.fetch("user_id"))
    binding_id = String(job.fetch("codex_binding_id"))
    identity_alias = String(job.fetch("identity_alias"))
    user_role = String(job.fetch("user_role"))
    unless user_id.match?(/\Ausr-[a-z0-9][a-z0-9-]{7,63}\z/) &&
           binding_id.match?(/\Acdx-[a-z0-9][a-z0-9-]{7,63}\z/) &&
           MEMBER_IDENTITY_RE.match?(identity_alias) && %w[owner member].include?(user_role) &&
           (!OWNER_IDENTITIES.include?(identity_alias) || user_role == "owner")
      raise RemoteWork::Error, "identity_required: member job has no valid fixed identity binding"
    end

    stdout, _stderr, status = Open3.capture3(
      agent_identity_adapter, "member-home", "--alias", identity_alias, "--json"
    )
    raise RemoteWork::Error, "identity_required: member Codex identity is unavailable" unless status.success?

    result = JSON.parse(stdout)
    codex_home = Pathname.new(String(result.fetch("codex_home"))).expand_path.cleanpath
    valid = result.fetch("result") == "member-home" &&
            result.fetch("identity") == identity_alias &&
            result.fetch("usage_scope") == "member-remote-work" &&
            codex_home.absolute? && codex_home.directory?
    raise RemoteWork::Error, "identity_required: member identity resolver returned invalid data" unless valid
    codex_home = @member_runtime_guard.verify_member_codex_home!(codex_home, @member_runtime) if @member_runtime

    {
      "user_id" => user_id,
      "user_role" => user_role,
      "codex_binding_id" => binding_id,
      "identity" => identity_alias,
      "codex_home" => codex_home.to_s
    }
  rescue JSON::ParserError, KeyError, TypeError, ArgumentError
    raise RemoteWork::Error, "identity_required: member identity resolver returned invalid data"
  end

  def member_codex_environment(codex_home, runtime_home)
    runtime_home = Pathname.new(runtime_home).expand_path.cleanpath
    temporary = runtime_home.join("tmp")
    environment = ENV.each_key.to_h { |key| [key, nil] }
    environment.merge(
      "PATH" => "/usr/bin:/bin:/usr/sbin:/sbin",
      "LANG" => ENV.fetch("LANG", "en_US.UTF-8"),
      "LC_ALL" => ENV["LC_ALL"],
      "HOME" => runtime_home.to_s,
      "TMPDIR" => temporary.to_s,
      "XDG_CONFIG_HOME" => runtime_home.join("config").to_s,
      "XDG_CACHE_HOME" => runtime_home.join("cache").to_s,
      "XDG_DATA_HOME" => runtime_home.join("data").to_s,
      "CODEX_HOME" => codex_home
    )
  end

  def ensure_member_runtime_isolation!(queue, executor)
    return unless queue == "air"
    return if executor == "test"
    @member_runtime_guard ||= RemoteWork::MemberRuntimeGuard.new(source_root: @root)
    @member_runtime ||= @member_runtime_guard.verify!
  end

  def with_member_temporary_directory(prefix, &block)
    unless MEMBER_TEMPORARY_PREFIXES.include?(prefix)
      raise RemoteWork::Error, "member temporary directory prefix is invalid"
    end
    root = member_temporary_root
    directory = nil
    active_lock = nil
    with_member_temporary_coordinator(root) do
      cleanup_member_task_residue_in!(root)
      directory = Pathname.new(Dir.mktmpdir(prefix, root.to_s))
      active_lock = File.open(
        directory.join(MEMBER_TEMPORARY_LOCK).to_s,
        File::RDWR | File::CREAT | File::EXCL,
        0o600
      )
      active_lock.flock(File::LOCK_EX)
    end
    block.call(directory.to_s)
  ensure
    if directory && directory.exist?
      FileUtils.remove_entry_secure(directory.to_s)
    end
    active_lock&.close
  end

  def cleanup_member_task_residue!
    root = member_temporary_root
    with_member_temporary_coordinator(root) { cleanup_member_task_residue_in!(root) }
  end

  def cleanup_member_task_residue_in!(root)
    root = Pathname.new(root).realpath
    root.children.each do |candidate|
      next unless MEMBER_TEMPORARY_PREFIXES.any? { |prefix| candidate.basename.to_s.start_with?(prefix) }
      next if candidate.symlink? || !candidate.directory?
      begin
        next unless candidate.realpath.dirname == root
        lock = File.open(candidate.join(MEMBER_TEMPORARY_LOCK).to_s, File::RDWR | File::CREAT, 0o600)
        begin
          next unless lock.flock(File::LOCK_EX | File::LOCK_NB)
          FileUtils.remove_entry_secure(candidate.to_s)
        ensure
          lock.close
        end
      rescue Errno::EACCES, Errno::ENOENT, Errno::ENOTDIR
        next
      end
    end
    true
  end

