  def run_protected_owner_notebook(input)
    stdout = stderr = status = nil
    Timeout.timeout(100) do
      stdout, stderr, status = Open3.capture3(
        { "LANG" => "en_US.UTF-8", "LC_ALL" => "en_US.UTF-8" },
        *PROTECTED_OWNER_NOTEBOOK_COMMAND,
        stdin_data: JSON.generate(input),
        unsetenv_others: true
      )
    end
    raise RemoteWork::Error, "protected owner notebook adapter is unavailable" unless status&.success?
    raise RemoteWork::Error, "protected owner notebook result is too large" if stdout.bytesize > 1024 * 1024
    JSON.parse(stdout)
  rescue JSON::ParserError
    raise RemoteWork::Error, "protected owner notebook returned invalid data"
  rescue Errno::ENOENT, Timeout::Error
    raise RemoteWork::Error, "protected owner notebook adapter is unavailable"
  end

  def materialize_member_content(job, workspace, task_root)
    lease_ids = Array(job.fetch("content_lease_ids", []))
    unless lease_ids.length <= 32 && lease_ids.uniq.length == lease_ids.length &&
           lease_ids.all? { |value| value.to_s.match?(/\Acontent-[a-z0-9][a-z0-9-]{7,63}\z/) }
      raise RemoteWork::Error, "member job content references are invalid"
    end
    execution_lease_id = job.fetch("execution_lease_id")
    metadata = lease_ids.map do |lease_id|
      value = http.get(
        "worker/air-jobs/#{job.fetch('id')}/content/#{lease_id}/metadata?execution_lease_id=#{execution_lease_id}"
      )
      validate_member_content_metadata!(job, lease_id, value)
    end
    if metadata.count { |item| item.fetch("lease").fetch("kind") == "project-capsule" } > 1
      raise RemoteWork::Error, "member job has more than one project capsule"
    end
    total = metadata.sum { |item| item.fetch("lease").fetch("size") }
    raise RemoteWork::Error, "member job content exceeds the aggregate limit" if total > 50 * 1024 * 1024

    metadata.sort_by { |item| item.fetch("lease").fetch("kind") == "project-capsule" ? 0 : 1 }.each do |item|
      lease = item.fetch("lease")
      content = item.fetch("content")
      bytes = http.get_bytes(
        "worker/air-jobs/#{job.fetch('id')}/content/#{lease.fetch('id')}?execution_lease_id=#{execution_lease_id}"
      )
      unless bytes.bytesize == lease.fetch("size") && secure_equal?(Digest::SHA256.hexdigest(bytes), lease.fetch("sha256"))
        raise RemoteWork::Error, "member job content failed Worker verification"
      end
      if lease.fetch("kind") == "project-capsule"
        archive = task_root.join("project-capsule.tar.gz")
        File.open(archive.to_s, "wb", 0o600) { |file| file.write(bytes) }
        RemoteWork::Archive.unpack(archive, workspace, maximum_bytes: 50 * 1024 * 1024)
      else
        inputs = workspace.join("inputs")
        FileUtils.mkdir_p(inputs.to_s, mode: 0o700)
        target = inputs.join("#{lease.fetch('id')}-#{content.fetch('filename')}")
        File.open(target.to_s, "wb", 0o600) { |file| file.write(bytes) }
      end
    end
    true
  end

  def validate_member_content_metadata!(job, lease_id, value)
    unless value.is_a?(Hash) && value.keys.sort == %w[content content_lease] &&
           value["content_lease"].is_a?(Hash) && value["content"].is_a?(Hash)
      raise RemoteWork::Error, "member content metadata is invalid"
    end
    lease = value.fetch("content_lease")
    content = value.fetch("content")
    lease_keys = %w[created_at expires_at id job_id kind receipt_required schema_version sha256 size state user_id]
    content_keys = %w[filename id job_id media_type schema_version sha256 size user_id]
    valid = lease.keys.sort == lease_keys && content.keys.sort == content_keys &&
            lease["schema_version"] == 2 && content["schema_version"] == 2 &&
            lease["id"] == lease_id && content["id"] == lease_id &&
            lease["job_id"] == job["id"] && content["job_id"] == job["id"] &&
            lease["user_id"] == job["user_id"] && content["user_id"] == job["user_id"] &&
            %w[project-capsule input-artifact].include?(lease["kind"]) && lease["state"] == "available" &&
            lease["receipt_required"] == false && lease["sha256"] == content["sha256"] &&
            lease["size"] == content["size"] && lease["size"].is_a?(Integer) && lease["size"].between?(1, 50 * 1024 * 1024) &&
            lease["sha256"].to_s.match?(/\A[a-f0-9]{64}\z/) &&
            content["filename"].is_a?(String) && content["filename"].bytesize.between?(1, 255) &&
            Pathname.new(content["filename"]).basename.to_s == content["filename"] &&
            !RemoteWork::Archive::DEFAULT_EXCLUDED_NAMES.include?(content["filename"]) &&
            !RemoteWork::Archive.credential_shaped?(content["filename"]) &&
            content["media_type"].to_s.match?(/\A[A-Za-z0-9][A-Za-z0-9!#$&^_.+\-\/]{0,126}\z/)
    raise RemoteWork::Error, "member content metadata is invalid" unless valid
    if lease["kind"] == "project-capsule" && !content["filename"].downcase.end_with?(".tar.gz")
      raise RemoteWork::Error, "member project capsule metadata is invalid"
    end
    { "lease" => lease, "content" => content }
  end

  def project_member_codex_status(identity, record)
    unless identity.is_a?(String) && record.is_a?(Hash) && record["identity"] == identity
      raise RemoteWork::Error, "member Codex status identity mismatch"
    end
    status = record["status"]
    raise RemoteWork::Error, "member Codex status is invalid" unless %w[ok not-logged-in error].include?(status)
    account = record["account"]
    safe_account = account.is_a?(Hash) ? {
      "email" => account["email"].to_s[0, 320],
      "plan_type" => account["plan_type"].to_s[0, 64]
    } : nil
    safe_limits = Array(record["rate_limits"]).first(16).each_with_object([]) do |bucket, values|
      next unless bucket.is_a?(Hash)
      values << {
        "limit_id" => bucket["limit_id"].to_s[0, 128],
        "limit_name" => bucket["limit_name"].to_s[0, 128],
        "plan_type" => bucket["plan_type"].to_s[0, 64],
        "primary" => project_member_rate_window(bucket["primary"]),
        "secondary" => project_member_rate_window(bucket["secondary"]),
        "spend_control_reached" => bucket["spend_control_reached"] == true,
        "rate_limit_reached_type" => bucket["rate_limit_reached_type"].to_s[0, 64]
      }
    end
    safe_record = {
      "identity" => identity,
      "status" => status,
      "account" => safe_account,
      "primary" => project_member_rate_window(record["primary"]),
      "five_hour" => project_member_rate_window(record["five_hour"]),
      "weekly" => project_member_rate_window(record["weekly"]),
      "rate_limits" => safe_limits,
      "error" => status == "error" ? "quota query failed" : nil
    }
    {
      "schema" => "two-head-wu.codex-status.v1",
      "source_device" => "mac-mini-worker",
      "observed_at" => Time.now.utc.iso8601,
      "accounts" => [safe_record]
    }
  end

  def project_member_rate_window(window)
    return nil unless window.is_a?(Hash)
    {
      "remaining_percent" => window["remaining_percent"],
      "used_percent" => window["used_percent"],
      "window_duration_mins" => window["window_duration_mins"],
      "resets_at" => window["resets_at"],
      "resets_at_iso" => window["resets_at_iso"]
    }
  end

  def validate_member_capability_output!(output, expected_schema)
    unless output.is_a?(Hash) && output["schema"] == expected_schema
      raise RemoteWork::Error, "member capability returned an invalid output schema"
    end
    forbidden_keys = %w[
      auth cookie credential database_path file_path local_path password private_key
      secret source_path ssh_key storage_path token
    ]
    inspect_value = lambda do |value|
      case value
      when Hash
        value.each do |key, child|
          raise RemoteWork::Error, "member capability output contains a private field" if forbidden_keys.include?(key.to_s.downcase)
          inspect_value.call(child)
        end
      when Array
        value.each { |child| inspect_value.call(child) }
      when String
        if value.include?("CANARY_DO_NOT_EXPORT_") || value.include?(@root.dirname.to_s) || value.start_with?("/Users/", "/Volumes/")
          raise RemoteWork::Error, "member capability output contains a private path or secret canary"
        end
      end
    end
    inspect_value.call(output)
    true
  end

  def run_member_codex_executor(job, resolved, workspace, runtime_home, result_dir, events, frozen_envelope)
    initialize_baseline_git(workspace)
    final_path = result_dir.join("final.md")
    command = member_sandbox_command(
      member_codex_command(workspace, final_path), workspace, runtime_home, resolved.fetch("codex_home")
    )
    status = nil
    Open3.popen3(
      member_codex_environment(resolved.fetch("codex_home"), runtime_home), *command, pgroup: true
    ) do |stdin, stdout, stderr, wait|
      cancellation = start_member_process_cancellation(job.fetch("id"), wait)
      stderr_reader = Thread.new { stderr.read }
      stdin.write(member_worker_prompt(job, frozen_envelope))
      stdin.close
      stdout.each_line do |line|
        event = sanitize_codex_event(line)
        events << event if event
      end
      stderr_reader.value
      status = wait.value
    ensure
      cancellation&.kill
      cancellation&.join
    end
    raise RemoteWork::Error, "member remote job was cancelled" if job_cancelled?(job.fetch("id"))
    raise RemoteWork::Error, "member Codex process failed" unless status&.success?
    final_text = final_path.file? ? final_path.read(encoding: "UTF-8") : nil
    write_final_result(final_path, final_text, workspace)
    validate_member_workspace_outputs!(workspace)
    write_changes_patch(result_dir, workspace)
    result_dir.join("tests.json").write(JSON.pretty_generate({ "ok" => true, "executor" => "codex", "exit_status" => status.exitstatus }) + "\n", encoding: "UTF-8")
  end

  def run_member_app_server_executor(job, resolved, workspace, runtime_home, result_dir, events, frozen_envelope)
    initialize_baseline_git(workspace)
    completed = false
    turn_status = nil
    turn_failure_code = nil
    final_text = nil
    notification_handler = proc do |method, params|
      if method == "turn/completed"
        completed = true
        turn_status = params.dig("turn", "status")
        turn_failure_code = codex_turn_failure_code(params.dig("turn", "error"))
      end
      item = params["item"] if method == "item/completed"
      final_text = item["text"] if item.is_a?(Hash) && item["type"] == "agentMessage"
      event = sanitize_app_server_notification(method, params)
      events << event if event
    end
    request_handler = proc do |method, _params|
      raise RemoteWork::Error, "member interaction relay is not available for #{method}"
    end
    RemoteWork::AppServerBridge.new(
      command: member_sandbox_command(
        member_app_server_command, workspace, runtime_home, resolved.fetch("codex_home")
      ),
      environment: member_codex_environment(resolved.fetch("codex_home"), runtime_home),
      notification_handler: notification_handler,
      request_handler: request_handler
    ).with_session do |session|
      thread = session.request(
        "thread/start", member_thread_start_params(workspace, frozen_envelope)
      ).fetch("thread")
      turn = session.request("turn/start", {
                               "threadId" => thread.fetch("id"),
                               "input" => [{ "type" => "text", "text" => member_worker_prompt(job, frozen_envelope) }]
                             }).fetch("turn")
      interrupted = false
      session.pump_until do
        if job_cancelled?(job.fetch("id")) && !interrupted
          session.request("turn/interrupt", { "threadId" => thread.fetch("id"), "turnId" => turn.fetch("id") })
          interrupted = true
        end
        completed
      end
    end
    raise RemoteWork::Error, "member remote job was cancelled" if job_cancelled?(job.fetch("id"))
    unless turn_status == "completed"
      detail = turn_failure_code ? " (#{turn_failure_code})" : ""
      raise RemoteWork::Error, "member Codex turn did not complete successfully: #{turn_status || 'unknown'}#{detail}"
    end
    write_final_result(result_dir.join("final.md"), final_text, workspace)
    validate_member_workspace_outputs!(workspace)
    write_changes_patch(result_dir, workspace)
    result_dir.join("tests.json").write(JSON.pretty_generate({
      "ok" => true, "executor" => "app-server", "turn_status" => turn_status
    }) + "\n", encoding: "UTF-8")
  end

  def execute_capability_job(job, executor)
