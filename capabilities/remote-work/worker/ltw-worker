  def materialize_job_artifacts(job, workspace)
    artifacts = Array(job["input_artifacts"])
    return if artifacts.empty?

    root = workspace.join(".two-head-wu-inputs")
    raise RemoteWork::Error, "project already contains the reserved artifact directory" if root.exist?
    FileUtils.mkdir_p(root.to_s, mode: 0o700)
    manifest = []
    artifacts.each do |item|
      artifact_id = item.fetch("id")
      filename = item.fetch("filename").to_s
      unless artifact_id.match?(/\Aart-[a-f0-9]{24}\z/) && Pathname.new(filename).basename.to_s == filename
        raise RemoteWork::Error, "server returned invalid artifact metadata"
      end
      bytes = http.get_bytes("worker/jobs/#{job.fetch('id')}/artifacts/#{artifact_id}?lease_id=#{job.fetch('lease_id')}")
      digest = Digest::SHA256.hexdigest(bytes)
      raise RemoteWork::Error, "input artifact hash mismatch" unless secure_equal?(digest, item.fetch("sha256"))
      raise RemoteWork::Error, "input artifact size mismatch" unless bytes.bytesize == item.fetch("size")
      directory = root.join(artifact_id)
      FileUtils.mkdir_p(directory.to_s, mode: 0o700)
      RemoteWork::Atomic.write(directory.join(filename), bytes, mode: 0o600)
      manifest << item.slice("id", "filename", "media_type", "sha256", "size")
    end
    RemoteWork::Atomic.json(root.join("manifest.json"), { "schema_version" => 1, "artifacts" => manifest }, mode: 0o600)
  end

  def publish_output_artifact(job, export)
    path = export.path
    raise RemoteWork::Error, "research artifact is unavailable" unless path.is_a?(Pathname) && path.absolute?
    maximum = RemoteWork::OwnerCapabilityAdapters::MAX_ARTIFACT_BYTES
    bytes = File.open(path.to_s, File::RDONLY | File::NOFOLLOW) do |file|
      stat = file.stat
      raise RemoteWork::Error, "research artifact is unavailable" unless stat.file?
      raise RemoteWork::Error, "research artifact exceeds the 50 MiB relay limit" if stat.size > maximum
      file.binmode
      file.read
    end
    raise RemoteWork::Error, "research artifact is empty" if bytes.empty?
    raise RemoteWork::Error, "research artifact exceeds the 50 MiB relay limit" if bytes.bytesize > maximum
    digest = Digest::SHA256.hexdigest(bytes)
    expected = export.payload.dig("document", "sha256").to_s
    raise RemoteWork::Error, "research artifact hash mismatch" unless secure_equal?(digest, expected)
    request_id = "call-#{Digest::SHA256.hexdigest("#{job.fetch('id')}\0#{digest}")[0, 24]}"
    response = http.post("worker/jobs/#{job.fetch('id')}/artifacts", {
                           "lease_id" => job.fetch("lease_id"),
                           "request_id" => request_id,
                           "filename" => export.filename,
                           "media_type" => export.media_type,
                           "sha256" => digest,
                           "content_base64" => Base64.strict_encode64(bytes)
                         })
    response.fetch("artifact")
  rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
    raise RemoteWork::Error, "research artifact is unavailable"
  end

  def start_project_sync(job, workspace)
    return nil unless job["project_lease_id"]

    Thread.new do
      loop do
        flags = @job_flags_mutex.synchronize { @job_flags[job.fetch("id")]&.dup }
        break unless flags && !flags[:stop]
        begin
          sync_project_deltas_once(job, workspace)
        rescue RemoteWork::Error => error
          upload_event(job, event_record("project.delta.error", error.message[0, 500]))
        end
        sleep 2
      end
    end
  end

  def stop_project_sync(thread)
    return unless thread
    thread.join(1)
    thread.kill if thread.alive?
  end

  def sync_project_deltas_once(job, workspace)
    project_lease_id = job["project_lease_id"]
    return 0 unless project_lease_id

    @project_delta_cursors ||= {}
    after = @project_delta_cursors.fetch(job.fetch("id"), 0)
    value = http.get(
      "worker/jobs/#{job.fetch('id')}/project/deltas?lease_id=#{job.fetch('lease_id')}&after=#{after}"
    )
    raise RemoteWork::Error, "project lease identity drift" unless value["project_lease_id"] == project_lease_id
    Array(value["deltas"]).sort_by { |delta| delta.fetch("sequence").to_i }.each do |delta|
      apply_project_delta(job, workspace, delta)
      @project_delta_cursors[job.fetch("id")] = delta.fetch("sequence").to_i
    end
    @project_delta_cursors.fetch(job.fetch("id"), after)
  end

  def apply_project_delta(job, workspace, delta)
    Array(delta.fetch("entries")).each do |entry|
      relative = entry.fetch("path").to_s
      parts = Pathname.new(relative).each_filename.to_a
      forbidden = parts.any? { |part| part == ".git" || RemoteWork::ProjectSnapshot.excluded?(part) }
      raise RemoteWork::Error, "project delta contains a forbidden path" if forbidden
      target = RemoteWork::ProjectSnapshot.safe_path(workspace, relative)
      raise RemoteWork::Error, "project delta target is a symlink" if target.symlink?
      current = target.file? ? Digest::SHA256.file(target.to_s).hexdigest : nil
      expected = entry["base_sha256"]
      unless current == expected
        upload_event(job, event_record(
          "project.delta.conflict",
          "项目增量冲突：#{relative} 的 Mini 基础版本已变化"
        ))
        next
      end
      case entry.fetch("operation")
      when "delete"
        FileUtils.rm_f(target.to_s) if target.file?
      when "upsert"
        begin
          bytes = Base64.strict_decode64(entry.fetch("content_base64"))
        rescue ArgumentError
          raise RemoteWork::Error, "project delta encoding is invalid"
        end
        raise RemoteWork::Error, "project delta hash mismatch" unless secure_equal?(Digest::SHA256.hexdigest(bytes), entry.fetch("sha256"))
        RemoteWork::Atomic.write(target, bytes, mode: 0o600)
      else
        raise RemoteWork::Error, "project delta operation is unsupported"
      end
    end
    upload_event(job, event_record("project.delta.applied", "Mini 已应用 Air 项目增量 #{delta.fetch('sequence')}"))
  end

  def write_changed_files_archive(result_dir, workspace)
    return unless workspace.join(".git").directory?

    changed_output, _stderr, changed_status = isolated_git_capture(
      workspace, "diff", "--name-only", "--diff-filter=ACMRTUXB", "-z", "HEAD", "--"
    )
    deleted_output, _stderr, deleted_status = isolated_git_capture(
      workspace, "diff", "--name-only", "--diff-filter=D", "-z", "HEAD", "--"
    )
    raise RemoteWork::Error, "cannot enumerate changed result files" unless changed_status.success? && deleted_status.success?
    changed = changed_output.split("\0").reject(&:empty?).uniq.sort
    deleted = deleted_output.split("\0").reject(&:empty?).uniq.sort
    return if changed.empty? && deleted.empty?

    maximum = 32 * 1024 * 1024
    included = []
    omitted = []
    total = 0
    Dir.mktmpdir("changed-files-") do |temporary|
      stage = Pathname.new(temporary).join("files")
      FileUtils.mkdir_p(stage.to_s, mode: 0o700)
      changed.each do |relative|
        source = workspace.join(relative).cleanpath
        prefix = workspace.expand_path.to_s + File::SEPARATOR
        unless source.expand_path.to_s.start_with?(prefix) && source.file? && !source.symlink?
          omitted << { "path" => relative, "reason" => "not-a-regular-file" }
          next
        end
        basename = source.basename.to_s
        if RemoteWork::Archive.credential_shaped?(basename) ||
           RemoteWork::Archive::DEFAULT_EXCLUDED_SUFFIXES.any? { |suffix| basename.end_with?(suffix) }
          omitted << { "path" => relative, "reason" => "credential-shaped" }
          next
        end
        if total + source.size > maximum
          omitted << { "path" => relative, "reason" => "result-file-budget" }
          next
        end
        reject_member_result_bytes!(source.binread, "changed file #{relative}") if @active_member_envelope_digest
        target = stage.join(relative)
        FileUtils.mkdir_p(target.dirname.to_s, mode: 0o700)
        FileUtils.cp(source.to_s, target.to_s, preserve: true)
        total += source.size
        included << { "path" => relative, "size" => source.size, "sha256" => Digest::SHA256.file(source.to_s).hexdigest }
      end
      RemoteWork::Archive.pack_directory(stage, result_dir.join("changed-files.tar.gz"), maximum_bytes: maximum) unless included.empty?
    end
    RemoteWork::Atomic.json(
      result_dir.join("changed-files.json"),
      { "schema_version" => 1, "included" => included, "deleted" => deleted, "omitted" => omitted },
      mode: 0o600
    )
  end

  def validate_member_workspace_outputs!(workspace)
    _stdout, _stderr, add_status = isolated_git_capture(workspace, "add", "-N", ".")
    changed_output, _stderr, status = isolated_git_capture(
      workspace, "diff", "--name-only", "--diff-filter=ACMRTUXB", "-z", "HEAD", "--"
    )
    raise RemoteWork::Error, "cannot inspect member workspace outputs" unless add_status.success? && status.success?
    total = 0
    changed_output.split("\0").reject(&:empty?).uniq.each do |relative|
      path = workspace.join(relative).cleanpath
      prefix = workspace.expand_path.to_s + File::SEPARATOR
      unless path.expand_path.to_s.start_with?(prefix) && path.file? && !path.symlink?
        raise RemoteWork::Error, "member workspace output is not a regular task file"
      end
      credential_path = path.each_filename.any? do |part|
        RemoteWork::Archive::DEFAULT_EXCLUDED_NAMES.include?(part) || RemoteWork::Archive.credential_shaped?(part)
      end ||
                        RemoteWork::Archive::DEFAULT_EXCLUDED_SUFFIXES.any? { |suffix| path.basename.to_s.end_with?(suffix) }
      raise RemoteWork::Error, "member workspace output is credential-shaped" if credential_path
      total += path.size
      raise RemoteWork::Error, "member workspace output exceeds the scan budget" if total > 32 * 1024 * 1024
      reject_member_result_bytes!(path.binread, "workspace file #{relative}")
    end
    true
  end

  def validate_member_result_tree!(result_dir)
    total = 0
    Find.find(result_dir.to_s) do |raw|
      path = Pathname.new(raw)
      next if path.directory?
      raise RemoteWork::Error, "member result contains a symbolic link" if path.symlink?
      raise RemoteWork::Error, "member result contains a non-regular file" unless path.file?
      total += path.size
      raise RemoteWork::Error, "member result exceeds the DLP scan budget" if total > 64 * 1024 * 1024
      reject_member_result_bytes!(path.binread, path.relative_path_from(result_dir).to_s)
    end
    true
  end

  def reject_member_result_bytes!(bytes, label)
    text = bytes.to_s.dup.force_encoding("UTF-8").scrub
    private_roots = [@root.dirname.to_s, ENV["HOME"].to_s].reject(&:empty?).uniq
    detected = private_roots.any? { |root| text.include?(root) } ||
               MEMBER_RESULT_SECRET_PATTERNS.any? { |pattern| pattern.match?(text) }
    raise RemoteWork::Error, "member result DLP rejected #{label}" if detected
    true
  end

  def write_final_result(final_path, final_text, workspace)
    body = if final_text.to_s.empty?
             "# 两头乌远程任务结果\n\nCodex 没有返回最终说明。\n"
           else
             sanitize_final_text(final_text, workspace)
           end
    body += "\n" unless body.end_with?("\n")
    final_path.write(body, encoding: "UTF-8")
  end

  def sanitize_final_text(value, workspace)
    workspace_root = workspace.realpath
    value.to_s.gsub(/\[([^\]\n]+)\]\((\/[^)\n]+)\)/) do |original|
      relative = workspace_relative_path(Regexp.last_match(2), workspace_root)
      relative ? "`#{relative}`" : original
    end
  end

  def workspace_relative_path(value, workspace_root)
    candidate = Pathname.new(value).realpath
    relative = candidate.relative_path_from(workspace_root).to_s
    return nil if relative == "." || relative == ".." || relative.start_with?("../")

    relative
  rescue ArgumentError, Errno::EACCES, Errno::ENOENT
    nil
  end

