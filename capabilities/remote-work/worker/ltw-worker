  def run_loop
    options = parse_executor_options!(allow_interval: true)
    queue = options.fetch(:queue)
    ensure_member_runtime_isolation!(queue, options.fetch(:executor))
    cleanup_member_task_residue! if queue == "air"
    last_model_sync = nil
    last_presence_sync = nil
    loop do
      begin
        now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
        if queue == "legacy-owner" && (last_model_sync.nil? || now - last_model_sync >= 21_600)
          publish_models
          last_model_sync = now
        end
        if queue == "legacy-owner" && (last_presence_sync.nil? || now - last_presence_sync >= 60)
          publish_presence
          last_presence_sync = now
        end
        if queue == "legacy-owner"
          value = http.get("worker/jobs/lease")
          if value["job"]
            execute_job(value.fetch("job"), value["capsule_base64"], options.fetch(:executor))
          else
            sleep options.fetch(:interval)
          end
        else
          value = http.get("worker/air-jobs/lease")
          if value["job"]
            execute_member_job(value.fetch("job"), options.fetch(:executor))
          else
            sleep options.fetch(:interval)
          end
        end
      rescue RemoteWork::Error, JSON::ParserError, KeyError, Errno::EACCES, Errno::ENOENT => error
        warn "worker retry: #{safe_failure(error)}"
        sleep [options.fetch(:interval) * 2, 60].min
      end
    end
  end

  def parse_executor_options!(allow_interval: false)
    options = {
      executor: ENV["WU_REMOTE_EXECUTOR"],
      queue: ENV.fetch("WU_REMOTE_QUEUE", "air"),
      interval: 5
    }
    parser = OptionParser.new do |item|
      item.on("--executor NAME") { |value| options[:executor] = value }
      item.on("--queue NAME") { |value| options[:queue] = value }
      item.on("--interval SECONDS", Integer) { |value| options[:interval] = value } if allow_interval
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    options[:queue] = "air" if options[:queue] == "member"
    options[:queue] = "legacy-owner" if options[:queue] == "owner"
    options[:executor] ||= options.fetch(:queue) == "air" ? "codex" : "app-server"
    raise RemoteWork::Error, "executor must be test, app-server, or codex" unless %w[test app-server codex].include?(options.fetch(:executor))
    raise RemoteWork::Error, "queue must be air or legacy-owner" unless %w[air legacy-owner].include?(options.fetch(:queue))
    raise RemoteWork::Error, "interval must be between 1 and 60" unless options.fetch(:interval).between?(1, 60)
    options
  end

  def execute_job(job, encoded_capsule, executor)
    return execute_capability_job(job, executor) if %w[tool capability].include?(job.fetch("kind", "codex"))

    job_id = job.fetch("id")
    update_state(job, "running", "Mac mini 开始执行任务")
    heartbeat = start_job_heartbeat(job)
    Dir.mktmpdir("ltw-job-") do |temporary|
      root = Pathname.new(temporary)
      capsule = root.join("capsule.tar.gz")
      begin
        data = Base64.strict_decode64(encoded_capsule)
      rescue ArgumentError
        raise RemoteWork::Error, "server returned an invalid capsule"
      end
      digest = Digest::SHA256.hexdigest(data)
      raise RemoteWork::Error, "leased capsule hash mismatch" unless secure_equal?(digest, job.fetch("capsule_sha256"))
      File.open(capsule.to_s, "wb", 0o600) { |file| file.write(data) }
      workspace = root.join("workspace")
      RemoteWork::Archive.unpack(capsule, workspace)
      materialize_job_artifacts(job, workspace)
      sync_project_deltas_once(job, workspace)
      project_sync = start_project_sync(job, workspace)
      result_dir = root.join("result")
      FileUtils.mkdir_p(result_dir.to_s, mode: 0o700)
      events = []
      if executor == "test"
        run_test_executor(job, workspace, result_dir, events)
      elsif executor == "app-server"
        run_app_server_executor(job, workspace, result_dir, events)
      else
        run_codex_executor(job, workspace, result_dir, events)
      end
      write_changed_files_archive(result_dir, workspace)
      write_result_metadata(job, result_dir, events, executor)
      archive = root.join("result.tar.gz")
      metadata = RemoteWork::Archive.pack_directory(result_dir, archive)
      http.post("worker/jobs/#{job_id}/result", {
                  "lease_id" => job.fetch("lease_id"),
                  "result_sha256" => metadata.fetch("sha256"),
                  "result_base64" => Base64.strict_encode64(archive.binread)
                })
      puts "completed #{job_id}"
      stop_project_sync(project_sync)
    end
  rescue StandardError => error
    if job_cancelled?(job.fetch("id"))
      puts "cancelled #{job.fetch('id')}"
      return
    end
    begin
      update_state(job, "failed", "任务执行失败", failure: safe_failure(error))
    rescue StandardError
      nil
    end
    raise
  ensure
    stop_project_sync(project_sync) if defined?(project_sync) && project_sync
    stop_job_heartbeat(job.fetch("id"), heartbeat) if defined?(heartbeat) && heartbeat
  end

  def freeze_member_envelope!(job)
    envelope = job["capability_envelope"]
    expected_keys = %w[capabilities egress_profile result_mode schema_version secret_access]
    unless envelope.is_a?(Hash) && envelope.keys.map(&:to_s).sort == expected_keys && envelope["schema_version"] == 2
      raise RemoteWork::Error, "member capability envelope is invalid"
    end
    capabilities = envelope["capabilities"]
    unless capabilities.is_a?(Array) && capabilities.length.between?(1, 64) &&
           capabilities.uniq.length == capabilities.length &&
           capabilities.all? { |value| value.is_a?(String) && MEMBER_CAPABILITY_RE.match?(value) }
      raise RemoteWork::Error, "member capability envelope is invalid"
    end
    if job.fetch("kind", "codex") == "capability"
      unless capabilities == [job["capability_id"]]
        raise RemoteWork::Error, "member capability envelope does not match the adapter"
      end
    elsif !capabilities.include?("codex:project-task")
      raise RemoteWork::Error, "member Codex envelope has no project-task capability"
    end
    unless %w[none registered-only].include?(envelope["egress_profile"]) &&
           envelope["secret_access"] == "none" && envelope["result_mode"] == "review-only"
      raise RemoteWork::Error, "member capability envelope violates the Mini safety profile"
    end
    canonical = JSON.generate(
      "schema_version" => 2,
      "capabilities" => capabilities,
      "egress_profile" => envelope["egress_profile"],
      "secret_access" => "none",
      "result_mode" => "review-only"
    )
    value = JSON.parse(canonical)
    deep_freeze = lambda do |item|
      item.each { |key, child| key.freeze; deep_freeze.call(child) } if item.is_a?(Hash)
      item.each { |child| deep_freeze.call(child) } if item.is_a?(Array)
      item.freeze
    end
    deep_freeze.call(value)
    { "value" => value, "sha256" => Digest::SHA256.hexdigest(canonical) }.freeze
  end

  def execute_member_job(job, executor)
    frozen_envelope = freeze_member_envelope!(job)
    return execute_member_capability_job(job, executor, frozen_envelope) if job.fetch("kind", "codex") == "capability"

    job_id = job.fetch("id")
    @active_member_envelope_digest = frozen_envelope.fetch("sha256")
    resolved = resolve_member_identity(job)
    @active_job_identity = resolved.fetch("identity")
    update_member_state(job, "running")
    heartbeat = start_member_job_heartbeat(job)
    with_member_temporary_directory("ltw-member-job-") do |temporary|
      root = Pathname.new(temporary)
      workspace = root.join("workspace")
      result_dir = root.join("result")
      runtime_home = root.join("runtime-home")
      FileUtils.mkdir_p(workspace.to_s, mode: 0o700)
