  def sanitize_codex_event(line)
    value = JSON.parse(line)
    type = value["type"].to_s
    return nil if type.empty? || type.include?("reasoning") || type.include?("thought")
    message = case type
              when /agent_message/
                value["message"].to_s
              when /error/
                "Codex 报告了一个执行错误"
              else
                type
              end
    event_record("codex.#{type.gsub(/[^a-zA-Z0-9_.-]/, '-')}", message[0, 2000])
  rescue JSON::ParserError
    nil
  end

