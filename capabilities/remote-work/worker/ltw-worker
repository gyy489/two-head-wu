  def initialize(arguments)
    @arguments = arguments.dup
    @root = Pathname.new(__dir__).join("../../..").expand_path.cleanpath
    worker_home = ENV["WU_REMOTE_WORKER_HOME"]
    @config = RemoteWork::Config.new(worker_home)
    source_root = ENV.fetch("TWO_HEAD_WU_SOURCE_ROOT", @root.to_s)
    pipeline_root = ENV.fetch("TWO_HEAD_WU_PIPELINE_ROOT", source_root)
    @owner_capabilities = RemoteWork::OwnerCapabilityAdapters.new(
      runtime_root: @root,
      source_root: source_root,
      pipeline_root: pipeline_root,
      identity_adapter: @root.join("capabilities/agent-identity/adapters/agent-identity"),
      version: RemoteWork::VERSION
    )
    @job_flags = {}
    @job_flags_mutex = Mutex.new
  end

  def run
    command = @arguments.shift || "help"
    case command
    when "help", "--help", "-h" then help
    when "health" then health
    when "air-health", "member-health" then air_health
    when "sync-models" then sync_models
    when "once" then once
    when "run" then run_loop
    else raise RemoteWork::Error, "unknown worker command: #{command}"
    end
  rescue OptionParser::ParseError => error
    warn "Error: #{error.message}"
    2
  rescue RemoteWork::Error, JSON::ParserError, KeyError, Errno::EACCES, Errno::ENOENT => error
    warn "Error: #{error.message}"
    2
  end

  private

  def help
    puts <<~HELP
      Usage: ltw-worker COMMAND [OPTIONS]

      Commands:
        health
        air-health
        sync-models
        once [--queue legacy-owner|air] [--executor test|app-server|codex]
        run  [--queue legacy-owner|air] [--executor test|app-server|codex] [--interval SECONDS]

      The production v2 queue is air and serves every hardware-bound Air user through fixed identity bindings.
      legacy-owner exists only during v1 migration and must be disabled after the owner Air moves to v2.
    HELP
    0
  end

  def health
    ensure_no_arguments!
    raise RemoteWork::Error, "worker is not configured" unless @config.configured?
    response = http.get("me")
    device = response.fetch("device")
    raise RemoteWork::Error, "configured device is not a Mac mini worker" unless device.fetch("role") == "mac-mini-worker"
    puts "ltw-worker health ok"
    puts "device: #{device.fetch('id')}"
    puts "role: mac-mini-worker"
    puts "identity: owner-auto (owner-primary, owner-secondary)"
    0
  end

  def air_health
    ensure_no_arguments!
    raise RemoteWork::Error, "worker is not configured" unless @config.configured?
    response = http.get("me")
    device = response.fetch("device")
    unless device.fetch("role") == "mac-mini-air-worker"
      raise RemoteWork::Error, "configured device is not the unified low-privilege Air worker"
    end
    @member_runtime_guard ||= RemoteWork::MemberRuntimeGuard.new(source_root: @root)
    runtime = @member_runtime_guard.verify!
    puts "ltw-air-worker isolation ok"
    puts "device: #{device.fetch('id')}"
    puts "role: mac-mini-air-worker"
    puts "identity: #{runtime.fetch('user')} (uid #{runtime.fetch('uid')})"
    puts "queue: all-v2-air-users"
    puts "sandbox: macOS Seatbelt + Codex workspace-write/no-tool-network"
    0
  end

  def once
    options = parse_executor_options!
    queue = options.fetch(:queue)
    ensure_member_runtime_isolation!(queue, options.fetch(:executor))
    cleanup_member_task_residue! if queue == "air"
    publish_presence(test: options.fetch(:executor) == "test") if queue == "legacy-owner"
    if queue == "legacy-owner"
      value = http.get("worker/jobs/lease")
      unless value["job"]
        puts "worker queue empty"
        return 0
      end
      execute_job(value.fetch("job"), value["capsule_base64"], options.fetch(:executor))
    else
      value = http.get("worker/air-jobs/lease")
      unless value["job"]
        puts "worker queue empty"
        return 0
      end
      execute_member_job(value.fetch("job"), options.fetch(:executor))
    end
    0
  end

  def sync_models
    ensure_no_arguments!
    catalog = publish_models
    puts "synced #{catalog.length} models"
    0
  end

  def publish_models
    identity = select_remote_identity
    models = nil
    app_server(identity).with_session do |session|
      models = session.request("model/list", { "limit" => 100 }).fetch("data")
    end
    catalog = Array(models).map do |model|
      {
        "id" => model.fetch("id"),
        "display_name" => model.fetch("displayName", model.fetch("id")),
        "default_effort" => model["defaultReasoningEffort"],
        "efforts" => Array(model["supportedReasoningEfforts"]).map { |item| item["reasoningEffort"] }.compact,
        "is_default" => !!model["isDefault"]
      }
    end
    http.post("worker/models", { "models" => catalog })
    catalog
  end

  def publish_presence(test: false)
    catalog = runtime_catalog(test: test)
    codex_healthy = catalog.fetch("runtimes").any? do |item|
      item["runtime_kind"] == "codex-app-server" && item["health"] == "compatible"
    end
    capabilities = %w[
      artifact-relay capability-adapters identity-catalog openai-docs-mcp resource-catalog runtime-catalog
      interaction-relay result-package project-delta runtime-workflows
    ]
    capabilities << "project-workflows" if @owner_capabilities.source_workflows_available?
    capabilities << "air-sync-pipeline" if test || @owner_capabilities.air_sync_pipeline_available?
    capabilities << "research-library-provider" if test || @owner_capabilities.research_library_available?
    capabilities.concat(%w[codex-job codex-status model-catalog]) if codex_healthy
    http.post("worker/presence", {
                "runtime_version" => RemoteWork::VERSION,
                "capabilities" => capabilities,
                "runtime_catalog" => catalog
              })
  end

  def capability_adapters
    @capability_adapters ||= begin
      path = @root.join("capabilities/remote-work/worker/capability-adapters.yaml")
      raise RemoteWork::Error, "Mini capability adapter registry is unavailable" unless path.file?
      value = YAML.safe_load(path.read(encoding: "UTF-8"), permitted_classes: [], aliases: false)
      raise RemoteWork::Error, "Mini capability adapter registry is invalid" unless value.is_a?(Hash) && value["schema_version"] == 1
      entries = Array(value["adapters"])
      raise RemoteWork::Error, "Mini capability adapter registry is empty" if entries.empty?
      entries.each do |entry|
        valid = entry.is_a?(Hash) && entry["capability_id"].to_s.match?(/\A[a-z][a-z0-9-]*:[a-z][a-z0-9-]*\z/) &&
                entry["adapter"].to_s.match?(/\A[a-z][a-z0-9-]*:[a-z][a-z0-9-]*\z/) &&
                %w[tool workflow codex].include?(entry["executor_kind"])
        if entry.key?("requires_owner_confirmation")
          valid &&= [true, false].include?(entry["requires_owner_confirmation"])
        end
        if entry["executor_kind"] == "workflow"
          valid &&= entry["command"].is_a?(Array) && !entry["command"].empty? &&
                    [true, false].include?(entry["requires_owner_confirmation"]) &&
                    [true, false, nil].include?(entry["structured_stdout"])
        end
        raise RemoteWork::Error, "Mini capability adapter registry contains an invalid entry" unless valid
      end
      raise RemoteWork::Error, "Mini capability adapter registry contains duplicate IDs" unless entries.map { |entry| entry["capability_id"] }.uniq.length == entries.length
      entries
    end
  rescue Psych::Exception
    raise RemoteWork::Error, "Mini capability adapter registry is invalid"
  end

  def capability_adapter!(capability_id)
    capability_adapters.find { |item| item.fetch("capability_id") == capability_id } ||
      raise(RemoteWork::Error, "Mini has no registered adapter for #{capability_id}")
  end

