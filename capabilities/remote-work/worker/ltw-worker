  def run_codex_executor(job, workspace, result_dir, events)
    identity = select_remote_identity
    @active_job_identity = identity
    selection_event = event_record("identity.selected", "本任务使用所有者 Codex 身份：#{identity}")
    events << selection_event
    upload_event(job, selection_event)
    initialize_baseline_git(workspace)
    final_path = result_dir.join("final.md")
    command = [
      @root.join("capabilities/agent-identity/adapters/agent-identity").to_s,
      "launch", "--alias", identity, "--",
      "exec", "--json", "--color", "never", "--sandbox", "workspace-write",
      "--cd", workspace.to_s, "--output-last-message", final_path.to_s, "-"
    ]
    status = nil
    Open3.popen3(*command) do |stdin, stdout, stderr, wait|
      stderr_reader = Thread.new { stderr.read }
      stdin.write(worker_prompt(job))
      stdin.close
      stdout.each_line do |line|
        event = sanitize_codex_event(line)
        next unless event
        events << event
        upload_event(job, event)
      end
      stderr_reader.value # never relay raw stderr; the exit state below is enough
      status = wait.value
    end
    raise RemoteWork::Error, "Codex process failed" unless status&.success?
    final_text = final_path.file? ? final_path.read(encoding: "UTF-8") : nil
    write_final_result(final_path, final_text, workspace)
    write_changes_patch(result_dir, workspace)
    result_dir.join("tests.json").write(JSON.pretty_generate({ "ok" => true, "executor" => "codex", "exit_status" => status.exitstatus }) + "\n", encoding: "UTF-8")
  end

  def run_app_server_executor(job, workspace, result_dir, events)
    identity = select_remote_identity
    @active_job_identity = identity
    selection_event = event_record("identity.selected", "本任务使用所有者 Codex 身份：#{identity}")
    events << selection_event
    upload_event(job, selection_event)
    initialize_baseline_git(workspace)
    completed = false
    turn_status = nil
    turn_failure_code = nil
    final_text = nil
    notification_handler = proc do |method, params|
      if method == "turn/completed"
        completed = true
        turn_status = params.dig("turn", "status")
        turn_failure_code = codex_turn_failure_code(params.dig("turn", "error"))
      end
      item = params["item"] if method == "item/completed"
      final_text = item["text"] if item.is_a?(Hash) && item["type"] == "agentMessage"
      event = sanitize_app_server_notification(method, params)
      if event
        events << event
        upload_event(job, event)
      end
    end
    request_handler = proc do |method, params|
      relay_app_server_request(job, workspace, method, params)
    end

    RemoteWork::AppServerBridge.new(
      command: app_server_command(identity),
      notification_handler: notification_handler,
      request_handler: request_handler
    ).with_session do |session|
      thread = session.request("thread/start", {
                                 "cwd" => workspace.to_s,
                                 "model" => job["model"],
                                 "approvalPolicy" => "on-request",
                                 "approvalsReviewer" => "user",
                                 "sandbox" => "workspace-write",
                                 "ephemeral" => true,
                                 "developerInstructions" => worker_developer_instructions
                               }).fetch("thread")
      turn_params = {
        "threadId" => thread.fetch("id"),
        "input" => [{ "type" => "text", "text" => worker_prompt(job) }]
      }
      turn_params["model"] = job["model"] if job["model"]
      turn_params["effort"] = job["effort"] if job["effort"]
      turn = session.request("turn/start", turn_params).fetch("turn")
      interrupted = false
      session.pump_until do
        if job_cancelled?(job.fetch("id")) && !interrupted
          session.request("turn/interrupt", { "threadId" => thread.fetch("id"), "turnId" => turn.fetch("id") })
          interrupted = true
        end
        completed
      end
    end
    raise RemoteWork::Error, "remote job was cancelled" if job_cancelled?(job.fetch("id"))
    unless turn_status == "completed"
      detail = turn_failure_code ? " (#{turn_failure_code})" : ""
      raise RemoteWork::Error, "Codex turn did not complete successfully: #{turn_status || 'unknown'}#{detail}"
    end

    write_final_result(result_dir.join("final.md"), final_text, workspace)
    write_changes_patch(result_dir, workspace)
    result_dir.join("tests.json").write(JSON.pretty_generate({
      "ok" => true,
      "executor" => "app-server",
      "turn_status" => turn_status,
      "model" => job["model"],
      "effort" => job["effort"]
    }) + "\n", encoding: "UTF-8")
  end

  def relay_app_server_request(job, workspace, method, params)
    kind = {
      "item/commandExecution/requestApproval" => "command-approval",
      "item/fileChange/requestApproval" => "file-change-approval",
      "item/tool/requestUserInput" => "user-input",
      "item/permissions/requestApproval" => "permissions-approval"
    }[method]
    raise RemoteWork::Error, "unsupported Codex interaction: #{method}" unless kind
    if kind == "user-input" && Array(params["questions"]).any? { |question| question["isSecret"] }
      raise RemoteWork::Error, "secret questions cannot be relayed through Two-Headed-Wu"
    end
    prompt = interaction_prompt(kind, params, workspace)
    interaction = http.post("worker/jobs/#{job.fetch('id')}/interactions", {
                              "lease_id" => job.fetch("lease_id"),
                              "kind" => kind,
                              "prompt" => prompt
                            }).fetch("interaction")
    reply = wait_for_interaction_reply(job, interaction.fetch("id"))
    app_server_reply(kind, params, reply)
  end

  def codex_turn_failure_code(error)
    return nil unless error.is_a?(Hash)
    info = error["codexErrorInfo"]
    value = if info.is_a?(String)
              info
            elsif info.is_a?(Hash)
              info.keys.first
            end
    value.to_s.match?(/\A[a-zA-Z][a-zA-Z0-9]{0,63}\z/) ? value : nil
  end

  def interaction_prompt(kind, params, workspace)
    case kind
    when "command-approval"
      {
        "title" => "Codex 请求执行命令",
        "command" => redact_text(params["command"].to_s, workspace),
        "cwd" => redact_path(params["cwd"], workspace),
        "reason" => redact_text(params["reason"].to_s, workspace),
        "available_decisions" => Array(params["availableDecisions"]).select { |value| value.is_a?(String) }
      }
    when "file-change-approval"
      {
        "title" => "Codex 请求修改文件",
        "reason" => redact_text(params["reason"].to_s, workspace),
        "grant_root" => redact_path(params["grantRoot"], workspace)
      }
    when "user-input"
      {
        "title" => "Codex 需要你补充信息",
        "questions" => Array(params["questions"]).map do |question|
          {
            "id" => question["id"],
            "header" => question["header"],
            "question" => question["question"].to_s[0, 2000],
            "options" => Array(question["options"]).map { |option| { "label" => option["label"], "description" => option["description"].to_s[0, 1000] } }
          }
        end
      }
    when "permissions-approval"
      {
        "title" => "Codex 请求额外权限",
        "reason" => redact_text(params["reason"].to_s, workspace),
        "requested" => summarize_permissions(params["permissions"], workspace)
      }
    end
  end

  def wait_for_interaction_reply(job, interaction_id)
    job_id = job.fetch("id")
    lease_id = job.fetch("lease_id")
    loop do
      value = http.get("worker/jobs/#{job_id}/interactions/#{interaction_id}/reply?lease_id=#{lease_id}")
      if value["job_state"] == "cancelled"
        mark_job_cancelled(job_id)
        raise RemoteWork::Error, "remote job was cancelled while waiting for approval"
      end
      return value.fetch("reply") if value["status"] == "answered" && value["reply"]
      sleep 2
    rescue RemoteWork::Error => error
      raise if error.message.include?("cancelled")
      sleep 3
    end
  end

  def app_server_reply(kind, params, reply)
    decision = reply["decision"]
    case kind
    when "command-approval"
      offered = Array(params["availableDecisions"]).select { |value| value.is_a?(String) }
      chosen = decision || "decline"
      chosen = "decline" if !offered.empty? && !offered.include?(chosen)
      { "decision" => chosen }
    when "file-change-approval"
      { "decision" => decision || "decline" }
    when "user-input"
      answers = reply["answers"] || {}
      allowed = Array(params["questions"]).map { |question| question["id"] }
      clean = answers.select { |key, value| allowed.include?(key) && value.is_a?(Array) }
      { "answers" => clean.transform_values { |items| { "answers" => items } } }
    when "permissions-approval"
      granted = %w[accept acceptForSession].include?(decision) ? params["permissions"] : {}
      { "permissions" => granted || {}, "scope" => decision == "acceptForSession" ? "session" : "turn" }
    end
  end

  def sanitize_app_server_notification(method, params)
    case method
    when "turn/started"
      event_record("codex.turn.started", "Codex 已开始处理")
    when "turn/completed"
      event_record("codex.turn.completed", "Codex 回合状态：#{params.dig('turn', 'status')}")
    when "item/completed"
      item = params["item"]
      return nil unless item.is_a?(Hash)
      case item["type"]
      when "agentMessage"
        event_record("codex.message", item["text"].to_s[0, 2000])
      when "commandExecution"
        event_record("codex.command", "命令执行状态：#{item['status']}")
      when "fileChange"
        event_record("codex.file_change", "文件修改状态：#{item['status']}")
      when "mcpToolCall"
        event_record("codex.mcp", "MCP 工具 #{item['server']}/#{item['tool']}：#{item['status']}")
      end
    when "error"
      event_record("codex.error", "Codex 报告了一个执行错误")
    end
  end

