    end
  rescue StandardError => error
    if job_cancelled?(job.fetch("id"))
      puts "cancelled #{job.fetch('id')}"
      return
    end
    begin
      update_state(job, "failed", "远程能力执行失败", failure: safe_failure(error))
    rescue StandardError
