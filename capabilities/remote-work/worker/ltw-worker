  def codex_identity_aliases
    stdout, _stderr, status = Open3.capture3(agent_identity_adapter, "status", "--json")
    raise RemoteWork::Error, "cannot read the registered Codex identity catalog" unless status.success?
    value = JSON.parse(stdout)
    aliases = Array(value["identities"]).map { |item| item["id"] if item.is_a?(Hash) }.compact
    aliases.select! { |item| item.is_a?(String) && item.match?(/\A[a-z][a-z0-9-]{0,62}\z/) }
    raise RemoteWork::Error, "no registered Codex identities are available" if aliases.empty?
    aliases.uniq.sort
  rescue JSON::ParserError
    raise RemoteWork::Error, "identity catalog returned invalid data"
  end

  def query_codex_identity_quota(identity)
    account_result = nil
    limits_result = nil
    bridge = RemoteWork::AppServerBridge.new(
      command: [agent_identity_adapter, "launch", "--alias", identity, "--", "app-server", "--stdio"],
      read_timeout: 25
    )
    bridge.with_session do |session|
      account_result = session.request("account/read", { "refreshToken" => false })
      limits_result = session.request("account/rateLimits/read", {})
    end
    normalize_codex_quota(identity, account_result["account"], limits_result)
  rescue RemoteWork::Error, JSON::ParserError, KeyError => error
    {
      "identity" => identity,
      "status" => "error",
      "account" => nil,
      "primary" => nil,
      "five_hour" => nil,
      "weekly" => nil,
      "rate_limits" => [],
      "error" => error.message[0, 500]
    }
  end

  def normalize_codex_quota(identity, account, limits)
    rate_limits = normalize_rate_limit_buckets(limits)
    primary = rate_limits.map { |bucket| bucket["primary"] }.compact.first
    five_hour = rate_limit_window(rate_limits, 300)
    weekly = rate_limit_window(rate_limits, 10_080)
    {
      "identity" => identity,
      "status" => account.is_a?(Hash) ? "ok" : "not-logged-in",
      "account" => account.is_a?(Hash) ? {
        "email" => account["email"].to_s[0, 320],
        "plan_type" => account["planType"].to_s[0, 64]
      } : nil,
      "primary" => primary,
      "five_hour" => five_hour,
      "weekly" => weekly,
      "rate_limits" => rate_limits,
      "error" => nil
    }
  end

  def rate_limit_window(rate_limits, duration_mins)
    Array(rate_limits).each do |bucket|
      %w[primary secondary].each do |key|
        window = bucket[key]
        return window if window.is_a?(Hash) && window["window_duration_mins"] == duration_mins
      end
    end
    nil
  end

  def normalize_rate_limit_buckets(limits)
    return [] unless limits.is_a?(Hash)

    raw = limits["rateLimitsByLimitId"]
    buckets = if raw.is_a?(Hash)
                raw.values
              elsif limits["rateLimits"].is_a?(Hash)
                [limits["rateLimits"]]
              else
                []
              end
    buckets.map do |bucket|
      next unless bucket.is_a?(Hash)
      {
        "limit_id" => bucket.fetch("limitId", "codex").to_s[0, 128],
        "limit_name" => bucket["limitName"].to_s[0, 128],
        "plan_type" => bucket["planType"].to_s[0, 64],
        "primary" => normalize_rate_limit_window(bucket["primary"]),
        "secondary" => normalize_rate_limit_window(bucket["secondary"]),
        "spend_control_reached" => !!bucket["spendControlReached"],
        "rate_limit_reached_type" => bucket["rateLimitReachedType"].to_s[0, 64]
      }
    end.compact
  end

  def normalize_rate_limit_window(window)
    return nil unless window.is_a?(Hash)

    used = numeric_value(window["usedPercent"])
    resets_at = integer_value(window["resetsAt"])
    duration = integer_value(window["windowDurationMins"])
    {
      "remaining_percent" => used ? [[100.0 - used, 0.0].max, 100.0].min : nil,
      "used_percent" => used,
      "window_duration_mins" => duration,
      "resets_at" => resets_at,
      "resets_at_iso" => resets_at ? Time.at(resets_at).utc.iso8601 : nil
    }
  rescue RangeError
    nil
  end

  def numeric_value(value)
    number = Float(value)
    number.finite? ? number : nil
  rescue ArgumentError, TypeError
    nil
  end

  def integer_value(value)
    number = Integer(value)
    number.positive? ? number : nil
  rescue ArgumentError, TypeError
    nil
  end

