  def probe_cli_runtime(runtime_kind, executable, features)
    stdout = nil
    stderr = nil
    status = nil
    Timeout.timeout(10) do
      stdout, stderr, status = Open3.capture3(executable, "--version")
    end
    version = [stdout, stderr].join("\n").lines.map(&:strip).find { |line| !line.empty? }.to_s[0, 128]
    cli_runtime_record(runtime_kind, version.empty? ? "unavailable" : version, status.success?, features)
  rescue Errno::ENOENT, Timeout::Error
    cli_runtime_record(runtime_kind, "unavailable", false, [])
  end

  def cli_runtime_record(runtime_kind, version, available, features)
    {
      "runtime_kind" => runtime_kind,
      "runtime_version" => version,
      "native_schema_hash" => Digest::SHA256.hexdigest("#{runtime_kind}:#{version}"),
      "adapter_version" => RemoteWork::VERSION,
      "health" => available ? "compatible" : "unavailable",
      "supported_features" => available ? features : []
    }
  end

  def codex_runtime_probe
    version_stdout, _version_stderr, version_status = Open3.capture3(agent_identity_adapter, "launch", "--project", "two-head-wu", "--", "--version")
    version = version_status.success? ? version_stdout.strip[0, 128] : "unavailable"
    cache_path = @config.home.join("runtime-probes", "codex-app-server.json")
    if cache_path.file?
      cached = JSON.parse(cache_path.read(encoding: "UTF-8"))
      return cached.fetch("runtime") if cached["codex_version"] == version && cached["runtime"].is_a?(Hash)
    end

    runtime = probe_codex_schema(version, version_status.success?)
    RemoteWork::Atomic.json(cache_path, {
      "schema_version" => 1,
      "codex_version" => version,
      "checked_at" => Time.now.utc.iso8601,
      "runtime" => runtime
    }, mode: 0o600)
    runtime
  rescue JSON::ParserError, KeyError
    probe_codex_schema(version || "unavailable", false)
  end

  def probe_codex_schema(version, executable)
    unless executable
      return {
        "runtime_kind" => "codex-app-server",
        "runtime_version" => version,
        "native_schema_hash" => Digest::SHA256.hexdigest("codex-app-server-unavailable"),
        "adapter_version" => RemoteWork::VERSION,
        "health" => "unavailable",
        "supported_features" => [],
        "diagnostic" => "Codex CLI version probe failed"
      }
    end

    FileUtils.mkdir_p(@config.paths.fetch("tmp").to_s, mode: 0o700)
    Dir.mktmpdir("codex-schema-", @config.paths.fetch("tmp").to_s) do |temporary|
      output = Pathname.new(temporary).join("schema")
      _stdout, _stderr, status = Open3.capture3(
        agent_identity_adapter, "launch", "--project", "two-head-wu", "--",
        "app-server", "generate-json-schema", "--experimental", "--out", output.to_s
      )
      raise RemoteWork::Error, "Codex app-server schema generation failed" unless status.success?
      paths = []
      Find.find(output.to_s) { |raw| paths << Pathname.new(raw) if Pathname.new(raw).file? }
      raise RemoteWork::Error, "Codex app-server schema bundle is empty" if paths.empty?
      digest = Digest::SHA256.new
      schema_text = +""
      paths.sort.each do |path|
        relative = path.relative_path_from(output).to_s
        content = path.binread
        digest << relative << "\0" << content << "\0"
        schema_text << content.force_encoding("UTF-8").scrub if schema_text.bytesize < 8 * 1024 * 1024
      end
      required = ["thread/start", "turn/start", "requestApproval", "requestUserInput"]
      missing = required.reject { |marker| schema_text.include?(marker) }
      {
        "runtime_kind" => "codex-app-server",
        "runtime_version" => version,
        "native_schema_hash" => digest.hexdigest,
        "adapter_version" => RemoteWork::VERSION,
        "health" => missing.empty? ? "compatible" : "incompatible",
        "supported_features" => missing.empty? ? %w[approval cancel file-change interaction model-list project-task user-input] : [],
        "diagnostic" => missing.empty? ? nil : "Missing protocol markers: #{missing.join(', ')}"
      }.compact
    end
  rescue RemoteWork::Error => error
    {
      "runtime_kind" => "codex-app-server",
      "runtime_version" => version,
      "native_schema_hash" => Digest::SHA256.hexdigest("codex-app-server-probe-failed:#{version}"),
      "adapter_version" => RemoteWork::VERSION,
      "health" => "incompatible",
      "supported_features" => [],
      "diagnostic" => error.message[0, 500]
    }
  end

