  def active_project_terminal_context
    raw_terminal = ENV[PROJECT_TERMINAL_ID_ENV]
    raw_project = ENV[PROJECT_ID_ENV]
    return nil if raw_terminal.to_s.empty? && raw_project.to_s.empty?
    if raw_terminal.to_s.empty? || raw_project.to_s.empty?
      raise AgentIdentityError, "managed project terminal requires both #{PROJECT_TERMINAL_ID_ENV} and #{PROJECT_ID_ENV}"
    end

    terminal_id = validate_uuid!(raw_terminal)
    project_id = validate_project!(raw_project)
    entry = fetch_project_terminal!(terminal_id)
    unless entry.fetch("project") == project_id
      raise AgentIdentityError, "managed project terminal does not belong to project #{project_id}"
    end

    { "terminal" => terminal_id, "project" => project_id }
  end

  def run_project_terminal_session(state, entry, alias_name, interactive_arguments, expected_thread_id:)
    project_id = validate_project!(entry.fetch("project"))
    selected_project_identity!(state, project_id)
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "run a managed project terminal")
    cwd = validate_project_terminal_cwd!(entry.fetch("cwd"))
    ensure_isolated_home!(alias_name) if identity.fetch("state_kind") == "isolated"
    mark_project_terminal_status!(entry.fetch("id"), "restoring", exit_code: nil)

    environment = environment_for(identity)
    environment[TERMINAL_SLOT_ENV] = nil
    environment[TERMINAL_ALIAS_ENV] = nil
    environment[TERMINAL_INSTANCE_ENV] = nil
    environment[PROJECT_TERMINAL_ID_ENV] = nil
    environment[PROJECT_ID_ENV] = nil
    command = ["codex", "-C", cwd, "--config", THREAD_TITLE_CONFIG, *interactive_arguments]
    observer = CodexSessionObserver.new(allowed_roots: conversation_rollout_roots(identity))
    on_thread_observed = lambda do |thread_id|
      activate_project_terminal!(entry.fetch("id"), thread_id, alias_name, identity["conversation_pool"], cwd)
      record_terminal_continuation!(Digest::SHA256.hexdigest(entry.fetch("id")), thread_id, alias_name)
      record_thread_execution!(thread_id, alias_name, identity["conversation_pool"])
    end
    result = observer.run(
      environment,
      *command,
      expected_thread_id: expected_thread_id,
      on_thread_observed: on_thread_observed
    )
    if result.thread_id
      activate_project_terminal!(entry.fetch("id"), result.thread_id, alias_name, identity["conversation_pool"], cwd)
      record_terminal_continuation!(Digest::SHA256.hexdigest(entry.fetch("id")), result.thread_id, alias_name)
      record_thread_execution!(result.thread_id, alias_name, identity["conversation_pool"])
    end

    if result.signal
      signal_status = (expected_thread_id || result.thread_id) ? "recoverable" : "blocked"
      mark_project_terminal_status!(entry.fetch("id"), signal_status, exit_code: result.exit_code)
      [result.exit_code, true]
    elsif result.exit_code.zero?
      mark_project_terminal_status!(entry.fetch("id"), "inactive", exit_code: 0)
      [0, false]
    else
      mark_project_terminal_status!(entry.fetch("id"), "blocked", exit_code: result.exit_code)
      [result.exit_code, false]
    end
  end

  def enter_project_terminal_shell(entry, exit_code)
    return exit_code if ENV["TWO_HEAD_WU_TESTING"] == "1"

    status = exit_code.zero? ? "Codex 已正常退出；此终端不会在下次项目打开时自动恢复会话。" : "Codex 恢复失败（exit #{exit_code}）；已暂停自动恢复。"
    warn status
    shell = resolve_executable!(ENV.fetch("SHELL", "/bin/zsh"), "interactive shell")
    environment = {
      PROJECT_TERMINAL_ID_ENV => entry.fetch("id"),
      PROJECT_ID_ENV => entry.fetch("project"),
      TERMINAL_INSTANCE_ENV => entry.fetch("id")
    }
    exec(environment, shell, "-l")
  end

  def activate_project_terminal!(terminal_id, thread_id, alias_name, conversation_pool, cwd)
    terminal_id = validate_uuid!(terminal_id)
    thread_id = validate_uuid!(thread_id)
    alias_name = validate_alias!(alias_name)
    with_project_terminal_registry(write: true) do |registry|
      entry = registry.fetch("terminals")[terminal_id]
      raise AgentIdentityError, "unknown project terminal: #{terminal_id}" unless entry

      entry["session_id"] = thread_id
      entry["identity"] = alias_name
      entry["conversation_pool"] = conversation_pool
      entry["cwd"] = validate_project_terminal_cwd!(cwd)
      entry["status"] = "recoverable"
      entry["updated_at"] = Time.now.utc.iso8601
      entry["last_exit_code"] = nil
    end
  end

  def mark_project_terminal_status!(terminal_id, status, exit_code:)
    terminal_id = validate_uuid!(terminal_id)
    raise AgentIdentityError, "project terminal status is invalid" unless PROJECT_TERMINAL_STATES.include?(status)
    unless exit_code.nil? || exit_code.is_a?(Integer)
      raise AgentIdentityError, "project terminal exit code is invalid"
    end

    with_project_terminal_registry(write: true) do |registry|
      entry = registry.fetch("terminals")[terminal_id]
      raise AgentIdentityError, "unknown project terminal: #{terminal_id}" unless entry

      entry["status"] = status
      entry["updated_at"] = Time.now.utc.iso8601
      entry["last_exit_code"] = exit_code
    end
  end

  def project_terminal_payload(state, entry, metadata: nil)
    identity = state.fetch("identities")[entry["identity"]]
    metadata ||= project_terminal_thread_metadata(identity, entry["session_id"]) if identity && entry["session_id"]
    cwd_ready = Pathname.new(entry.fetch("cwd")).directory?
    status = entry.fetch("status")
    auto_restore = %w[recoverable restoring].include?(status) && !metadata.nil? && cwd_ready &&
                   identity && identity.fetch("usage_scope", "owner-local") == "owner-local"
    {
      "terminal" => entry.fetch("id"),
      "project" => entry.fetch("project"),
      "thread" => entry["session_id"],
      "identity" => entry["identity"],
      "conversation_pool" => entry["conversation_pool"],
      "cwd" => entry.fetch("cwd"),
      "status" => status,
      "auto_restore" => !!auto_restore,
      "name" => metadata && metadata.fetch("name"),
      "updated_at" => entry.fetch("updated_at"),
      "last_exit_code" => entry["last_exit_code"]
    }
  end

  def project_terminal_thread_metadata(identity, thread_id)
    return nil unless identity && thread_id

    database = state_database_for(identity)
    return nil unless database.file? && command_available?("sqlite3")

    columns = sqlite_rows(database, "PRAGMA table_info(threads)").map { |row| row.fetch("name") }
    archived = columns.include?("archived") ? "COALESCE(archived, 0)" : "0"
    names = []
    names << "NULLIF(name, '')" if columns.include?("name")
    names << "NULLIF(title, '')" if columns.include?("title")
    display_name = names.empty? ? "''" : "COALESCE(#{names.join(', ')}, '')"
    row = sqlite_rows(
      database,
      "SELECT id, #{archived} AS archived, #{display_name} AS display_name FROM threads WHERE id = #{sqlite_literal(validate_uuid!(thread_id))} LIMIT 1"
    ).first
    return nil unless row && row.fetch("archived").to_i.zero?

    { "id" => row.fetch("id"), "name" => row.fetch("display_name").to_s.empty? ? "Codex #{thread_id[0, 8]}" : row.fetch("display_name") }
  rescue AgentIdentityError, JSON::ParserError
    nil
  end

  def project_terminal_thread_metadata!(identity, thread_id)
    metadata = project_terminal_thread_metadata(identity, thread_id)
    raise AgentIdentityError, "project terminal thread is missing, archived, or unavailable: #{thread_id}" unless metadata

    metadata
  end

