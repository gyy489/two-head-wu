  def thread_lifecycle
    action = @arguments.shift || "inspect"
    raise AgentIdentityError, "unknown thread-lifecycle action: #{action}" unless action == "inspect"

    options = { threads: [], json: false, existence_only: false }
    parser = OptionParser.new do |item|
      item.on("--thread UUID") { |value| options.fetch(:threads) << value }
      item.on("--existence-only") { options[:existence_only] = true }
      item.on("--json") { options[:json] = true }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!

    payload = CodexThreadLifecycle.new(environment: ENV).inspect_threads(
      thread_ids: options.fetch(:threads),
      include_session_metadata: !options.fetch(:existence_only)
    )
    emit(payload, json: options.fetch(:json))
    0
  end

  def init
    ensure_private_root!
    write_state(default_state) unless state_path.exist?
    emit({ "result" => "initialized", "private_registry" => "ready" })
    0
  end

  def register_current
    options = parse_alias_and_mode!
    state = load_state
    alias_name = options.fetch(:alias)
    raise AgentIdentityError, "identity already exists: #{alias_name}" if state.fetch("identities").key?(alias_name)
    raise AgentIdentityError, "the current default Codex environment is already registered" if state.fetch("identities").values.any? { |item| item.fetch("state_kind") == "default" }
    raise AgentIdentityError, "the default Codex environment is unavailable" unless default_codex_home.directory?

    identity = identity_record(alias_name, "default", options.fetch(:mode))
    state.fetch("identities")[alias_name] = identity
    pool_name = options.fetch(:pool)
    attach_to_pool!(state, identity, pool_name) if pool_name
    write_state(state)
    emit({ "result" => "registered-current", "identity" => alias_name, "state_kind" => "default", "mode" => options.fetch(:mode), "conversation_pool" => pool_name || "none" })
    0
  end

  def add
    options = parse_alias_and_mode!
    state = load_state
    alias_name = options.fetch(:alias)
    raise AgentIdentityError, "identity already exists: #{alias_name}" if state.fetch("identities").key?(alias_name)

    identity = identity_record(alias_name, "isolated", options.fetch(:mode))
    state.fetch("identities")[alias_name] = identity
    ensure_isolated_home!(alias_name)
    shared_skills = attach_shared_skills!(alias_name)
    pool_name = options.fetch(:pool)
    attach_to_pool!(state, identity, pool_name) if pool_name
    write_state(state)
    emit({ "result" => "added", "identity" => alias_name, "state_kind" => "isolated", "mode" => options.fetch(:mode), "shared_skills" => shared_skills, "conversation_pool" => pool_name || "none", "next" => "run login --alias #{alias_name}" })
    0
  end

  def add_member
    options = parse_alias!(allow_json: true)
    state = load_state
    alias_name = validate_alias!(options.fetch(:alias))
    if OWNER_AUTO_MEMBERS.include?(alias_name) && !dedicated_air_worker_registry?
      raise AgentIdentityError, "owner automatic aliases are reserved outside the dedicated Air Worker registry"
    end
    raise AgentIdentityError, "identity already exists: #{alias_name}" if state.fetch("identities").key?(alias_name)

    identity = identity_record(alias_name, "isolated", "manual", usage_scope: "member-remote-work")
    state.fetch("identities")[alias_name] = identity
    ensure_isolated_home!(alias_name)
    write_state(state)
    emit({
      "result" => "member-added",
      "identity" => alias_name,
      "state_kind" => "isolated",
      "mode" => "manual",
      "usage_scope" => "member-remote-work",
      "shared_skills" => "none",
      "conversation_pool" => "none",
      "next" => "run login --alias #{alias_name}"
    }, json: options.fetch(:json))
    0
  end

  def set_mode
    options = {}
    parser = OptionParser.new do |item|
      item.on("--alias NAME") { |value| options[:alias] = value }
      item.on("--mode MODE") { |value| options[:mode] = value }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!
    alias_name = validate_alias!(options.fetch(:alias) { raise AgentIdentityError, "--alias is required" })
    mode = validate_mode!(options.fetch(:mode) { raise AgentIdentityError, "--mode is required" })
    state = load_state
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "change selection mode")
    identity["selection_mode"] = mode
    write_state(state)
    emit({ "result" => "mode-updated", "identity" => alias_name, "mode" => mode })
    0
  end

  def bind
    options = parse_project_and_alias!
    state = load_state
    project_id = validate_project!(options.fetch(:project))
    alias_name = validate_alias!(options.fetch(:alias))
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "bind a project")
    unless identity.fetch("selection_mode") == "project-auto"
      raise AgentIdentityError, "identity #{alias_name} is manual; run set-mode --alias #{alias_name} --mode project-auto first"
    end

    state.fetch("project_bindings")[project_id] = alias_name
    write_state(state)
    emit({ "result" => "bound", "project" => project_id, "identity" => alias_name })
    0
  end

  def unbind
    options = parse_project!
    state = load_state
    project_id = validate_project!(options.fetch(:project))
    raise AgentIdentityError, "project is not bound: #{project_id}" unless state.fetch("project_bindings").delete(project_id)

    write_state(state)
    emit({ "result" => "unbound", "project" => project_id })
    0
  end

  def select
    options = parse_project!(allow_json: true)
    state = load_state
    project_id = validate_project!(options.fetch(:project))
    alias_name = selected_project_identity!(state, project_id)
    emit({ "result" => "selected", "project" => project_id, "identity" => alias_name }, json: options.fetch(:json))
    0
  end

  def pool_create
    options = parse_pool!
    state = load_state
    pool_name = validate_pool!(options.fetch(:pool))
    ensure_pool_root!(pool_name)
    state.fetch("conversation_pools")[pool_name] ||= { "id" => pool_name, "created_at" => Time.now.utc.iso8601, "identities" => [] }
    write_state(state)
    emit({ "result" => "pool-created", "pool" => pool_name, "shared_dirs" => SHARED_CONVERSATION_DIRS.join(",") })
    0
  end

  def pool_attach
    options = parse_pool_and_alias!
    state = load_state
    pool_name = validate_pool!(options.fetch(:pool))
    alias_name = validate_alias!(options.fetch(:alias))
    identity = fetch_identity!(state, alias_name)
    attach_to_pool!(state, identity, pool_name)
    write_state(state)
    emit({ "result" => "pool-attached", "pool" => pool_name, "identity" => alias_name, "shared_dirs" => SHARED_CONVERSATION_DIRS.join(",") })
    0
  end

  # Shared by the explicit pool-attach command and by register-current/add's
  # default-pool behavior. Mutates identity/state in place; caller writes state.
  def attach_to_pool!(state, identity, pool_name)
    ensure_owner_local!(identity, "join a conversation pool")
    pool = state.fetch("conversation_pools")[pool_name] ||= { "id" => pool_name, "created_at" => Time.now.utc.iso8601, "identities" => [] }
    preflight_shared_state_attachment!(identity, pool_name, pool)
    ensure_pool_root!(pool_name)
    attach_conversation_pool!(identity, pool_name)
    attach_shared_state!(identity, pool_name) if shared_state_enabled?(pool)
    pool.fetch("identities") << identity.fetch("id") unless pool.fetch("identities").include?(identity.fetch("id"))
    identity["conversation_pool"] = pool_name
  end

  def pool_status
    json = parse_json_flag!
    state = load_state
    pools = state.fetch("conversation_pools").values.sort_by { |item| item.fetch("id") }.map do |item|
      pool_name = item.fetch("id")
      {
        "id" => pool_name,
        "configured" => pool_root(pool_name).directory?,
        "identities" => Array(item["identities"]).sort,
        "shared_dirs" => SHARED_CONVERSATION_DIRS,
        "shared_state" => public_shared_state(state, item, pool_name)
      }
    end
    emit({ "result" => "pool-status", "pools" => pools }, json: json)
    0
  end

  def pool_state
    command = @arguments.shift || "status"
    case command
    when "status"
      options = parse_pool_state_status!
      state = load_state
      pool_name = validate_pool!(options.fetch(:pool))
      pool = state.fetch("conversation_pools")[pool_name]
      raise AgentIdentityError, "unknown conversation pool: #{pool_name}" unless pool

      emit(shared_state_status_payload(state, pool_name, pool), json: options.fetch(:json))
      0
    when "enable"
      options = parse_pool_state_enable!
      state = load_state
      pool_name = validate_pool!(options.fetch(:pool))
      pool = state.fetch("conversation_pools")[pool_name]
      raise AgentIdentityError, "unknown conversation pool: #{pool_name}" unless pool

      payload = shared_state_enable_payload(state, pool_name, pool, options[:base_alias])
      unless options.fetch(:yes)
        emit(payload.merge("result" => "pool-state-enable-preview"), json: options.fetch(:json))
        return 0
      end
      blockers = payload.fetch("blockers")
      raise AgentIdentityError, "shared state migration is blocked: #{blockers.join('; ')}" unless blockers.empty?

      result = enable_shared_state!(state, pool_name, pool, payload.fetch("base_alias"))
      emit(result, json: options.fetch(:json))
      0
    else
      raise AgentIdentityError, "pool-state command must be status or enable"
    end
  end

  def route_command
    options = parse_route_command!
    state = load_state
    channel = validate_channel!(options.fetch(:channel))
    session = validate_session!(options.fetch(:session))
    text = options.fetch(:text).strip
    command = text.split(/\s+/, 2).first || ""
    alias_name = command.start_with?("/") ? command.delete_prefix("/") : command
    if command == "/codex"
      alias_name = text.split(/\s+/, 2).last.to_s if command == "/codex"
    end
    alias_name = validate_alias!(alias_name)
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "receive a channel route")
    set_route!(state, channel, session, alias_name)
    write_state(state)
    emit({ "result" => "route-updated", "channel" => channel, "session" => session, "identity" => alias_name }, json: options.fetch(:json))
    0
  end

  def route_set
    options = parse_route_and_alias!
    state = load_state
    channel = validate_channel!(options.fetch(:channel))
    session = validate_session!(options.fetch(:session))
    alias_name = validate_alias!(options.fetch(:alias))
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "receive a channel route")
    set_route!(state, channel, session, alias_name)
    write_state(state)
    emit({ "result" => "route-updated", "channel" => channel, "session" => session, "identity" => alias_name }, json: options.fetch(:json))
    0
  end

  def route_select
    options = parse_route!(allow_json: true)
    state = load_state
    channel = validate_channel!(options.fetch(:channel))
    session = validate_session!(options.fetch(:session))
    route = selected_route_identity(state, channel, session)
    preferred = route ? route.fetch("identity") : nil
    selection = select_route_identity(state, channel, preferred)
    alias_name = selection.fetch("identity")
    identity = fetch_identity!(state, alias_name)
    emit({
      "result" => "route-selected",
      "channel" => channel,
      "session" => session,
      "canonical_session" => normalize_route_session(channel, session),
      "identity" => alias_name,
      "state_kind" => identity.fetch("state_kind"),
      "source" => selection.fetch("source"),
      "selection_reason" => selection["selection_reason"],
      "quota_probe" => selection["quota_probe"],
      "matched_session" => route&.fetch("matched_session", nil)
    }.compact, json: options.fetch(:json))
    0
  end

  def owner_auto
    command = @arguments.shift || "status"
    json = parse_json_flag!
    state = load_state
    case command
    when "enable"
      missing = OWNER_AUTO_MEMBERS.reject { |alias_name| state.fetch("identities").key?(alias_name) }
      raise AgentIdentityError, "owner automatic identities are not registered: #{missing.join(', ')}" unless missing.empty?
      state["owner_auto"] = {
        "enabled" => true,
        "members" => OWNER_AUTO_MEMBERS,
        "channels" => OWNER_AUTO_CHANNELS,
        "updated_at" => Time.now.utc.iso8601
      }
      write_state(state)
    when "disable"
      state["owner_auto"] = default_owner_auto.merge("updated_at" => Time.now.utc.iso8601)
      write_state(state)
    when "status"
      # Read-only.
    else
      raise AgentIdentityError, "owner-auto command must be enable, disable, or status"
    end
    emit({ "result" => "owner-auto-#{command}", "owner_auto" => public_owner_auto(state) }, json: json)
    0
  end

  def route_status
    json = parse_json_flag!
    state = load_state
    emit({ "result" => "route-status", "channel_routes" => state.fetch("channel_routes").sort.to_h }, json: json)
    0
  end

  def terminal_session
    command = @arguments.shift || "status"
    case command
    when "status"
      terminal_session_status
    when "forget"
      terminal_session_forget
    when "hook"
      terminal_session_hook
    else
      raise AgentIdentityError, "terminal-session command must be status, forget, or hook"
    end
  end

  def terminal_session_status
    options = parse_terminal_slot!(required: false, allow_json: true)
    registry = read_terminal_session_registry
    if options[:slot]
      slot = validate_terminal_slot!(options.fetch(:slot))
      binding = registry.fetch("slots")[slot]
      emit({
        "result" => "terminal-session-status",
        "slot" => slot,
        "bound" => !binding.nil?,
        "binding" => binding
      }, json: options.fetch(:json))
    else
      slots = registry.fetch("slots").sort.map do |slot, binding|
        binding.merge("slot" => slot)
      end
      emit({ "result" => "terminal-session-status", "slots" => slots }, json: options.fetch(:json))
    end
    0
  end

  def terminal_session_forget
    options = parse_terminal_slot!(required: true, allow_json: true)
    slot = validate_terminal_slot!(options.fetch(:slot))
    removed = false
    with_terminal_session_registry(write: true) do |registry|
      removed = !registry.fetch("slots").delete(slot).nil?
    end
    emit({ "result" => "terminal-session-forgotten", "slot" => slot, "removed" => removed }, json: options.fetch(:json))
    0
  end

  # Internal Codex SessionStart hook. It deliberately emits no stdout because
  # hook stdout becomes model-visible developer context.
  def terminal_session_hook
    ensure_no_arguments!
    slot_raw = ENV[TERMINAL_SLOT_ENV]
    alias_raw = ENV[TERMINAL_ALIAS_ENV]
    return 0 if slot_raw.to_s.empty? || alias_raw.to_s.empty?

    payload = JSON.parse($stdin.read)
    return 0 unless payload["hook_event_name"] == "SessionStart"

    slot = validate_terminal_slot!(slot_raw)
    alias_name = validate_alias!(alias_raw)
    session_id = validate_session!(payload.fetch("session_id"))
    state = load_state
    identity = fetch_identity!(state, alias_name)
    record_terminal_session!(slot, session_id, alias_name)
    CodexThreadNamer.new(environment: environment_for(identity)).call(thread_id: session_id, name: slot)
    0
  end

  def project_terminal
    command = @arguments.shift || "list"
    case command
    when "allocate" then project_terminal_allocate
    when "adopt" then project_terminal_adopt
    when "list" then project_terminal_list
    when "status" then project_terminal_status
    when "start" then project_terminal_start
    when "restore" then project_terminal_restore
    when "close" then project_terminal_close
    else
      raise AgentIdentityError, "project-terminal command must be allocate, adopt, list, status, start, restore, or close"
    end
  end

  def project_terminal_allocate
    options = parse_project_terminal_project_and_cwd!
    state = load_state
    project_id = validate_project!(options.fetch(:project))
    selected_project_identity!(state, project_id)
    cwd = validate_project_terminal_cwd!(options.fetch(:cwd))
    terminal_id = SecureRandom.uuid
    now = Time.now.utc.iso8601
    entry = {
      "id" => terminal_id,
      "project" => project_id,
      "session_id" => nil,
      "identity" => nil,
      "conversation_pool" => nil,
      "cwd" => cwd,
      "status" => "allocated",
      "created_at" => now,
      "updated_at" => now,
      "last_exit_code" => nil
