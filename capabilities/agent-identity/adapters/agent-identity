  def continue_schedule
    options = { json: false, dry_run: false, until_complete: false }
    parser = OptionParser.new do |item|
      item.banner = "Usage: codex-continue [HH:MM] [MESSAGE] [--message TEXT] [--until-complete] [--complete] [--dry-run] [--json]"
      item.on("--at WHEN") { |value| options[:at] = value }
      item.on("--message TEXT") { |value| options[:message] = value }
      item.on("--until-complete") { options[:until_complete] = true }
      item.on("--complete") { options[:complete] = true }
      item.on("--dry-run") { options[:dry_run] = true }
      item.on("--json") { options[:json] = true }
      item.on("-h", "--help") do
        puts item
        return 0
      end
    end
    parser.parse!(@arguments)
    if options[:complete]
      ensure_no_arguments!
      if options[:at] || options[:message] || options[:until_complete] || options[:dry_run]
        raise AgentIdentityError, "--complete cannot be combined with scheduling options"
      end
      thread_id = validate_uuid!(ENV.fetch("CODEX_THREAD_ID") { raise AgentIdentityError, "CODEX_THREAD_ID is unavailable; run !codex-continue --complete from the target Codex TUI" })
      changed = complete_continuation_task!(thread_id)
      emit({ "result" => changed ? "continue-marked-complete" : "continue-no-active-task", "task_scope" => "thread", "thread" => thread_id, "changed" => changed, "completion_command" => "!codex-continue --complete" }, json: options.fetch(:json))
      return 0
    end
    unless @arguments.empty?
      first = @arguments.shift
      if options[:at]
        options[:message] ||= first
      elsif LOCAL_TIME_ARGUMENT_PATTERN.match?(first)
        options[:at] = first
        options[:message] ||= @arguments.shift unless @arguments.empty?
      elsif options[:message]
        raise AgentIdentityError, "unexpected arguments: #{([first] + @arguments).join(' ')}"
      else
        # Natural shorthand: a non-time positional argument replaces the
        # default message while retaining quota-reset scheduling.
        options[:message] = first
      end
    end
    ensure_no_arguments!
    if options.fetch(:until_complete) && options[:at]
      raise AgentIdentityError, "--until-complete is only available for quota-reset insurance and cannot be combined with an explicit time"
    end

    state = load_state
    identity = current_identity!(state)
    alias_name = identity.fetch("id")
    conversation_pool = identity["conversation_pool"]
    thread_id = validate_uuid!(ENV.fetch("CODEX_THREAD_ID") { raise AgentIdentityError, "CODEX_THREAD_ID is unavailable; run codex-continue from the target Codex TUI with !codex-continue" })
    cwd = Pathname.new(utf8_path(Dir.pwd)).expand_path.cleanpath
    raise AgentIdentityError, "current working directory is unavailable: #{cwd}" unless cwd.directory?

    message = validate_continue_message!(options[:message] || "继续")
    now = continuation_clock_now
    codex_bin = resolve_executable!(ENV["TWO_HEAD_WU_CODEX_BIN"] || "codex", "Codex")
    source = options[:at] ? "local-time" : "quota-insurance"
    turn_guard = nil
    run_at = if options[:at]
               next_local_clock_time(options.fetch(:at), now)
             else
               probe_environment = environment_for(identity)
               turn_guard = continuation_turn_marker!(
                 environment: probe_environment,
                 codex_bin: codex_bin,
                 thread_id: thread_id
               )
               if options.fetch(:until_complete) && turn_guard.fetch("status") == "none"
                 raise AgentIdentityError, "--until-complete requires a persisted current Codex turn"
               end
               continuation_run_at!(
                 environment: probe_environment,
                 codex_bin: codex_bin,
                 now: now
               )
             end
    openclaw_bin = resolve_openclaw_executable!
    payload = {
      "result" => options.fetch(:dry_run) ? "continue-schedule-preview" : "continue-scheduled",
      "task_scope" => "thread",
      "identity" => alias_name,
      "identity_role" => "execution-fallback",
      "thread" => thread_id,
      "cwd" => cwd.to_s,
      "source" => source,
      "run_at" => run_at.iso8601,
      "message_length" => message.length
    }
    payload["mode"] = "until-complete" if options.fetch(:until_complete)
    if turn_guard
      payload["condition"] = options.fetch(:until_complete) ? "continue-until-thread-task-completes" : "continue-if-thread-task-remains-incomplete"
      payload["guard_turn"] = turn_guard.fetch("id")
    end
    if options.fetch(:dry_run)
      payload["completion_command"] = "!codex-continue --complete" if turn_guard
      emit(payload, json: options.fetch(:json))
      return 0
    end

    record_thread_execution!(thread_id, alias_name, conversation_pool)
    task_id = if turn_guard
                begin_continuation_task!(thread_id, options.fetch(:until_complete) ? "until-complete" : "one-shot")
              end
    delivery_message = if task_id
                         "#{message}\n\n当前会话的整个任务真实完成后，请运行本地命令 !codex-continue --complete；未完成时不要运行。"
                       else
                         message
                       end
    validate_continue_message!(delivery_message)
    payload["task_id"] = task_id if task_id
    payload["completion_command"] = "!codex-continue --complete" if task_id
    job_id = register_continuation_cron!(
      openclaw_bin: openclaw_bin,
      alias_name: alias_name,
      conversation_pool: conversation_pool,
      thread_id: thread_id,
      cwd: cwd,
      message: delivery_message,
      codex_bin: codex_bin,
      run_at: run_at,
      turn_guard: turn_guard,
      until_complete: options.fetch(:until_complete),
      task_id: task_id
    )
    payload["job_id"] = job_id if job_id
    emit(payload, json: options.fetch(:json))
    0
  rescue JSON::ParserError
    raise AgentIdentityError, "OpenClaw returned invalid JSON while registering the continuation task"
  end

  # Internal command stored as an exact argv payload in OpenClaw cron.
  def continue_run
    options = { json: false, until_complete: false }
    parser = OptionParser.new do |item|
      item.on("--alias NAME") { |value| options[:alias] = value }
      item.on("--fallback-alias NAME") { |value| options[:alias] = value }
      item.on("--pool NAME_OR_NONE") { |value| options[:pool] = value }
      item.on("--thread UUID") { |value| options[:thread] = value }
      item.on("--cwd DIR") { |value| options[:cwd] = value }
      item.on("--message TEXT") { |value| options[:message] = value }
      item.on("--codex-bin PATH") { |value| options[:codex_bin] = value }
      item.on("--guard-turn UUID_OR_NONE") { |value| options[:guard_turn] = value }
      item.on("--guard-status STATUS") { |value| options[:guard_status] = value }
      item.on("--task UUID") { |value| options[:task] = value }
      item.on("--until-complete") { options[:until_complete] = true }
      item.on("--json") { options[:json] = true }
    end
    parser.parse!(@arguments)
    ensure_no_arguments!

    state = load_state
    fallback_alias = validate_alias!(options.fetch(:alias) { raise AgentIdentityError, "--alias is required" })
    thread_id = validate_uuid!(options.fetch(:thread) { raise AgentIdentityError, "--thread is required" })
    task_id = options[:task] && validate_uuid!(options[:task])
    task = task_id && continuation_task(thread_id)
    if task_id && (task.nil? || task.fetch("task_id") != task_id)
      emit({ "result" => "continue-skipped-superseded", "task_scope" => "thread", "task_id" => task_id, "thread" => thread_id }, json: options.fetch(:json))
      return 0
    end
    if task && task.fetch("status") == "completed"
      emit({ "result" => "continue-skipped-task-completed", "task_scope" => "thread", "task_id" => task.fetch("task_id"), "thread" => thread_id }, json: options.fetch(:json))
      return 0
    end
    scheduled_pool = if options.key?(:pool)
                       options.fetch(:pool) == "none" ? nil : validate_pool!(options.fetch(:pool))
                     else
                       :unspecified
                     end
    execution = continuation_execution_identity!(
      state: state,
      thread_id: thread_id,
      fallback_alias: fallback_alias,
      scheduled_pool: scheduled_pool
    )
    identity = execution.fetch("identity")
    alias_name = execution.fetch("alias")
    identity_source = execution.fetch("source")
    conversation_pool = execution.fetch("conversation_pool")
    cwd = Pathname.new(utf8_path(options.fetch(:cwd) { raise AgentIdentityError, "--cwd is required" })).expand_path.cleanpath
    raise AgentIdentityError, "scheduled working directory is unavailable: #{cwd}" unless cwd.directory?
    message = validate_continue_message!(options.fetch(:message) { raise AgentIdentityError, "--message is required" })
    codex_bin = resolve_executable!(options.fetch(:codex_bin) { raise AgentIdentityError, "--codex-bin is required" }, "Codex")
    environment = environment_for(identity).merge(
      TERMINAL_SLOT_ENV => nil,
      TERMINAL_ALIAS_ENV => nil,
      TERMINAL_INSTANCE_ENV => nil,
      "CODEX_THREAD_ID" => nil,
      "CODEX_SESSION_ID" => nil
    )

    if options.fetch(:until_complete) && !(options[:guard_turn] && options[:guard_status])
      raise AgentIdentityError, "--until-complete requires a turn guard"
    end

    current_turn = nil
    current_status = nil
    next_turn_guard = nil
    if options[:guard_turn] || options[:guard_status]
      unless options[:guard_turn] && options[:guard_status]
        raise AgentIdentityError, "--guard-turn and --guard-status must be provided together"
      end
      guard_turn = options.fetch(:guard_turn).to_s.downcase
      guard_status = options.fetch(:guard_status).to_s
      unless guard_turn == "none" || UUID_PATTERN.match?(guard_turn)
        raise AgentIdentityError, "--guard-turn must be a UUID or none"
      end
      unless (CodexTurnProbe::TURN_STATUSES + ["none"]).include?(guard_status)
        raise AgentIdentityError, "--guard-status is invalid"
      end

      marker = continuation_turn_marker!(
        environment: environment,
        codex_bin: codex_bin,
        thread_id: thread_id
      )
      current_turn = marker.fetch("id")
      current_status = marker.fetch("status")
      same_incomplete_guard = continuation_same_incomplete_guard?(
        guard_turn: guard_turn,
        guard_status: guard_status,
        current_turn: current_turn
      )
      next_turn_guard = same_incomplete_guard ? { "id" => guard_turn, "status" => guard_status } : marker
      if !task_id && continuation_task_completed?(
        guard_turn: guard_turn,
        guard_status: guard_status,
        current_turn: current_turn,
        current_status: current_status
      )
        emit({ "result" => "continue-skipped-completed", "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
        return 0
      end
      if current_turn == guard_turn && current_status == guard_status && !same_incomplete_guard
        if options.fetch(:until_complete)
        return rearm_continuation!(
            result: "continue-rearmed-unchanged",
            alias_name: alias_name,
            conversation_pool: conversation_pool,
            identity_source: identity_source,
            thread_id: thread_id,
            cwd: cwd,
            message: message,
            codex_bin: codex_bin,
            environment: environment,
            turn_guard: marker,
          json: options.fetch(:json),
          task_id: task_id
          )
        end
        emit({ "result" => "continue-skipped-unchanged", "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
        return 0
      end
      if current_status == "inProgress"
        if options.fetch(:until_complete)
          return rearm_continuation!(
            result: "continue-rearmed-active",
            alias_name: alias_name,
            conversation_pool: conversation_pool,
            identity_source: identity_source,
            thread_id: thread_id,
            cwd: cwd,
            message: message,
            codex_bin: codex_bin,
            environment: environment,
            turn_guard: marker,
            json: options.fetch(:json),
            task_id: task_id
          )
        end
        emit({ "result" => "continue-skipped-active", "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
        return 0
      end
      unless task_id || %w[failed interrupted].include?(current_status) || (same_incomplete_guard && current_status == "completed")
        raise AgentIdentityError, "Codex turn status changed to an unsupported state; conditional continuation was not sent"
      end
    end

    _queue_output, _queue_error, queue_status = Open3.capture3(
      environment,
      codex_bin, "queue", "-C", cwd.to_s, "--thread", thread_id, "--message", message
    )
    if queue_status.success?
      if options.fetch(:until_complete)
          return rearm_continuation!(
          result: "continue-queued-and-rearmed",
          alias_name: alias_name,
          conversation_pool: conversation_pool,
          identity_source: identity_source,
          thread_id: thread_id,
          cwd: cwd,
          message: message,
          codex_bin: codex_bin,
          environment: environment,
          turn_guard: next_turn_guard,
            json: options.fetch(:json),
            task_id: task_id
        )
      end
      emit({ "result" => "continue-queued", "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
      return 0
    end

    resumed = system(environment, codex_bin, "exec", "-C", cwd.to_s, "resume", thread_id, message)
    if options.fetch(:until_complete)
      marker = continuation_turn_marker!(
        environment: environment,
        codex_bin: codex_bin,
        thread_id: thread_id
      )
      if !task_id && continuation_task_completed?(
        guard_turn: next_turn_guard.fetch("id"),
        guard_status: next_turn_guard.fetch("status"),
        current_turn: marker.fetch("id"),
        current_status: marker.fetch("status")
      )
        emit({ "result" => "continue-resumed-completed", "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
        return 0
      end
      if task_id && continuation_task(thread_id)&.fetch("status") == "completed"
        emit({ "result" => "continue-resumed-completed", "task_scope" => "thread", "task_id" => task_id, "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
        return 0
      end
      unless task_id || %w[inProgress failed interrupted].include?(marker.fetch("status")) ||
             continuation_same_incomplete_guard?(
               guard_turn: next_turn_guard.fetch("id"),
               guard_status: next_turn_guard.fetch("status"),
               current_turn: marker.fetch("id")
             )
        raise AgentIdentityError, "Codex resume ended in an unsupported state; continuous continuation was paused"
      end
      return rearm_continuation!(
        result: resumed ? "continue-resumed-and-rearmed" : "continue-resume-failed-and-rearmed",
        alias_name: alias_name,
        conversation_pool: conversation_pool,
        identity_source: identity_source,
        thread_id: thread_id,
        cwd: cwd,
        message: message,
        codex_bin: codex_bin,
        environment: environment,
        turn_guard: if continuation_same_incomplete_guard?(
                         guard_turn: next_turn_guard.fetch("id"),
                         guard_status: next_turn_guard.fetch("status"),
                         current_turn: marker.fetch("id")
                       )
                      next_turn_guard
                    else
                      marker
                    end,
        json: options.fetch(:json),
        task_id: task_id
      )
    end
    raise AgentIdentityError, "Codex could neither queue nor resume the scheduled thread" unless resumed

    emit({ "result" => "continue-resumed", "identity" => alias_name, "identity_source" => identity_source, "thread" => thread_id }, json: options.fetch(:json))
    0
  end

  def login
