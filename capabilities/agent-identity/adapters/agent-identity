  def project_terminal_start
    options = parse_project_terminal_id_and_alias!
    state = load_state
    entry = fetch_project_terminal!(options.fetch(:terminal))
    status = entry.fetch("status")
    if %w[inactive blocked user-closed].include?(status)
      return enter_project_terminal_shell(entry, 0)
    end
    if %w[recoverable restoring].include?(status)
      alias_name = validate_alias!(entry.fetch("identity"))
      thread_id = validate_uuid!(entry.fetch("session_id"))
      identity = fetch_identity!(state, alias_name)
      project_terminal_thread_metadata!(identity, thread_id)
      arguments = ["resume", thread_id]
      expected_thread_id = thread_id
    elsif status == "allocated"
      alias_name = validate_alias!(options.fetch(:alias))
      arguments = []
      expected_thread_id = nil
    else
      raise AgentIdentityError, "project terminal is not ready to start: #{status}"
    end
    exit_code, signaled = run_project_terminal_session(state, entry, alias_name, arguments, expected_thread_id: expected_thread_id)
    return exit_code if signaled

    enter_project_terminal_shell(entry, exit_code)
  end

