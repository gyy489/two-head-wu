  def interactive_codex_arguments?(arguments)
    subcommand = codex_subcommand(arguments)
    subcommand.nil? || !NONINTERACTIVE_CODEX_COMMANDS.include?(subcommand)
  end

  def codex_global_options_only?(arguments)
    kind, = codex_root_argument_boundary(arguments)
    kind == :options_only
  end

  # Codex accepts root options before a subcommand. Consume the currently
  # supported root option grammar so `-s read-only review`, for example, is not
  # mistaken for an interactive prompt. Unknown options stay on the conservative
  # interactive path instead of being guessed through.
  def codex_subcommand(arguments)
    kind, index = codex_root_argument_boundary(arguments)
    return "help" if kind == :information
    return arguments[index] if kind == :subcommand

    nil
  end

  def codex_root_argument_boundary(arguments)
    index = 0
    while index < arguments.length
      token = arguments[index]
      return [:information, index] if CODEX_TOP_LEVEL_INFORMATION_OPTIONS.include?(token)
      return [:prompt, index] if token == "--"
      return [:subcommand, index] unless token.start_with?("-")

      option_name = token.split("=", 2).first
      if CODEX_GLOBAL_OPTIONS_WITH_VALUE.include?(option_name)
        index += token.include?("=") ? 1 : 2
      elsif CODEX_GLOBAL_BOOLEAN_OPTIONS.include?(token)
        index += 1
      elsif CODEX_GLOBAL_VARIADIC_OPTIONS.include?(option_name)
        index += 1
        index += 1 while index < arguments.length && !arguments[index].start_with?("-")
      else
        return [:unknown_option, index]
      end
    end
    [:options_only, index]
  end

  def conversation_rollout_roots(identity)
    home = codex_home_for(identity)
    roots = [home.join("sessions"), home.join("archived_sessions")]
    if identity["conversation_pool"]
      pool = pool_root(identity.fetch("conversation_pool"))
      roots.concat([pool.join("sessions"), pool.join("archived_sessions")])
    end
    roots
  end

  def load_state
    ensure_private_root!
    return default_state unless state_path.exist?

    mode = File.stat(state_path.to_s).mode & 0o077
    raise AgentIdentityError, "private identity registry permissions are too broad" unless mode.zero?
    state = JSON.parse(File.read(state_path.to_s, encoding: "UTF-8"))
    state["conversation_pools"] ||= {}
    state["channel_routes"] ||= {}
    state["owner_auto"] ||= default_owner_auto
    validate_state!(state)
    state
  end

  def validate_state!(state)
    raise AgentIdentityError, "unsupported private identity registry" unless state["schema_version"] == 1
    unless state["identities"].is_a?(Hash) && state["project_bindings"].is_a?(Hash) && state["conversation_pools"].is_a?(Hash) && state["channel_routes"].is_a?(Hash) && state["owner_auto"].is_a?(Hash)
      raise AgentIdentityError, "private identity registry is malformed"
    end

    state.fetch("identities").each do |alias_name, item|
      validate_alias!(alias_name)
      raise AgentIdentityError, "identity registry is malformed" unless item.is_a?(Hash) && item.fetch("id") == alias_name
      raise AgentIdentityError, "identity registry has an invalid state kind" unless STATE_KINDS.include?(item.fetch("state_kind"))
      validate_mode!(item.fetch("selection_mode"))
      usage_scope = item.fetch("usage_scope", "owner-local")
      raise AgentIdentityError, "identity registry has an invalid usage scope" unless USAGE_SCOPES.include?(usage_scope)
      if usage_scope == "member-remote-work"
        unless item.fetch("state_kind") == "isolated" && item.fetch("selection_mode") == "manual" && !item.key?("conversation_pool")
          raise AgentIdentityError, "member identity isolation policy is malformed"
        end
      end
      validate_pool!(item["conversation_pool"]) if item["conversation_pool"]
    end
    state.fetch("project_bindings").each do |project_id, alias_name|
      validate_project!(project_id)
      raise AgentIdentityError, "project references an unknown identity" unless state.fetch("identities").key?(alias_name)
      ensure_owner_local!(state.fetch("identities").fetch(alias_name), "hold a project binding")
    end
    state.fetch("conversation_pools").each do |pool_name, item|
      validate_pool!(pool_name)
      raise AgentIdentityError, "conversation pool registry is malformed" unless item.is_a?(Hash) && item.fetch("id") == pool_name
      Array(item["identities"]).each do |alias_name|
        raise AgentIdentityError, "conversation pool references an unknown identity" unless state.fetch("identities").key?(alias_name)
        ensure_owner_local!(state.fetch("identities").fetch(alias_name), "belong to a conversation pool")
      end
      next unless item.key?("shared_state")

      shared_state = item.fetch("shared_state")
      unless shared_state.is_a?(Hash) && shared_state["enabled"] == true &&
             shared_state["database"] == "codex-state/#{SHARED_STATE_DATABASE}" &&
             Array(item["identities"]).include?(shared_state["base_alias"])
        raise AgentIdentityError, "conversation pool shared state policy is malformed"
      end
    end
    state.fetch("channel_routes").each do |key, alias_name|
      channel, session = split_route_key(key)
      validate_channel!(channel)
      validate_session!(session)
      raise AgentIdentityError, "channel route references an unknown identity" unless state.fetch("identities").key?(alias_name)
      ensure_owner_local!(state.fetch("identities").fetch(alias_name), "hold a channel route")
    end
    owner_auto = state.fetch("owner_auto")
    unless [true, false].include?(owner_auto["enabled"]) && owner_auto["members"] == OWNER_AUTO_MEMBERS && owner_auto["channels"] == OWNER_AUTO_CHANNELS
      raise AgentIdentityError, "owner automatic identity policy is malformed"
    end
    if owner_auto["enabled"]
      missing = OWNER_AUTO_MEMBERS.reject { |alias_name| state.fetch("identities").key?(alias_name) }
      raise AgentIdentityError, "owner automatic identity policy references an unknown identity" unless missing.empty?
      OWNER_AUTO_MEMBERS.each { |alias_name| ensure_owner_local!(state.fetch("identities").fetch(alias_name), "join owner automatic routing") }
    end
  end

  def write_state(state)
    ensure_private_root!
    validate_state!(state)
    temporary = state_path.sub_ext(".json.tmp-#{Process.pid}-#{SecureRandom.hex(6)}")
    File.open(temporary.to_s, "w", 0o600) { |file| file.write(JSON.pretty_generate(state) + "\n") }
    File.chmod(0o600, temporary.to_s)
    File.rename(temporary.to_s, state_path.to_s)
    File.chmod(0o600, state_path.to_s)
  ensure
    FileUtils.rm_f(temporary.to_s) if defined?(temporary) && temporary && File.exist?(temporary.to_s)
  end

  def identity_record(alias_name, state_kind, mode, usage_scope: "owner-local")
    { "id" => alias_name, "state_kind" => state_kind, "selection_mode" => mode, "usage_scope" => usage_scope, "registered_at" => Time.now.utc.iso8601 }
  end

  def ensure_owner_local!(identity, action)
    return if identity.fetch("usage_scope", "owner-local") == "owner-local"

    raise AgentIdentityError, "member remote-work identity cannot #{action}"
  end

  def fetch_identity!(state, alias_name)
    state.fetch("identities").fetch(alias_name)
  rescue KeyError
    raise AgentIdentityError, "unknown identity: #{alias_name}"
  end

  def selected_project_identity!(state, project_id)
    alias_name = state.fetch("project_bindings")[project_id]
    raise AgentIdentityError, "project is not bound to an automatic identity: #{project_id}" unless alias_name
    identity = fetch_identity!(state, alias_name)
    raise AgentIdentityError, "project binding is not automatic: #{project_id}" unless identity.fetch("selection_mode") == "project-auto"

    alias_name
  end

  def route_key(channel, session)
    "#{channel}:#{session}"
  end

  def split_route_key(key)
    key.to_s.split(":", 2)
  end

  def set_route!(state, channel, session, alias_name)
    routes = state.fetch("channel_routes")
    canonical_session = normalize_route_session(channel, session)
    routes.delete_if do |key, _value|
      route_channel, route_session = split_route_key(key)
      route_channel == channel && normalize_route_session(route_channel, route_session) == canonical_session
    end
    routes[route_key(channel, canonical_session)] = alias_name
  end

  def selected_route_identity(state, channel, session)
    routes = state.fetch("channel_routes")
    canonical_session = normalize_route_session(channel, session)
    exact = routes[route_key(channel, canonical_session)]
    return { "identity" => exact, "matched_session" => canonical_session } if exact

    routes.each do |key, alias_name|
      route_channel, route_session = split_route_key(key)
      next unless route_channel == channel
      next unless normalize_route_session(route_channel, route_session) == canonical_session

      return { "identity" => alias_name, "matched_session" => route_session }
    end
    nil
  end

  def select_route_identity(state, channel, preferred)
    policy = state.fetch("owner_auto")
    applicable = policy.fetch("enabled") && policy.fetch("channels").include?(channel) &&
                 (preferred.nil? || policy.fetch("members").include?(preferred))
    unless applicable
      alias_name = preferred || selected_project_identity!(state, "two-head-wu")
      return { "identity" => alias_name, "source" => preferred ? "channel-route" : "project-binding" }
    end

    members = policy.fetch("members")
    candidates = preferred ? [preferred, *(members - [preferred])] : members
    candidates.each_with_index do |alias_name, index|
      identity = fetch_identity!(state, alias_name)
      probe = CodexQuotaProbe.new(environment: environment_for(identity)).call
      if probe.fetch("status") == "exhausted"
        next
      end
      reason = if index.zero?
                 probe.fetch("status") == "available" ? "preferred-available" : "preferred-unverified"
               else
                 probe.fetch("status") == "available" ? "quota-failover" : "quota-failover-unverified"
               end
      return {
        "identity" => alias_name,
        "source" => preferred ? "owner-auto-route" : "owner-auto",
        "selection_reason" => reason,
        "quota_probe" => probe.fetch("status")
      }
    end
    raise AgentIdentityError, "all owner automatic Codex identities have exhausted quota"
  end

  def public_owner_auto(state)
    policy = state.fetch("owner_auto")
    {
      "enabled" => policy.fetch("enabled"),
      "members" => policy.fetch("members"),
      "channels" => policy.fetch("channels")
    }
  end

  def normalize_route_session(channel, session)
    normalized = session.downcase
    return normalized unless channel == "openclaw-weixin"

    parts = normalized.split(":")
    channel_index = parts.index(channel)
    if channel_index
      direct_offset = parts[(channel_index + 1)..]&.index("direct")
      direct_index = direct_offset ? channel_index + 1 + direct_offset : nil
      peer = direct_index ? parts[direct_index + 1] : nil
      return peer if peer && !peer.empty?
    end

    prefix = "#{channel}:"
    normalized = normalized.delete_prefix(prefix) while normalized.start_with?(prefix)
    normalized
  end

  def environment_for(identity)
    return { "CODEX_HOME" => nil } if identity.fetch("state_kind") == "default"

    { "CODEX_HOME" => codex_home_for(identity).to_s }
  end

  def dedicated_air_worker_registry?
    runtime_root = ENV["WU_MEMBER_RUNTIME_ROOT"].to_s
    runtime_uid = ENV["WU_MEMBER_RUNTIME_UID"].to_s
    owner_uid = ENV["WU_MEMBER_OWNER_UID"].to_s
    return false if runtime_root.empty? || runtime_uid.empty? || owner_uid.empty?
    return false unless runtime_uid == Process.euid.to_s && owner_uid != runtime_uid

    expected = Pathname.new(utf8_path(runtime_root)).expand_path.cleanpath.join("agent-identity")
    private_root.expand_path.cleanpath == expected
  rescue ArgumentError
    false
  end

  def current_identity!(state)
    raw_home = ENV["CODEX_HOME"].to_s
    if raw_home.empty?
      identity = state.fetch("identities").values.find { |item| item.fetch("state_kind") == "default" }
      return identity if identity
    end

    current_home = Pathname.new(utf8_path(raw_home)).expand_path.cleanpath
    identity = state.fetch("identities").values.find do |item|
      codex_home_for(item).expand_path.cleanpath == current_home
    end
    return identity if identity

    raise AgentIdentityError, "current CODEX_HOME does not match a registered identity"
  end

  def continuation_execution_identity!(state:, thread_id:, fallback_alias:, scheduled_pool: nil)
    binding = thread_execution_binding(thread_id)
    fallback = state.fetch("identities")[fallback_alias]
    pool_name = if scheduled_pool == :unspecified
                  fallback&.fetch("conversation_pool", nil) || binding&.fetch("conversation_pool", nil)
                else
                  scheduled_pool
                end

    if binding && binding.fetch("conversation_pool") == pool_name
      candidate_alias = binding.fetch("identity")
      candidate = state.fetch("identities")[candidate_alias]
      if candidate && candidate["conversation_pool"] == pool_name
        return {
          "identity" => candidate,
          "alias" => candidate_alias,
          "source" => "thread-latest",
          "conversation_pool" => pool_name
        }
      end
    end

    if fallback && fallback["conversation_pool"] == pool_name
      return {
        "identity" => fallback,
        "alias" => fallback_alias,
        "source" => "scheduled-fallback",
        "conversation_pool" => pool_name
      }
    end

    raise AgentIdentityError, "no valid execution identity remains for scheduled thread #{thread_id}"
  end

  def continuation_task_completed?(guard_turn:, guard_status:, current_turn:, current_status:)
    return false unless current_status == "completed"

    same_failed_guard = current_turn == guard_turn && %w[failed interrupted].include?(guard_status)
    !same_failed_guard
  end

  def continuation_same_incomplete_guard?(guard_turn:, guard_status:, current_turn:)
    current_turn == guard_turn && %w[failed interrupted].include?(guard_status)
  end

  def continuation_clock_now
    if ENV["TWO_HEAD_WU_TESTING"] == "1" && ENV["TWO_HEAD_WU_TEST_NOW"]
      return Time.iso8601(ENV.fetch("TWO_HEAD_WU_TEST_NOW"))
    end

    Time.now
  rescue ArgumentError
    raise AgentIdentityError, "TWO_HEAD_WU_TEST_NOW is not a valid ISO-8601 timestamp"
  end

  def next_local_clock_time(value, now)
    match = /\A([01]?\d|2[0-3]):([0-5]\d)\z/.match(value.to_s)
    raise AgentIdentityError, "scheduled time must use local HH:MM, for example 12:00" unless match

    hour = Integer(match[1], 10)
    minute = Integer(match[2], 10)
    candidate = Time.local(now.year, now.month, now.day, hour, minute, 0)
    candidate = Time.local(now.year, now.month, now.day + 1, hour, minute, 0) unless candidate > now
    candidate
  end

  def validate_continue_message!(value)
    valid = value.is_a?(String) && value.valid_encoding? && !value.strip.empty? &&
            value.length <= CONTINUE_MESSAGE_MAX_LENGTH && !value.include?("\0")
    raise AgentIdentityError, "scheduled message must contain 1-#{CONTINUE_MESSAGE_MAX_LENGTH} characters and no NUL byte" unless valid

    value
  end

  def continuation_turn_marker!(environment:, codex_bin:, thread_id:)
    probe = CodexTurnProbe.new(
      environment: environment,
      command: [codex_bin, "app-server", "--stdio"]
    ).call(thread_id: thread_id)
    unless probe.fetch("status") == "ok"
      raise AgentIdentityError, "Codex turn status is unavailable; conditional continuation was not sent"
    end

    {
      "id" => probe["latest_turn_id"] || "none",
      "status" => probe["latest_turn_status"] || "none"
    }
  end

  def continuation_run_at!(environment:, codex_bin:, now:)
    quota = CodexQuotaProbe.new(
      environment: environment,
      command: [codex_bin, "app-server", "--stdio"],
      now: now.to_i
    ).call
    reset_at = if quota.fetch("status") == "exhausted"
                 quota["blocking_reset_at"]
               elsif quota.fetch("status") == "available"
                 quota["next_reset_at"]
               end
    unless reset_at
      raise AgentIdentityError, "Codex quota reset time is unavailable; provide an explicit local time such as: codex-continue 12:00"
    end

    target = Time.at(reset_at + CONTINUE_DELAY_SECONDS).getlocal
    raise AgentIdentityError, "the reported quota reset time is not in the future; provide an explicit local time" unless target > now

    target
  end

  def register_continuation_cron!(openclaw_bin:, alias_name:, conversation_pool:, thread_id:, cwd:, message:, codex_bin:, run_at:, turn_guard:, until_complete:, task_id: nil)
    run_arguments = [
      adapter_path.to_s, "continue-run",
      "--fallback-alias", alias_name,
      "--pool", conversation_pool || "none",
      "--thread", thread_id,
      "--cwd", cwd.to_s,
      "--message", message,
      "--codex-bin", codex_bin,
      "--json"
    ]
    if turn_guard
      run_arguments.concat([
        "--guard-turn", turn_guard.fetch("id"),
        "--guard-status", turn_guard.fetch("status")
      ])
    end
    run_arguments << "--until-complete" if until_complete
    run_arguments.concat(["--task", task_id]) if task_id

    cron_arguments = [
      openclaw_bin, "cron", "add",
      "--name", until_complete ? "Codex continue until complete #{thread_id[0, 8]}" : "Codex continue #{thread_id[0, 8]}",
      "--description", if until_complete
                         "Two-Headed-Wu continuous conditional Codex thread continuation"
                       elsif turn_guard
                         "Two-Headed-Wu conditional Codex thread continuation"
                       else
                         "Two-Headed-Wu exact Codex thread continuation"
                       end,
      "--at", run_at.iso8601,
      "--command-argv", JSON.generate(run_arguments),
      "--command-cwd", cwd.to_s,
      "--command-env", "TWO_HEAD_WU_IDENTITY_ROOT=#{private_root}",
      "--delete-after-run",
      "--no-deliver",
      "--timeout-seconds", CONTINUE_COMMAND_TIMEOUT_SECONDS.to_s,
      "--json"
    ]
    if until_complete
      cron_arguments.concat([
        "--declaration-key", "two-head-wu.codex-continuation.#{thread_id}.#{run_at.to_i}",
        "--display-name", "Codex continuous continuation #{thread_id[0, 8]}"
      ])
    end

    output, error, status = Open3.capture3(*cron_arguments)
    unless status.success?
      detail = error.to_s.strip.lines.last || output.to_s.strip.lines.last || "unknown error"
      raise AgentIdentityError, "OpenClaw could not register the continuation task: #{detail.strip}"
    end
    job = JSON.parse(output)
    job["id"] || job.dig("job", "id")
  rescue JSON::ParserError
    raise AgentIdentityError, "OpenClaw returned invalid JSON while registering the continuation task"
  end

  def rearm_continuation!(result:, alias_name:, conversation_pool:, identity_source:, thread_id:, cwd:, message:, codex_bin:, environment:, turn_guard:, json:, task_id: nil)
    run_at = continuation_run_at!(
      environment: environment,
      codex_bin: codex_bin,
      now: continuation_clock_now
    )
    job_id = register_continuation_cron!(
      openclaw_bin: resolve_openclaw_executable!,
      alias_name: alias_name,
      conversation_pool: conversation_pool,
      thread_id: thread_id,
      cwd: cwd,
      message: message,
      codex_bin: codex_bin,
      run_at: run_at,
      turn_guard: turn_guard,
      until_complete: true,
      task_id: task_id
    )
    payload = {
      "result" => result,
      "identity" => alias_name,
      "identity_source" => identity_source,
      "thread" => thread_id,
      "run_at" => run_at.iso8601,
      "mode" => "until-complete"
    }
    payload["job_id"] = job_id if job_id
    emit(payload, json: json)
    0
  end

  def adapter_path
    @root.join("capabilities", "agent-identity", "adapters", "agent-identity")
  end

  def resolve_openclaw_executable!
    configured = ENV["TWO_HEAD_WU_OPENCLAW_BIN"]
    candidate = configured.to_s.empty? ? @root.parent.join("openclaw", "bin", "openclaw").to_s : configured
    resolve_executable!(candidate, "OpenClaw")
  end

  def resolve_executable!(value, label)
    text = value.to_s
    candidates = if text.include?(File::SEPARATOR)
                   [Pathname.new(utf8_path(text)).expand_path.cleanpath]
                 else
                   ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map do |directory|
                     next if directory.empty?

                     Pathname.new(utf8_path(directory)).join(text).expand_path.cleanpath
                   end.compact
                 end
    executable = candidates.find { |path| path.file? && path.executable? }
    raise AgentIdentityError, "#{label} executable is unavailable: #{text}" unless executable

    executable.to_s
  end

  def codex_home_for(identity)
    identity.fetch("state_kind") == "default" ? default_codex_home : isolated_home(identity.fetch("id"))
  end

  def validate_alias!(value)
    raise AgentIdentityError, "identity alias must use lowercase letters, digits, and hyphens" unless value.is_a?(String) && ALIAS_PATTERN.match?(value)

    value
  end

  def validate_project!(value)
    raise AgentIdentityError, "project ID must use lowercase letters, digits, and hyphens" unless value.is_a?(String) && PROJECT_PATTERN.match?(value)

    value
  end

  def validate_pool!(value)
    raise AgentIdentityError, "conversation pool name must use lowercase letters, digits, and hyphens" unless value.is_a?(String) && POOL_PATTERN.match?(value)

    value
  end

  def validate_channel!(value)
    raise AgentIdentityError, "channel name must use lowercase letters, digits, and hyphens" unless value.is_a?(String) && CHANNEL_PATTERN.match?(value)

    value
  end

  def validate_session!(value)
    raise AgentIdentityError, "session ID has unsupported characters" unless value.is_a?(String) && SESSION_PATTERN.match?(value)

    value
  end

  def validate_uuid!(value)
    text = value.to_s.downcase
    raise AgentIdentityError, "Codex session ID must be a UUID" unless UUID_PATTERN.match?(text)

    text
  end

  def validate_terminal_instance_key!(value)
    unless value.is_a?(String) && value.match?(/\A[0-9a-f]{64}\z/)
      raise AgentIdentityError, "terminal instance key is malformed"
    end

    value
  end

  def validate_terminal_slot!(value)
    valid = value.is_a?(String) && value.valid_encoding? && value == value.strip &&
            !value.empty? && value.length <= TERMINAL_SLOT_MAX_LENGTH &&
            !value.match?(/[\u0000-\u001F\u007F]/)
    raise AgentIdentityError, "terminal slot must be 1-#{TERMINAL_SLOT_MAX_LENGTH} visible characters without leading or trailing whitespace" unless valid

    value
  end

  def validate_mode!(value)
    raise AgentIdentityError, "mode must be one of: #{MODES.join(', ')}" unless MODES.include?(value)

    value
  end

  def emit(payload, json: false)
    if json
      puts JSON.generate(payload)
      return
    end
    payload.each do |key, value|
      value = value.map { |item| "#{item[0]}=#{item[1]}" }.join(", ") if value.is_a?(Hash)
      puts "#{key}: #{value}"
    end
  end

  def utf8_path(value)
    value.to_s.dup.force_encoding(Encoding::UTF_8)
  end
end

exit AgentIdentity.new(ARGV).run
