    with_continuation_task_registry(write: true) do |registry|
      task = registry.fetch("threads")[thread_id]
      if task && task.fetch("status") == "active"
        task["status"] = "completed"
        task["completed_at"] = Time.now.utc.iso8601
        completed = true
