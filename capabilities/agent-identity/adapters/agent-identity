  def validate_project_terminal_registry!(registry)
    unless registry.is_a?(Hash) && registry["schema_version"] == 1 && registry["terminals"].is_a?(Hash)
      raise AgentIdentityError, "private project-terminal registry is malformed"
    end
    if registry.fetch("terminals").length > PROJECT_TERMINAL_LIMIT
      raise AgentIdentityError, "private project-terminal registry is too large"
    end

    expected_keys = %w[conversation_pool created_at cwd id identity last_exit_code project session_id status updated_at]
    registry.fetch("terminals").each do |terminal_id, entry|
      validate_uuid!(terminal_id)
      unless entry.is_a?(Hash) && entry.keys.sort == expected_keys && entry.fetch("id") == terminal_id
        raise AgentIdentityError, "private project-terminal entry is malformed"
      end
      validate_project!(entry.fetch("project"))
      validate_uuid!(entry.fetch("session_id")) if entry["session_id"]
      validate_alias!(entry.fetch("identity")) if entry["identity"]
      validate_pool!(entry.fetch("conversation_pool")) if entry["conversation_pool"]
      cwd = Pathname.new(utf8_path(entry.fetch("cwd")))
      raise AgentIdentityError, "private project-terminal cwd is malformed" unless cwd.absolute? && cwd.cleanpath.to_s == cwd.to_s
      unless PROJECT_TERMINAL_STATES.include?(entry.fetch("status"))
        raise AgentIdentityError, "private project-terminal status is invalid"
      end
      unless entry["last_exit_code"].nil? || entry["last_exit_code"].is_a?(Integer)
        raise AgentIdentityError, "private project-terminal exit code is malformed"
      end
      Time.iso8601(entry.fetch("created_at"))
      Time.iso8601(entry.fetch("updated_at"))
    rescue ArgumentError
      raise AgentIdentityError, "private project-terminal timestamp is malformed"
    end
  end

  def prune_project_terminals!(registry)
    terminals = registry.fetch("terminals")
    extra = terminals.length - PROJECT_TERMINAL_LIMIT
    return if extra <= 0

    disposable = terminals.select { |_id, entry| %w[user-closed inactive blocked allocated].include?(entry.fetch("status")) }
                          .sort_by { |_id, entry| entry.fetch("updated_at") }
    disposable.first(extra).each { |terminal_id, _entry| terminals.delete(terminal_id) }
    raise AgentIdentityError, "project-terminal registry limit reached with active recovery entries" if terminals.length > PROJECT_TERMINAL_LIMIT
  end

