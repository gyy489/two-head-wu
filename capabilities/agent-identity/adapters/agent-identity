        "result" => "login-ready",
        "identity" => alias_name,
        "state_kind" => identity.fetch("state_kind"),
        "command" => (["codex"] + login_arguments).join(" ")
      })
      return 0
    end

    raise AgentIdentityError, "login can only initialize an isolated identity; the default identity already owns its native login" unless identity.fetch("state_kind") == "isolated"
    ensure_isolated_home!(alias_name)
    codex = resolve_executable!(ENV["TWO_HEAD_WU_CODEX_BIN"] || "codex", "Codex")
    success = system(environment_for(identity), codex, *login_arguments)
    raise AgentIdentityError, "native Codex login did not complete" unless success

    emit({ "result" => "login-completed", "identity" => alias_name })
    0
  end

  def make_default
    options = parse_alias_confirm!
    state = load_state
    alias_name = validate_alias!(options.fetch(:alias))
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "become the default identity")
    raise AgentIdentityError, "identity is already the default: #{alias_name}" if identity.fetch("state_kind") == "default"
    if options.fetch(:yes) && state.dig("owner_auto", "enabled")
      raise AgentIdentityError, "disable owner-auto before replacing the default identity"
    end

    old_default = state.fetch("identities").find { |_key, item| item.fetch("state_kind") == "default" }
    raise AgentIdentityError, "no current default identity is registered" unless old_default

    old_alias, old_identity = old_default
    old_pool = old_identity["conversation_pool"]
    new_pool = identity["conversation_pool"]
    unless old_pool == new_pool
      raise AgentIdentityError, "default replacement requires both identities to use the same conversation pool"
    end

    home = codex_home_for(identity)
    raise AgentIdentityError, "isolated Codex home is unavailable: #{home}" unless home.directory?
    raise AgentIdentityError, "the default Codex environment is unavailable" unless default_codex_home.directory?
    unless home.to_s.start_with?("#{private_root}#{File::SEPARATOR}")
      raise AgentIdentityError, "isolated Codex home escaped the private registry"
    end

    payload = {
      "identity" => alias_name,
      "old_default" => old_alias,
      "new_default" => alias_name,
      "default_codex_home" => default_codex_home.to_s,
      "isolated_codex_home_to_delete" => home.to_s,
      "conversation_pool" => new_pool,
      "note" => "the default Codex home must already be signed in to the intended account; this command never reads or copies credentials"
    }
    unless options.fetch(:yes)
      emit(payload.merge("result" => "make-default-preview"), json: options.fetch(:json))
      return 0
    end
    ensure_shared_state_safe_for_home_removal!(state, identity, home)

    identity["state_kind"] = "default"
    state.fetch("identities").delete(old_alias)
    state.fetch("project_bindings").transform_values! { |value| value == old_alias ? alias_name : value }
    state.fetch("channel_routes").transform_values! { |value| value == old_alias ? alias_name : value }
    state.fetch("conversation_pools").each_value do |pool|
      identities = pool.fetch("identities", [])
      identities.delete(old_alias)
      identities << alias_name if new_pool == pool.fetch("id") && !identities.include?(alias_name)
    end
    replace_thread_execution_identity!(old_alias, alias_name)
    write_state(state)

    FileUtils.rm_rf(home.to_s)
    if home.exist? || home.symlink?
      raise AgentIdentityError, "default identity changed, but the retired isolated Codex home could not be deleted: #{home}"
    end

    emit(payload.merge("result" => "default-updated"), json: options.fetch(:json))
    0
  end

  def remove
    options = parse_alias_confirm!
    state = load_state
    alias_name = validate_alias!(options.fetch(:alias))
    identity = fetch_identity!(state, alias_name)
    raise AgentIdentityError, "cannot remove the default identity: #{alias_name}" if identity.fetch("state_kind") == "default"
    if options.fetch(:yes) && state.dig("owner_auto", "enabled") && OWNER_AUTO_MEMBERS.include?(alias_name)
      raise AgentIdentityError, "disable owner-auto before removing an owner automatic identity"
    end

    bound_projects = state.fetch("project_bindings").select { |_key, value| value == alias_name }.keys
    raise AgentIdentityError, "identity is still bound to project(s): #{bound_projects.join(', ')}; run unbind first" unless bound_projects.empty?

    home = codex_home_for(identity)
    unless options.fetch(:yes)
      emit({
        "result" => "remove-preview",
        "identity" => alias_name,
        "codex_home" => home.to_s,
        "note" => "pass --yes to permanently delete this identity's registration and isolated Codex home"
      }, json: options.fetch(:json))
      return 0
    end
    ensure_shared_state_safe_for_home_removal!(state, identity, home)

    state.fetch("identities").delete(alias_name)
    state.fetch("channel_routes").delete_if { |_key, value| value == alias_name }
    state.fetch("conversation_pools").each_value { |pool| pool.fetch("identities", []).delete(alias_name) }
    forget_thread_execution_identity!(alias_name)
    write_state(state)

    if identity.fetch("state_kind") == "isolated"
      raise AgentIdentityError, "isolated Codex home escaped the private registry" unless home.to_s.start_with?("#{private_root}#{File::SEPARATOR}")

      FileUtils.rm_rf(home.to_s)
    end

    emit({ "result" => "removed", "identity" => alias_name, "codex_home" => home.to_s }, json: options.fetch(:json))
    0
  end

  def launch
    options = { dry_run: false, resume_mode: nil }
    parser = OptionParser.new do |item|
      item.on("--alias NAME") { |value| options[:alias] = value }
      item.on("--project PROJECT_ID") { |value| options[:project] = value }
      item.on("--fresh") { options[:resume_mode] = select_launch_mode!(options[:resume_mode], :fresh) }
      item.on("--resume") { options[:resume_mode] = select_launch_mode!(options[:resume_mode], :resume) }
      item.on("--dry-run") { options[:dry_run] = true }
    end
    parser.parse!(@arguments)
    raise AgentIdentityError, "use exactly one of --alias or --project" if [options[:alias], options[:project]].compact.length != 1

    state = load_state
    alias_name = if options[:alias]
                   validate_alias!(options.fetch(:alias))
                 else
                   selected_project_identity!(state, validate_project!(options.fetch(:project)))
                 end
    identity = fetch_identity!(state, alias_name)
    ensure_owner_local!(identity, "launch through the interactive identity router")
    resume_last = options.fetch(:resume_mode) == :resume
    explicit_fresh = options.fetch(:resume_mode) == :fresh
    explicit_resume = codex_subcommand(@arguments) == "resume"
    options_only = codex_global_options_only?(@arguments)
    if explicit_fresh && explicit_resume
      raise AgentIdentityError, "--fresh cannot be combined with the resume subcommand"
    end
    terminal_key = active_terminal_instance_key
    project_terminal_context = active_project_terminal_context
    binding = terminal_key && options_only && !resume_last && !explicit_fresh ? terminal_continuation_binding(terminal_key) : nil
    launch_mode = if binding
                    "terminal-resume"
                  elsif resume_last
                    "resume-last"
                  elsif options_only
                    "fresh"
                  elsif explicit_resume
                    "resume-named-or-explicit"
                  else
                    "fresh-or-explicit"
                  end
    if options.fetch(:dry_run)
      emit({
        "result" => "launch-ready",
        "identity" => alias_name,
        "state_kind" => identity.fetch("state_kind"),
        "launch_mode" => launch_mode,
        "argument_count" => @arguments.length,
        "project_terminal" => project_terminal_context && project_terminal_context.fetch("terminal")
      })
      return 0
    end

    ensure_isolated_home!(alias_name) if identity.fetch("state_kind") == "isolated"
    environment = environment_for(identity)
    # The wrapper consumes the terminal instance id. The Codex process and any
    # tool shells it creates must not inherit terminal navigation state.
    environment[TERMINAL_SLOT_ENV] = nil
    environment[TERMINAL_ALIAS_ENV] = nil
    environment[TERMINAL_INSTANCE_ENV] = nil
    environment[PROJECT_TERMINAL_ID_ENV] = nil
    environment[PROJECT_ID_ENV] = nil
    interactive_arguments = if binding
                              ["resume", binding.fetch("session_id"), *@arguments]
                            elsif resume_last
                              ["resume", "--last", *@arguments]
                            else
                              @arguments
                            end
    title_arguments = interactive_codex_arguments?(interactive_arguments) ? ["--config", THREAD_TITLE_CONFIG] : []
    command = ["codex", *title_arguments, *interactive_arguments]

    if resume_last && terminal_key.nil?
      resumed = system(environment, *command)
      return 0 if resumed

      raise AgentIdentityError, "Codex could not resume the last session for the current project"
    end
    unless interactive_codex_arguments?(interactive_arguments) && terminal_key
      exec(environment, *command)
    end

    forget_terminal_continuation!(terminal_key) if starts_fresh_session?(binding, resume_last, explicit_fresh, explicit_resume)
    observer = CodexSessionObserver.new(allowed_roots: conversation_rollout_roots(identity))
    expected_id = binding && binding.fetch("session_id")
    mark_project_terminal_status!(project_terminal_context.fetch("terminal"), "restoring", exit_code: nil) if project_terminal_context
    on_thread_observed = lambda do |thread_id|
      record_terminal_continuation!(terminal_key, thread_id, alias_name)
      record_thread_execution!(thread_id, alias_name, identity["conversation_pool"])
      if project_terminal_context
        activate_project_terminal!(
          project_terminal_context.fetch("terminal"),
          thread_id,
          alias_name,
          identity["conversation_pool"],
          Dir.pwd
        )
      end
    end
    result = observer.run(
      environment,
      *command,
      expected_thread_id: expected_id,
      on_thread_observed: on_thread_observed
    )
    if result.thread_id
      record_terminal_continuation!(terminal_key, result.thread_id, alias_name)
      record_thread_execution!(result.thread_id, alias_name, identity["conversation_pool"])
      if project_terminal_context
        activate_project_terminal!(
          project_terminal_context.fetch("terminal"),
          result.thread_id,
          alias_name,
          identity["conversation_pool"],
          Dir.pwd
        )
      end
    elsif result.exit_code.zero? && (resume_last || explicit_resume)
      # A successful explicit resume replaced the terminal's navigation target,
      # but observation did not establish which UUID was actually opened. Do not
      # leave the previous, now-stale target behind. Failed resumes preserve it.
      forget_terminal_continuation!(terminal_key)
    end
    if project_terminal_context
      status = if result.signal
                 "recoverable"
               elsif result.exit_code.zero?
                 "inactive"
               else
                 "blocked"
               end
      mark_project_terminal_status!(project_terminal_context.fetch("terminal"), status, exit_code: result.exit_code)
    end
    result.exit_code
  end

  def select_launch_mode!(current, requested)
    raise AgentIdentityError, "use at most one of --fresh or --resume" if current && current != requested

    requested
  end

  def starts_fresh_session?(binding, resume_last, explicit_fresh, explicit_resume)
    return false if binding || resume_last
    return true if explicit_fresh

    !explicit_resume
  end

