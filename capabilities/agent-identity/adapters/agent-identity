  ].freeze
  CODEX_GLOBAL_BOOLEAN_OPTIONS = %w[
    --strict-config --oss --approve-for-me --not-so-yolo
    --dangerously-bypass-approvals-and-sandbox --yolo
    --dangerously-bypass-hook-trust --search --no-alt-screen
  ].freeze
  CODEX_GLOBAL_VARIADIC_OPTIONS = %w[-i --image].freeze
  CODEX_TOP_LEVEL_INFORMATION_OPTIONS = %w[-h --help -V --version].freeze
  OWNER_AUTO_MEMBERS = %w[owner-primary owner-secondary].freeze
  OWNER_AUTO_CHANNELS = %w[remote-work openclaw-weixin].freeze

  def initialize(arguments)
    @arguments = arguments.dup
    @root = Pathname.new(utf8_path(__dir__)).join("../../..").expand_path.cleanpath
  end

  def run
    command = if File.basename($PROGRAM_NAME) == "codex-continue"
                "continue-schedule"
              else
                @arguments.shift || "help"
              end
    case command
    when "help", "--help", "-h" then help
    when "init" then init
    when "register-current" then register_current
    when "add" then add
    when "add-member" then add_member
    when "set-mode" then set_mode
    when "bind" then bind
    when "unbind" then unbind
    when "select" then select
    when "pool-create" then pool_create
    when "pool-attach" then pool_attach
    when "pool-status" then pool_status
    when "pool-state" then pool_state
    when "route-command" then route_command
    when "route-set" then route_set
    when "route-select" then route_select
    when "route-status" then route_status
    when "owner-auto" then owner_auto
    when "terminal-session" then terminal_session
    when "project-terminal" then project_terminal
    when "thread-lifecycle" then thread_lifecycle
    when "status" then status
    when "home" then home
    when "member-home" then member_home
    when "continue-schedule" then continue_schedule
    when "continue-run" then continue_run
    when "login" then login
    when "make-default" then make_default
    when "remove" then remove
    when "launch" then launch
    else raise AgentIdentityError, "unknown command: #{command}"
    end
  rescue OptionParser::ParseError
    warn "Error: invalid command options"
    2
  rescue AgentIdentityError, CodexThreadLifecycleError, CodexTurnProbeError, JSON::ParserError, Errno::EACCES, Errno::ENOENT => error
    warn "Error: #{error.message}"
    2
  end

  private

