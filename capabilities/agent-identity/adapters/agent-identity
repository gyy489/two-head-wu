  def shared_state_status_payload(state, pool_name, pool)
    database = shared_state_database(pool_name)
    identities = Array(pool["identities"]).sort.map do |alias_name|
      identity = fetch_identity!(state, alias_name)
      source = state_database_for(identity)
      {
        "identity" => alias_name,
        "database_present" => source.file?,
        "linked" => linked_to?(source, database)
      }
    end
    payload = {
      "result" => "pool-state-status",
      "pool" => pool_name,
      "enabled" => shared_state_enabled?(pool),
      "database" => database.to_s,
      "database_ready" => database.file?,
      "identities" => identities
    }
    if database.file? && command_available?("sqlite3")
      payload["thread_count"] = sqlite_scalar(database, "SELECT count(*) FROM threads").to_i
      payload["integrity"] = sqlite_scalar(database, "PRAGMA integrity_check")
    end
    payload
  end

  def shared_state_enable_payload(state, pool_name, pool, requested_base_alias)
    members = Array(pool["identities"]).sort
    raise AgentIdentityError, "conversation pool has no identities: #{pool_name}" if members.empty?

    identities = members.to_h { |alias_name| [alias_name, fetch_identity!(state, alias_name)] }
    base_alias = requested_base_alias || members.find { |alias_name| identities.fetch(alias_name).fetch("state_kind") == "default" } || members.first
    raise AgentIdentityError, "base identity is not a member of pool #{pool_name}: #{base_alias}" unless identities.key?(base_alias)

    database = shared_state_database(pool_name)
    if shared_state_enabled?(pool)
      return {
        "pool" => pool_name,
        "base_alias" => base_alias,
        "database" => database.to_s,
        "source_databases" => [],
        "source_thread_counts" => {},
        "expected_unique_thread_count" => database.file? && command_available?("sqlite3") ? sqlite_scalar(database, "SELECT count(*) FROM threads").to_i : nil,
        "empty_identities" => [],
        "blockers" => [],
        "already_enabled" => true
      }
    end

    blockers = []
    blockers << "sqlite3 command is unavailable" unless command_available?("sqlite3")
    blockers << "lsof command is unavailable" unless command_available?("lsof")
    blockers << "unregistered pool database already exists: #{database}" if database.exist? || database.symlink?

    sources = {}
    empty_identities = []
    identities.each do |alias_name, identity|
      source = state_database_for(identity)
      if source.symlink?
        blockers << "identity #{alias_name} already uses an unmanaged state database link"
      elsif source.file?
        sources[alias_name] = source
      elsif source.exist?
        blockers << "identity #{alias_name} state path is not a regular database"
      else
        empty_identities << alias_name
      end
    end
    blockers << "no identity has a state database to migrate" if sources.empty?
    blockers << "base identity has no state database: #{base_alias}" unless sources.key?(base_alias)

    source_thread_counts = {}
    unique_thread_ids = {}
    if command_available?("sqlite3")
      signatures = {}
      sources.each do |alias_name, source|
        begin
          integrity = sqlite_scalar(source, "PRAGMA integrity_check")
          blockers << "identity #{alias_name} database integrity is #{integrity}" unless integrity == "ok"
          signatures[alias_name] = shared_table_signature(source)
          thread_ids = sqlite_rows(source, "SELECT id FROM threads").map { |row| row.fetch("id") }
          source_thread_counts[alias_name] = thread_ids.length
          thread_ids.each { |thread_id| unique_thread_ids[thread_id] = true }
        rescue AgentIdentityError => error
          blockers << "identity #{alias_name} database cannot be inspected (#{error.message})"
        end
      end
      unless signatures.empty?
        expected = signatures[base_alias]
        signatures.each do |alias_name, signature|
          blockers << "identity #{alias_name} uses an incompatible state database schema" unless expected && signature == expected
        end
      end
    end
    blockers.concat(open_database_blockers(sources)) if command_available?("lsof")

    {
      "pool" => pool_name,
      "base_alias" => base_alias,
      "database" => database.to_s,
      "source_databases" => sources.transform_values(&:to_s),
      "source_thread_counts" => source_thread_counts,
      "expected_unique_thread_count" => unique_thread_ids.length,
      "empty_identities" => empty_identities,
      "blockers" => blockers.uniq,
      "already_enabled" => false
    }
  end

  def enable_shared_state!(state, pool_name, pool, base_alias)
    if shared_state_enabled?(pool)
      return shared_state_status_payload(state, pool_name, pool).merge("result" => "pool-state-already-enabled")
    end

    members = Array(pool["identities"]).sort
    identities = members.to_h { |alias_name| [alias_name, fetch_identity!(state, alias_name)] }
    sources = identities.transform_values { |identity| state_database_for(identity) }.select { |_alias_name, path| path.file? && !path.symlink? }
    destination = shared_state_database(pool_name)
    timestamp = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
    backup_root = pool_root(pool_name).join("backups", "state-#{timestamp}-#{SecureRandom.hex(4)}")
    snapshots = {}
    temporary = shared_state_root(pool_name).join(".state-merge-#{Process.pid}-#{SecureRandom.hex(6)}.sqlite")
    published = false
    switch_started = false

    begin
      FileUtils.mkdir_p(backup_root.to_s, mode: 0o700)
      File.chmod(0o700, backup_root.to_s)
      FileUtils.mkdir_p(shared_state_root(pool_name).to_s, mode: 0o700)
      File.chmod(0o700, shared_state_root(pool_name).to_s)

      sources.each do |alias_name, source|
        sqlite_execute(source, "PRAGMA busy_timeout=5000; PRAGMA wal_checkpoint(TRUNCATE);")
        snapshot = backup_root.join("#{alias_name}-#{SHARED_STATE_DATABASE}")
        sqlite_execute(source, "VACUUM INTO #{sqlite_literal(snapshot.to_s)};")
        File.chmod(0o600, snapshot.to_s)
        snapshots[alias_name] = snapshot
      end
      current_blockers = open_database_blockers(sources)
      raise AgentIdentityError, "state database opened during migration: #{current_blockers.join('; ')}" unless current_blockers.empty?

      base_snapshot = snapshots.fetch(base_alias)
      sqlite_execute(base_snapshot, "VACUUM INTO #{sqlite_literal(temporary.to_s)};")
      (snapshots.keys - [base_alias]).sort.each do |alias_name|
        merge_state_database!(temporary, snapshots.fetch(alias_name))
      end
      normalize_rollout_paths!(temporary, identities.values, pool_name)
      integrity = sqlite_scalar(temporary, "PRAGMA integrity_check")
      raise AgentIdentityError, "merged database integrity check failed: #{integrity}" unless integrity == "ok"
      foreign_keys = sqlite_rows(temporary, "PRAGMA foreign_key_check")
      raise AgentIdentityError, "merged database has foreign key violations" unless foreign_keys.empty?

      write_private_json(backup_root.join("manifest.json"), {
        "pool" => pool_name,
        "created_at" => Time.now.utc.iso8601,
        "base_alias" => base_alias,
        "identities" => snapshots.transform_values(&:to_s),
        "destination" => destination.to_s
      })
      File.chmod(0o600, temporary.to_s)
      File.rename(temporary.to_s, destination.to_s)
      published = true

      switch_started = true
      identities.each_value do |identity|
        source = state_database_for(identity)
        FileUtils.rm_f(source.to_s)
        FileUtils.rm_f("#{source}-wal")
        FileUtils.rm_f("#{source}-shm")
        File.symlink(destination.to_s, source.to_s)
        raise AgentIdentityError, "failed to attach shared state for #{identity.fetch('id')}" unless linked_to?(source, destination)
      end

      thread_count = sqlite_scalar(destination, "SELECT count(*) FROM threads").to_i
      pool["shared_state"] = {
        "enabled" => true,
        "database" => "codex-state/#{SHARED_STATE_DATABASE}",
        "base_alias" => base_alias,
        "enabled_at" => Time.now.utc.iso8601,
        "backup" => backup_root.to_s
      }
      write_state(state)
      {
        "result" => "pool-state-enabled",
        "pool" => pool_name,
        "base_alias" => base_alias,
        "database" => destination.to_s,
        "identities" => members,
        "thread_count" => thread_count,
        "backup" => backup_root.to_s
      }
    rescue StandardError => error
      restore_state_snapshots!(identities, snapshots, destination) if switch_started
      FileUtils.rm_f(destination.to_s) if published
      raise error if error.is_a?(AgentIdentityError)

      raise AgentIdentityError, "shared state migration failed and was rolled back: #{error.message}"
    ensure
      FileUtils.rm_f(temporary.to_s)
    end
  end

  def merge_state_database!(destination, source)
    statements = []
    SHARED_STATE_TABLES.each do |table|
      columns = sqlite_table_columns(destination, table)
      names = columns.map { |column| sqlite_identifier(column) }.join(", ")
      select_names = columns.map { |column| "incoming.#{sqlite_identifier(table)}.#{sqlite_identifier(column)}" }.join(", ")
      if table == "threads"
        updates = (columns - ["id"]).map { |column| "#{sqlite_identifier(column)} = excluded.#{sqlite_identifier(column)}" }.join(", ")
        statements << <<~SQL
          INSERT INTO #{sqlite_identifier(table)} (#{names})
          SELECT #{select_names} FROM incoming.#{sqlite_identifier(table)} WHERE 1
          ON CONFLICT(id) DO UPDATE SET #{updates}
          WHERE COALESCE(excluded.updated_at_ms, excluded.updated_at * 1000, 0) >=
                COALESCE(threads.updated_at_ms, threads.updated_at * 1000, 0);
        SQL
      elsif %w[thread_dynamic_tools thread_spawn_edges].include?(table)
        statements << "INSERT OR REPLACE INTO #{sqlite_identifier(table)} (#{names}) SELECT #{select_names} FROM incoming.#{sqlite_identifier(table)};"
      else
        statements << "INSERT OR IGNORE INTO #{sqlite_identifier(table)} (#{names}) SELECT #{select_names} FROM incoming.#{sqlite_identifier(table)};"
      end
    end
    sqlite_execute(destination, <<~SQL)
      PRAGMA foreign_keys=OFF;
      ATTACH DATABASE #{sqlite_literal(source.to_s)} AS incoming;
      BEGIN IMMEDIATE;
      #{statements.join("\n")}
      COMMIT;
      DETACH DATABASE incoming;
    SQL
  end

  def normalize_rollout_paths!(database, identities, pool_name)
    session_root = pool_root(pool_name).join("sessions").to_s
    archive_root = pool_root(pool_name).join("archived_sessions").to_s
    statements = identities.flat_map do |identity|
      home = codex_home_for(identity).to_s
      [
        "UPDATE threads SET rollout_path = replace(rollout_path, #{sqlite_literal("#{home}/sessions/")}, #{sqlite_literal("#{session_root}/")});",
        "UPDATE threads SET rollout_path = replace(rollout_path, #{sqlite_literal("#{home}/archived_sessions/")}, #{sqlite_literal("#{archive_root}/")});"
      ]
    end
    sqlite_execute(database, "BEGIN IMMEDIATE; #{statements.join(' ')} COMMIT;")
  end

  def restore_state_snapshots!(identities, snapshots, destination)
    identities.each do |alias_name, identity|
      source = state_database_for(identity)
      FileUtils.rm_f(source.to_s) if source.symlink? && linked_to?(source, destination)
      snapshot = snapshots[alias_name]
      next unless snapshot&.file?

      FileUtils.rm_f(source.to_s)
      FileUtils.cp(snapshot.to_s, source.to_s)
      File.chmod(0o600, source.to_s)
    rescue SystemCallError
      # Preserve the original migration exception; the backup directory remains
      # available for a deliberate manual recovery if filesystem restoration fails.
    end
  end

  def preflight_shared_state_attachment!(identity, pool_name, pool)
    return unless shared_state_enabled?(pool)

    source = state_database_for(identity)
    destination = shared_state_database(pool_name)
    raise AgentIdentityError, "shared state database is unavailable for pool #{pool_name}" unless destination.file?
    return if linked_to?(source, destination)
    return unless source.exist? || source.symlink?

    raise AgentIdentityError, "identity #{identity.fetch('id')} already has independent state; migrate it before attaching to shared-state pool #{pool_name}"
  end

  def attach_shared_state!(identity, pool_name)
    source = state_database_for(identity)
    destination = shared_state_database(pool_name)
    return if linked_to?(source, destination)

    File.symlink(destination.to_s, source.to_s)
    raise AgentIdentityError, "state database was not linked for identity #{identity.fetch('id')}" unless linked_to?(source, destination)
  end

  def ensure_shared_state_safe_for_home_removal!(state, identity, home)
    pool_name = identity["conversation_pool"]
    return unless pool_name

    pool = state.fetch("conversation_pools")[pool_name]
    return unless pool && shared_state_enabled?(pool)

    database = shared_state_database(pool_name)
    source = state_database_for(identity)
    unless database.file? && linked_to?(source, database)
      raise AgentIdentityError, "cannot remove identity home while its shared state link is unhealthy"
    end
    raise AgentIdentityError, "cannot verify shared rollout paths because sqlite3 is unavailable" unless command_available?("sqlite3")

    home_prefix = "#{home}/"
    remaining = sqlite_scalar(database, "SELECT count(*) FROM threads WHERE instr(rollout_path, #{sqlite_literal(home_prefix)}) = 1").to_i
    if remaining.positive?
      raise AgentIdentityError, "cannot remove identity home while #{remaining} shared rollout path(s) still point into it"
    end
  end

  def shared_table_signature(database)
    SHARED_STATE_TABLES.to_h do |table|
      rows = sqlite_rows(database, "PRAGMA table_info(#{sqlite_identifier(table)})")
      raise AgentIdentityError, "required state table is missing: #{table}" if rows.empty?

      signature = rows.map { |row| row.values_at("name", "type", "notnull", "pk") }
      [table, signature]
    end
  end

  def sqlite_table_columns(database, table)
    rows = sqlite_rows(database, "PRAGMA table_info(#{sqlite_identifier(table)})")
    columns = rows.map { |row| row.fetch("name") }
    raise AgentIdentityError, "required state table is missing: #{table}" if columns.empty?

    columns
  end

  def sqlite_rows(database, sql)
    output, error, status = Open3.capture3("sqlite3", "-json", database.to_s, sql)
    raise AgentIdentityError, "sqlite operation failed: #{error.strip}" unless status.success?

    output.strip.empty? ? [] : JSON.parse(output)
  rescue Errno::ENOENT
    raise AgentIdentityError, "sqlite3 command is unavailable"
  end

  def sqlite_scalar(database, sql)
    output, error, status = Open3.capture3("sqlite3", "-noheader", database.to_s, sql)
    raise AgentIdentityError, "sqlite operation failed: #{error.strip}" unless status.success?

    output.lines.first.to_s.strip
  rescue Errno::ENOENT
    raise AgentIdentityError, "sqlite3 command is unavailable"
  end

  def sqlite_execute(database, sql)
    _output, error, status = Open3.capture3("sqlite3", database.to_s, sql)
    raise AgentIdentityError, "sqlite operation failed: #{error.strip}" unless status.success?
  rescue Errno::ENOENT
    raise AgentIdentityError, "sqlite3 command is unavailable"
  end

  def sqlite_literal(value)
    "'#{value.to_s.gsub("'", "''")}'"
  end

  def sqlite_identifier(value)
    raise AgentIdentityError, "unsafe SQLite identifier" unless value.to_s.match?(/\A[a-z_][a-z0-9_]*\z/)

    %Q{"#{value}"}
  end

  def command_available?(name)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? { |directory| File.executable?(File.join(directory, name)) }
  end

  def open_database_blockers(sources)
    paths = sources.values.flat_map { |path| [path.to_s, "#{path}-wal", "#{path}-shm"] }.select { |path| File.exist?(path) }
    return [] if paths.empty?

    output, error, status = Open3.capture3("lsof", "-Fpc", "--", *paths)
    raise AgentIdentityError, "lsof failed: #{error.strip}" unless status.success? || status.exitstatus == 1

    process = nil
    command = nil
    blockers = []
    output.each_line do |line|
      case line[0]
      when "p" then process = line[1..].strip
      when "c"
        command = line[1..].strip
        blockers << "state database is open by #{command} (pid #{process})" if process
      end
    end
    blockers.uniq
  rescue Errno::ENOENT
    ["lsof command is unavailable"]
  end

  def write_private_json(path, payload)
    File.open(path.to_s, "w", 0o600) { |file| file.write(JSON.pretty_generate(payload) + "\n") }
    File.chmod(0o600, path.to_s)
  end

  def ensure_private_root!
    root_prefix = "#{@root}#{File::SEPARATOR}"
    if private_root.to_s == @root.to_s || private_root.to_s.start_with?(root_prefix)
      raise AgentIdentityError, "private identity registry must stay outside the project repository"
    end
    FileUtils.mkdir_p(private_root.to_s, mode: 0o700)
    File.chmod(0o700, private_root.to_s)
  end

  def ensure_isolated_home!(alias_name)
    home = isolated_home(alias_name)
    raise AgentIdentityError, "isolated Codex home escaped the private registry" unless home.to_s.start_with?("#{private_root}#{File::SEPARATOR}")

    FileUtils.mkdir_p(home.to_s, mode: 0o700)
    File.chmod(0o700, home.to_s)
  end

  def ensure_pool_root!(pool_name)
    root = pool_root(pool_name)
    raise AgentIdentityError, "conversation pool escaped the private registry" unless root.to_s.start_with?("#{private_root}#{File::SEPARATOR}")

    FileUtils.mkdir_p(root.to_s, mode: 0o700)
    File.chmod(0o700, root.to_s)
    SHARED_CONVERSATION_DIRS.each do |name|
      directory = root.join(name)
      FileUtils.mkdir_p(directory.to_s, mode: 0o700)
      File.chmod(0o700, directory.to_s)
    end
  end

  def attach_conversation_pool!(identity, pool_name)
    home = identity.fetch("state_kind") == "default" ? default_codex_home : isolated_home(identity.fetch("id"))
    raise AgentIdentityError, "Codex home is unavailable for identity #{identity.fetch('id')}" unless home.directory?

    SHARED_CONVERSATION_DIRS.each do |name|
      source = home.join(name)
      destination = pool_root(pool_name).join(name)
      next if linked_to?(source, destination)

      if source.exist? || source.symlink?
        raise AgentIdentityError, "cannot attach non-directory conversation path: #{source}" unless source.directory?

        merge_directory_contents!(source, destination, identity.fetch("id"))
        FileUtils.rmdir(source.to_s) if source.directory? && Dir.empty?(source.to_s)
      end
      File.symlink(destination.to_s, source.to_s) unless source.exist? || source.symlink?
      raise AgentIdentityError, "conversation path was not linked: #{source}" unless linked_to?(source, destination)
    end
  end

  def merge_directory_contents!(source, destination, alias_name)
    FileUtils.mkdir_p(destination.to_s, mode: 0o700)
    Dir.children(source.to_s).each do |child|
      from = source.join(child)
      to = destination.join(child)
      if to.exist? || to.symlink?
        if from.directory? && !from.symlink? && to.directory? && !to.symlink?
          merge_directory_contents!(from, to, alias_name)
          FileUtils.rmdir(from.to_s) if from.directory? && Dir.empty?(from.to_s)
        else
          timestamp = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
          FileUtils.mv(from.to_s, destination.join("#{child}.from-#{alias_name}-#{timestamp}").to_s)
        end
      else
        FileUtils.mv(from.to_s, to.to_s)
      end
    end
  end

