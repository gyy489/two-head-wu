#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"
require "yaml"

manifest_path = ARGV.fetch(0) do
  warn "Usage: ruby tools/validate-capability PATH/TO/capability.yaml"
  exit 64
end

path = Pathname.new(manifest_path).expand_path
abort "manifest not found: #{manifest_path}" unless path.file?

begin
  manifest = YAML.safe_load(path.read, aliases: false)
rescue Psych::Exception => e
  warn "invalid YAML: #{e.message}"
  exit 1
end

unless manifest.is_a?(Hash)
  warn "manifest must contain a YAML mapping"
  exit 1
end

errors = []
required = %w[
  schema_version id version status summary documentation installation interfaces components
  compatibility permissions dependencies recovery tests
]
missing = required.reject { |key| manifest.key?(key) }
errors << "missing required fields: #{missing.join(', ')}" unless missing.empty?

id = manifest["id"]
version = manifest["version"]
status = manifest["status"]
errors << "schema_version must be 1" unless manifest["schema_version"] == 1
errors << "id must use lowercase kebab-case" unless id.is_a?(String) && id.match?(/\A[a-z0-9]+(?:-[a-z0-9]+)*\z/)
errors << "version must be semantic version shaped" unless version.is_a?(String) && version.match?(/\A\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?\z/)
errors << "status is invalid" unless %w[candidate experimental active disabled deprecated].include?(status)
errors << "summary must be a non-empty string" unless manifest["summary"].is_a?(String) && !manifest["summary"].strip.empty?

package_root = path.dirname

safe_relative = lambda do |candidate|
  next false unless candidate.is_a?(String) && !candidate.empty?

  relative = Pathname.new(candidate)
  !relative.absolute? && relative.cleanpath.to_s != ".." && !relative.cleanpath.to_s.start_with?("../")
end

check_paths = lambda do |label, candidates, executable: false|
  Array(candidates).each do |candidate|
    unless safe_relative.call(candidate)
      errors << "#{label} must be a safe relative path: #{candidate.inspect}"
      next
    end

    target = package_root.join(candidate)
    errors << "#{label} does not exist: #{candidate}" unless target.exist?
    errors << "#{label} is not executable: #{candidate}" if executable && target.exist? && !target.executable?
  end
end

interfaces = manifest["interfaces"]
if !interfaces.is_a?(Array) || interfaces.empty?
  errors << "interfaces must be a non-empty array"
else
  interface_ids = []
  interfaces.each_with_index do |interface, index|
    unless interface.is_a?(Hash)
      errors << "interfaces[#{index}] must be a mapping"
      next
    end

    interface_id = interface["id"]
    unless interface_id.is_a?(String) && interface_id.match?(/\A[a-z0-9]+(?:[.-][a-z0-9]+)*\.v[1-9]\d*\z/)
      errors << "interfaces[#{index}].id must be a versioned interface ID"
    end
    interface_ids << interface_id
    check_paths.call("interfaces[#{index}].entrypoint", interface["entrypoint"], executable: true)
  end
  duplicates = interface_ids.compact.group_by(&:itself).select { |_key, values| values.length > 1 }.keys
  errors << "interface IDs must be unique: #{duplicates.join(', ')}" unless duplicates.empty?
end

documentation = manifest["documentation"]
if documentation.is_a?(Hash)
  check_paths.call("documentation.overview", documentation["overview"])
  %w[skill_docs references].each { |key| check_paths.call("documentation.#{key}", documentation[key]) }
else
  errors << "documentation must be a mapping"
end

components = manifest["components"]
if components.is_a?(Hash)
  components.each { |kind, paths| check_paths.call("components.#{kind}", paths) }
else
  errors << "components must be a mapping"
end

permissions = manifest["permissions"]
unless permissions.is_a?(Hash) && %w[risk_level network secrets filesystem].all? { |key| permissions.key?(key) }
  errors << "permissions must declare risk_level, network, secrets, and filesystem"
end

compatibility = manifest["compatibility"]
allowed_compatibility = %w[native compatible needs-review denied]
unless compatibility.is_a?(Hash) && compatibility.values.all? { |value| allowed_compatibility.include?(value) }
  errors << "compatibility values must be native, compatible, needs-review, or denied"
end

errors << "dependencies must be an array" unless manifest["dependencies"].is_a?(Array)

recovery = manifest["recovery"]
unless recovery.is_a?(Hash) && %w[source_of_truth rollback].all? { |key| recovery[key].is_a?(String) && !recovery[key].empty? }
  errors << "recovery must declare non-empty source_of_truth and rollback"
end

tests = manifest["tests"]
if !tests.is_a?(Array) || tests.empty?
  errors << "tests must be a non-empty array"
else
  check_paths.call("test", tests, executable: true)
end

if errors.empty?
  puts "#{manifest_path}: OK (#{id} #{version})"
  exit 0
end

warn "#{manifest_path}: INVALID"
errors.each { |error| warn "  - #{error}" }
exit 1
